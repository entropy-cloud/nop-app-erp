<?xml version="1.0" encoding="UTF-8" ?>
<!-- 现金流量表（种子报表，直接法 + 间接法补充）。数据集 ds（直接法行 {section:OPERATING|INVESTING|FINANCING, code, name, direction:INFLOW|OUTFLOW, amount}）
     与 indirectDs（间接法行 {section:INDIRECT, code:NET_PROFIT|NON_CASH|WORKING_CAPITAL|NET, name, direction, amount}）
     由 ErpFinReportBizModel.prepareDataset 注入（buildCashFlowDataset/buildIndirectCashFlowDataset）。
     对齐 finance 现金流口径（RC-R1.45 / P1-RC-007：科目 cashFlowType 三分类 + 间接法净利润+非现金项目+营运资金变动）。 -->
<workbook x:schema="/nop/schema/excel/workbook.xdef" xmlns:x="/nop/schema/xdsl.xdef">

    <sheets>
        <sheet name="cash-flow-statement" defaultColumnWidth="60.0" defaultRowHeight="16.0">
            <model/>
            <table>
                <cols>
                    <col width="90.0"/>
                    <col width="60.0"/>
                    <col width="160.0"/>
                    <col width="70.0"/>
                    <col width="90.0"/>
                </cols>
                <rows>
                    <row height="24.0">
                        <cells>
                            <cell mergeAcross="4" styleId="title"><model/><value>现金流量表</value></cell>
                        </cells>
                        <model/>
                    </row>
                    <row height="18.0">
                        <cells>
                            <cell styleId="header"><model/><value>活动分类</value></cell>
                            <cell styleId="header"><model/><value>科目编码</value></cell>
                            <cell styleId="header"><model/><value>科目名称</value></cell>
                            <cell styleId="header"><model/><value>流向</value></cell>
                            <cell styleId="header"><model/><value>金额</value></cell>
                        </cells>
                        <model/>
                    </row>
                    <row height="16.0">
                        <cells>
                            <cell styleId="cell">
                                <model ds="ds" expandType="r" field="section"/>
                                <value>*=^ds!section</value>
                            </cell>
                            <cell styleId="cell">
                                <model rowParent="A3"/>
                                <value>*=code</value>
                            </cell>
                            <cell styleId="cell">
                                <model rowParent="A3"/>
                                <value>*=name</value>
                            </cell>
                            <cell styleId="cell">
                                <model rowParent="A3"/>
                                <value>*=direction</value>
                            </cell>
                            <cell styleId="num">
                                <model rowParent="A3"/>
                                <value>*=amount</value>
                            </cell>
                        </cells>
                        <model/>
                    </row>
                    <row height="18.0">
                        <cells>
                            <cell mergeAcross="3" styleId="total"><model/><value>现金净增加（直接法）</value></cell>
                            <cell styleId="num">
                                <model><valueExpr>SUM(E3)</valueExpr></model>
                            </cell>
                        </cells>
                        <model/>
                    </row>
                    <row height="18.0">
                        <cells>
                            <cell mergeAcross="4" styleId="section"><model/><value>间接法补充：净利润 + 非现金项目 + 营运资金变动</value></cell>
                        </cells>
                        <model/>
                    </row>
                    <row height="16.0">
                        <cells>
                            <cell styleId="cell">
                                <model ds="indirectDs" expandType="r" field="code"/>
                                <value>*=^indirectDs!code</value>
                            </cell>
                            <cell styleId="cell">
                                <model rowParent="A6"/>
                                <value>*=name</value>
                            </cell>
                            <cell styleId="cell">
                                <model rowParent="A6"/>
                                <value>*=direction</value>
                            </cell>
                            <cell styleId="num">
                                <model rowParent="A6"/>
                                <value>*=amount</value>
                            </cell>
                        </cells>
                        <model/>
                    </row>
                </rows>
            </table>
        </sheet>
    </sheets>

    <styles>
        <style id="title" horizontalAlign="center" verticalAlign="center">
            <font fontName="等线" fontSize="14.0" bold="true"/>
            <numberFormat>General</numberFormat>
        </style>
        <style id="header" fillPattern="solid" fillBgColor="FFECEFF4" horizontalAlign="center" verticalAlign="center">
            <font fontName="等线" fontSize="11.0" bold="true"/>
            <numberFormat>General</numberFormat>
            <topBorder type="thin" weight="1"/>
            <bottomBorder type="thin" weight="1"/>
            <leftBorder type="thin" weight="1"/>
            <rightBorder type="thin" weight="1"/>
        </style>
        <style id="section" fillPattern="solid" fillBgColor="FFF5F0E6" horizontalAlign="center" verticalAlign="center">
            <font fontName="等线" fontSize="11.0" bold="true"/>
            <numberFormat>General</numberFormat>
            <bottomBorder type="thin" weight="1"/>
            <leftBorder type="thin" weight="1"/>
            <rightBorder type="thin" weight="1"/>
        </style>
        <style id="cell" verticalAlign="center">
            <font fontName="等线" fontSize="11.0"/>
            <numberFormat>General</numberFormat>
            <bottomBorder type="thin" weight="1"/>
            <leftBorder type="thin" weight="1"/>
            <rightBorder type="thin" weight="1"/>
        </style>
        <style id="num" horizontalAlign="right" verticalAlign="center">
            <font fontName="等线" fontSize="11.0"/>
            <numberFormat>#,##0.00</numberFormat>
            <bottomBorder type="thin" weight="1"/>
            <leftBorder type="thin" weight="1"/>
            <rightBorder type="thin" weight="1"/>
        </style>
        <style id="total" horizontalAlign="center" verticalAlign="center">
            <font fontName="等线" fontSize="11.0" bold="true"/>
            <numberFormat>General</numberFormat>
            <topBorder type="thin" weight="1"/>
            <bottomBorder type="thin" weight="1"/>
            <leftBorder type="thin" weight="1"/>
            <rightBorder type="thin" weight="1"/>
        </style>
    </styles>
</workbook>
