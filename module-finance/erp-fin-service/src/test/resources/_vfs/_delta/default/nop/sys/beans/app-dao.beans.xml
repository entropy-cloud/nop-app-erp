<beans x:schema="/nop/schema/beans.xdef" xmlns:x="/nop/schema/xdsl.xdef" xmlns:feature="feature"
       xmlns="http://www.springframework.org/schema/beans" xmlns:ioc="ioc"
       x:extends="super">

    <bean id="nopSequenceGenerator" class="io.nop.sys.dao.seq.SysSequenceGenerator"
          ioc:delay-method="lazyInit" x:override="replace">
        <property name="ormTemplate" ref="nopOrmTemplate" ioc:lazy-property="true"/>
        <property name="transactionTemplate" ref="nopTransactionTemplate" ioc:lazy-property="true"/>
    </bean>
</beans>
