    <build>
        <plugins>
            <!--
                perf 测试隔离（MQ Q5，plan 2026-08-02-1121-2 Phase 1 / 设计文档 §5.1）。
                机制经既有 @Tag("full-app") + 各 erp-*-web/pom.xml <excludedGroups>full-app</excludedGroups>
                先例验证（2026-08-02 复核命中）：父 nop-entropy/pom.xml surefire 无全局 groups/excludedGroups，
                隔离配置在 per-module pom。perf 测试经 -Dgroups=perf 激活（nightly perf-baseline.yml），
                per-commit mvn test 自动排除，零回归。
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <excludedGroups>perf</excludedGroups>
                    <!--
                        属性 test 类名约定 Property*（设计文档 §6.2）不匹配 surefire 默认 include 模式
                       （Test*/*Test/*Tests/*TestCase），故显式增 **/Property*.java 使 jqwik @Property
                        类经 mvn test 自动拾取（设计文档 §8.1/C-1 contract）。
                        回填：plan 2026-08-02-0650-1 Phase 4 实施期发现——Q3 首批 P1/P3 经 closure 后复测
                        确认默认 include 漏拾 Property* 类（仅 JqwikSmokeTest 匹配 *Test 运行），此 include 补全。
                    -->
                    <includes>
                        <include>**/Test*.java</include>
                        <include>**/*Test.java</include>
                        <include>**/*Tests.java</include>
                        <include>**/*TestCase.java</include>
                        <include>**/Property*.java</include>
                    </includes>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

    <!--
        perf profile (MQ Q5，plan 2026-08-02-1121-2 Phase 1 / 设计文档 §5.1)：
        默认 surefire <excludedGroups>perf</excludedGroups> 使 @Tag("perf") 测试不进 per-commit mvn test。
        -Pperf 激活：清空 excludedGroups + 设 groups=perf，使 perf 测试唯一被执行。
        注：设计文档 §5.1「-Dgroups=perf 或 -DexcludedGroups= 覆盖」经实测——surefire 3.x 用户属性
        不覆盖 pom 硬编码 <excludedGroups>，须 profile 翻转配置（既有 full-app 范式同样依赖 app-erp-all
        聚合 profile 跑，非 CLI 覆盖）。激活命令：mvn -Pperf -pl module-finance/erp-fin-service test。
    -->
    <profiles>
        <profile>
            <id>perf</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <excludedGroups combine.self="override"/>
                            <groups>perf</groups>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    <!--
        mutation profile (MQ Q1)：per-module 接入（候选 P1，设计文档 §3.4 R4 预设退路）。
        R4 复核结论：app-erp 根 pom 仅为 reactor 聚合器——module-finance/pom.xml 的 <parent>
        是 nop-entropy（非 app-erp），故根 pom 的 mutation profile 不在子模块 parent 链中、
        无法继承。退回候选 P1：在三域 service 模块各声明 profile。配置与设计文档 §3.3 一致
        （targetClasses 含三域通配；非本域类不在 classpath 上，pitest 0 命中无害）。
        激活：mvn -Pmutation -pl module-finance/erp-fin-service -am test-compile
              org.pitest:pitest-maven:mutationCoverage
    -->
        <profile>
            <id>mutation</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.pitest</groupId>
                        <artifactId>pitest-maven</artifactId>
                        <version>1.25.8</version>
                        <configuration>
                            <targetClasses>
                                <param>app.erp.fin.*</param>
                                <param>app.erp.mfg.*</param>
                                <param>app.erp.inv.*</param>
                            </targetClasses>
                            <excludedClasses>
                                <param>*.dao.entity._gen.*</param>
                                <param>*.dao.entity._gen._*</param>
                                <param>*.api.beans.*</param>
                                <param>*.api.crud.*</param>
                                <param>*.codegen.*</param>
                                <param>*Test*</param>
                                <param>*IT</param>
                            </excludedClasses>
                            <targetTests>
                                <param>app.erp.fin.*Test*</param>
                                <param>app.erp.mfg.*Test*</param>
                                <param>app.erp.inv.*Test*</param>
                            </targetTests>
                            <outputFormats>
                                <param>HTML</param>
                                <param>XML</param>
                            </outputFormats>
                            <timestampedReports>false</timestampedReports>
                        </configuration>
                        <dependencies>
                            <dependency>
                                <groupId>org.pitest</groupId>
                                <artifactId>pitest-junit5-plugin</artifactId>
                                <version>1.2.3</version>
                            </dependency>
                        </dependencies>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <!--
            security profile (MQ Q2)：SpotBugs + FindSecBugs per-module 接入。
            插件位置裁决（设计文档 §6.2 R2-MAJOR-2）：SpotBugs 分析每模块编译产物字节码，
            与 Q1 pitest per-module instrumentation 同型——根 pom profile 继承失效
            （根 pom app-erp 仅为 reactor 聚合器，子模块 <parent> 是 nop-entropy/app-erp-<domain>），
            须 per-module 声明（对齐 Q1 pitest per-module 先例）。
            激活：mvn -Psecurity -pl module-finance/erp-fin-service -am compile spotbugs:check
            effort=Max + threshold=Low：报告全部 FindSecBugs 安全规则命中（降噪靠 §5.1 分类 + excludeFilter）。
            excludeFilterFile：排除 Nop 生成代码三类（_gen/api.beans/api.crud，D 类噪声）。
            findsecbugs-plugin：作为 spotbugs 插件依赖注册 FindSecBugs 安全规则探测器。
            failOnError=false：纯 reporter，gate 逻辑活在 CI（§5.3 单向收紧，门控不阻塞此处 build）。
        -->
        <profile>
            <id>security</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>com.github.spotbugs</groupId>
                        <artifactId>spotbugs-maven-plugin</artifactId>
                        <!-- 4.9.8.3：支持 Java 21-26 字节码（CI Java 21 / 本地 Java 26 均兼容） -->
                        <version>4.9.8.3</version>
                        <configuration>
                            <effort>Max</effort>
                            <threshold>Low</threshold>
                            <!-- includeFilterFile：scope 报告到 FindSecBugs 安全规则模式（§6.2 step 1），
                                 避免安全基线被通用代码质量规则稀释 -->
                            <includeFilterFile>${maven.multiModuleProjectDirectory}/spotbugs-include.xml</includeFilterFile>
                            <!-- excludeFilterFile：排除 Nop 生成代码三类（D 类噪声，对齐 Q1 pitest excludedClasses 先例） -->
                            <excludeFilterFile>${maven.multiModuleProjectDirectory}/spotbugs-exclude.xml</excludeFilterFile>
                            <!-- 输出 XML 供 CI Python gate 解析（§5.4 spotbugs_counts per-type count 比对） -->
                            <xmlOutput>true</xmlOutput>
                            <failOnError>false</failOnError>
                        </configuration>
                        <dependencies>
                            <!-- FindSecBugs 安全规则探测器（OWASP 推荐 Java 安全扫描器） -->
                            <dependency>
                                <groupId>com.h3xstream.findsecbugs</groupId>
                                <artifactId>findsecbugs-plugin</artifactId>
                                <!-- 1.13.0：最新版，兼容 SpotBugs 4.9.x；Java 21 字节码 Phase 2 首跑验证 -->
                                <version>1.13.0</version>
                            </dependency>
                        </dependencies>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
