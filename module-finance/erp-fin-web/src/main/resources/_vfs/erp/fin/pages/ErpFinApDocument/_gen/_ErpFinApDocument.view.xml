<?xml version="1.0" encoding="UTF-8" ?>
<view x:schema="/nop/schema/xui/xview.xdef" bizObjName="ErpFinApDocument" xmlns:i18n-en="i18n-en"
      xmlns:x="/nop/schema/xdsl.xdef" xmlns:j="j" xmlns:c="c" xmlns:gql="gql" xmlns:view-gen="view-gen" xmlns:xpl="xpl">

    <objMeta>/erp/fin/model/ErpFinApDocument/ErpFinApDocument.xmeta</objMeta>

    <controlLib>/nop/web/xlib/flux-control.xlib</controlLib>

    <x:gen-extends>
        <view-gen:DefaultViewGenExtends xpl:lib="/nop/web/xlib/view-gen.xlib"/>
    </x:gen-extends>

    <x:post-extends>
        <view-gen:DefaultViewPostExtends xpl:lib="/nop/web/xlib/view-gen.xlib"/>
    </x:post-extends>

    <grids>
        <grid id="list" x:abstract="true">
            <cols>

                <!--ID-->
                <col id="id" mandatory="true" sortable="true"/>

                <!--业务组织-->
                <col id="orgId" sortable="true"/>

                <!--文件名-->
                <col id="fileName" mandatory="true" sortable="true"/>

                <!--文件扩展名-->
                <col id="fileExt" sortable="true"/>

                <!--MIME 类型-->
                <col id="mimeType" sortable="true"/>

                <!--文件大小(字节)-->
                <col id="fileLength" ui:number="true" sortable="true"/>

                <!--文件引用(nop-file)-->
                <col id="fileId" sortable="true"/>

                <!--来源-->
                <col id="sourceType" mandatory="true" sortable="true"/>

                <!--文档状态-->
                <col id="status" mandatory="true" sortable="true"/>

                <!--单据类型-->
                <col id="docType" sortable="true"/>

                <!--对应方(供应商)-->
                <col id="partnerId" sortable="true"/>

                <!--分类置信度-->
                <col id="confidence" ui:number="true" sortable="true"/>

                <!--解析结果-->
                <col id="parseResult" sortable="true"/>

                <!--草稿发票回链-->
                <col id="invoiceId" sortable="true"/>

                <!--错误信息-->
                <col id="errorMsg" sortable="true"/>

                <!--重试次数-->
                <col id="retryCount" ui:number="true" sortable="true"/>

                <!--逻辑删除版本-->
                <col id="delVersion" mandatory="true" ui:number="true" sortable="true"/>

                <!--创建人-->
                <col id="createdBy" mandatory="true" sortable="true"/>

                <!--创建时间-->
                <col id="createTime" mandatory="true" sortable="true"/>

                <!--修改人-->
                <col id="updatedBy" mandatory="true" sortable="true"/>

                <!--修改时间-->
                <col id="updateTime" mandatory="true" sortable="true"/>

                <!--备注-->
                <col id="remark" sortable="true"/>
            </cols>
        </grid>
        <grid id="pick-list" x:prototype="list" x:abstract="true"/>
    </grids>

    <forms>
        <form id="view" editMode="view" title="查看-AP 摄取文档" i18n-en:title="View AP Document">
            <layout>
 orgId[业务组织] fileName[文件名]
 fileExt[文件扩展名] mimeType[MIME 类型]
 fileLength[文件大小(字节)] fileId[文件引用(nop-file)]
 sourceType[来源] status[文档状态]
 docType[单据类型] partnerId[对应方(供应商)]
 confidence[分类置信度] parseResult[解析结果]
 invoiceId[草稿发票回链] errorMsg[错误信息]
 retryCount[重试次数] delVersion[逻辑删除版本]
 createdBy[创建人] createTime[创建时间]
 updatedBy[修改人] updateTime[修改时间]
 remark[备注] 
</layout>
        </form>
        <form id="add" editMode="add" title="新增-AP 摄取文档" i18n-en:title="Add AP Document" x:prototype="edit"/>
        <form id="edit" editMode="edit" title="编辑-AP 摄取文档" i18n-en:title="Edit AP Document">
            <layout>
 orgId[业务组织] fileName[文件名]
 fileExt[文件扩展名] mimeType[MIME 类型]
 fileLength[文件大小(字节)] fileId[文件引用(nop-file)]
 sourceType[来源] status[文档状态]
 docType[单据类型] partnerId[对应方(供应商)]
 confidence[分类置信度] parseResult[解析结果]
 invoiceId[草稿发票回链] errorMsg[错误信息]
 retryCount[重试次数] remark[备注]
</layout>
        </form>
        <form id="query" editMode="query" title="查询条件" i18n-en:title="Query Condition" x:abstract="true"/>
        <form id="asideFilter" editMode="query" x:abstract="true" submitOnChange="true"/>
        <form id="batchUpdate" editMode="edit" x:abstract="true" title="修改-AP 摄取文档" i18n-en:title="Update AP Document"/>
    </forms>

    <pages>
        <crud name="view-list" grid="list" asideFilterForm="asideFilter" filterForm="query" x:abstract="true">
            <table autoFillHeight="true">
                <api url="@query:ErpFinApDocument__findPage" gql:selection="{@pageSelection}"/>
            </table>
        </crud>
        <crud name="main" grid="list" asideFilterForm="asideFilter" filterForm="query" x:abstract="true">
            <table autoFillHeight="true">
                <api url="@query:ErpFinApDocument__findPage" gql:selection="{@pageSelection}"/>
            </table>
            <listActions>
                <action id="batch-delete-button" label="@i18n:common.batchDelete" batch="true">
                    <api url="@mutation:ErpFinApDocument__batchDelete?ids=${ids}"/>
                    <confirmText>@i18n:common.confirmBatchDelete</confirmText>
                </action>
                <action id="add-button" level="primary" label="@i18n:common.add" icon="fa fa-plus pull-left">
                    <dialog page="add"/>
                </action>
            </listActions>
            <rowActions>
                <action id="row-view-button" level="primary" label="@i18n:common.view">
                    <dialog page="view"/>
                </action>
                <action id="row-update-button" level="primary" label="@i18n:common.edit" x:abstract="true">
                    <dialog page="update"/>
                </action>
                <action id="row-delete-button" level="danger" label="@i18n:common.delete" x:abstract="true">
                    <api url="@mutation:ErpFinApDocument__delete?id=${id}"/>
                    <confirmText>@i18n:common.confirmDelete</confirmText>
                </action>
                <actionGroup id="row-more-button" label="@i18n:common.more" level="primary">
                    <action id="row-update-button" label="@i18n:common.edit">
                        <dialog page="update"/>
                    </action>
                    <action id="row-delete-button" label="@i18n:common.delete">
                        <api url="@mutation:ErpFinApDocument__delete?id=${id}"/>
                        <confirmText>@i18n:common.confirmDelete</confirmText>
                    </action>
                </actionGroup>
            </rowActions>
        </crud>
        <picker name="picker" grid="pick-list" asideFilterForm="asideFilter" filterForm="query" x:abstract="true">
            <table noOperations="true">
                <api url="@query:ErpFinApDocument__findPage" gql:selection="{@pageSelection}"/>
            </table>
        </picker>
        <simple name="add" form="add">
            <api url="@mutation:ErpFinApDocument__save/id"/>
        </simple>
        <simple name="view" form="view">
            <initApi url="@query:ErpFinApDocument__get?id=${id}" gql:selection="{@formSelection}"/>
        </simple>
        <simple name="update" form="edit">
            <initApi url="@query:ErpFinApDocument__get?id=${id}" gql:selection="{@formSelection}"/>
            <api url="@mutation:ErpFinApDocument__update/id?id=${id}" withFormData="true"/>
        </simple>
    </pages>
</view>