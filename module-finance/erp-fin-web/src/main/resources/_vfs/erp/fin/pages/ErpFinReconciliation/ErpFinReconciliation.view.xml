<?xml version="1.0" encoding="UTF-8" ?>
<view xmlns:i18n-en="i18n-en" x:extends="_gen/_ErpFinReconciliation.view.xml" x:schema="/nop/schema/xui/xview.xdef"
      xmlns:x="/nop/schema/xdsl.xdef">
    <controlLib>/erp/xlib/control.xlib</controlLib>

    <grids>
        <grid id="list">
            <cols x:override="bounded-merge">
                <col id="id" mandatory="true" ui:number="true" sortable="true"/>
                <col id="code" mandatory="true" sortable="true"/>
                <col id="orgId" label="业务组织" i18n-en:label="Business Org"/>
                <col id="direction" mandatory="true" sortable="true"/>
                <col id="partnerId" label="往来单位" i18n-en:label="Business Partner"/>
                <col id="currencyId" label="币种" i18n-en:label="Currency"/>
                <col id="businessDate" mandatory="true" sortable="true" align="center"></col>
                <col id="totalAmountFunctional" sortable="true"/>
                <col id="docStatus" mandatory="true" sortable="true">
                    <gen-control>
                        <c:script><![CDATA[
                            const valueProp = dispMeta?.id || 'docStatus';
                            const labelProp = propMeta?.['graphql:labelProp'] || (valueProp + '_label');
                            return {
                                type: "tpl",
                                tpl: '<span class="label label-${' + valueProp
                                    + " == 'ACTIVE' ? 'primary' : 'default'}\" "
                                    + "${" + valueProp
                                    + " == 'CANCELLED' ? \"style='text-decoration:line-through'\" : ''}>"
                                    + "${" + labelProp + "}</span>"
                            };
                        ]]></c:script>
                    </gen-control>
                </col>
            </cols>
        </grid>
        <grid id="pick-list"/>
    </grids>

    <forms>
        <form id="view">
            <layout x:override="replace">
==========>baseInfo[基本信息]======
 code[单号] orgId[组织]
 acctSchemaId[账套] direction[应收应付]
 partnerId[往来单位] businessDate[业务日期]
 currencyId[币种] exchangeRate[汇率]
 docStatus[状态]
==========>amount[金额信息]======
 totalAmountSource[核销总额(源币)] totalAmountFunctional[核销总额(本位币)]
 fxGainLoss[汇兑损益]
==========^audit[审计信息]=========
 remark[备注]
 createdBy[创建人] createTime[创建时间]
 updatedBy[修改人] updateTime[修改时间]
            </layout>
        </form>
        <form id="edit">
            <layout x:override="replace">
==========>baseInfo[基本信息]======
 code[单号] orgId[组织]
 acctSchemaId[账套] direction[应收应付]
 partnerId[往来单位] businessDate[业务日期]
 currencyId[币种] exchangeRate[汇率]
 docStatus[状态]
==========>amount[金额信息]======
 totalAmountSource[核销总额(源币)] totalAmountFunctional[核销总额(本位币)]
 fxGainLoss[汇兑损益]
 remark[备注](2)
            </layout>
        </form>
        <form id="add"/>
        <form id="query" editMode="query" title="查询条件" i18n-en:title="Query Condition">
            <layout>
 code[单号] docStatus[状态]
 partnerId[往来单位] businessDate[业务日期]
            </layout>
            <cells>
                <cell id="code" filterOp="like"/>
                <cell id="businessDate" filterOp="date-between"/>
            </cells>
        </form>
    </forms>

    <pages>
        <crud name="main">
            <listActions>
                <action id="auto-reconcile-button" label="自动核销" i18n-en:label="Auto Settle" level="primary" icon="fa fa-magic">
                    <api url="@mutation:ErpFinReconciliation__runAutoReconciliation">
                        <data>
                            <direction>${direction | default:'RECEIVABLE'}</direction>
                            <partnerId>${partnerId | default:null}</partnerId>
                            <strategy>${strategy | default:null}</strategy>
                        </data>
                    </api>
                    <confirmText>确认执行自动核销？系统将按 FIFO 策略匹配 OPEN/PARTIAL 收付款项与发票项。配置标志 erp-fin.auto-reconcile 必须开启，否则操作将被拒绝。</confirmText>
                    <messages>
                        <success>自动核销已完成（详见返回结果）</success>
                    </messages>
                </action>
            </listActions>
            <rowActions x:override="bounded-merge">
                <action id="row-view-button"/>
                <!-- F7 §3 冲销预览（plan 2026-07-23-1145-2 Phase 2）：先调 previewReverse 展示辅助账回退影响，
                     用户确认后才执行 reverse。核销冲销不生成 GL 凭证，预览仅含辅助账回退列表。 -->
                <action id="row-reverse-button" label="红冲" i18n-en:label="Red Reverse" level="danger" icon="fa fa-undo">
                    <visibleOn>${docStatus == 'POSTED'}</visibleOn>
                    <onEvent>
                        <click>
                            <actions>
                                <action>
                                    <actionType>ajax</actionType>
                                    <api>
                                        <method>post</method>
                                        <url>/graphql</url>
                                        <data>
                                            <query>${"query{ErpFinReconciliation__previewReverse(reconciliationId:" + id + "){code direction totalAmountFunctional partnerId willSetReversed willRefreshPartnerBalance revertedItems{arApItemId sourceBillType sourceBillCode side currentStatus willBecomeStatus restoreAmountFunctional}}}"}</query>
                                        </data>
                                        <responseType>response</responseType>
                                    </api>
                                    <outputVar>preview</outputVar>
                                </action>
                                <action>
                                    <actionType>dialog</actionType>
                                    <dialog>
                                        <title>核销单冲销预览</title>
                                        <body>
                                            <tpl tpl="核销单号：&lt;b&gt;${'$'}{preview.data.ErpFinReconciliation__previewReverse.code}&lt;/b&gt;（${'$'}{preview.data.ErpFinReconciliation__previewReverse.direction}）&lt;br/&gt;核销总额(本位币)：${'$'}{preview.data.ErpFinReconciliation__previewReverse.totalAmountFunctional}&lt;br/&gt;将回退 ${'$'}{preview.data.ErpFinReconciliation__previewReverse.revertedItems.length | default:0} 项 AR/AP 辅助账（SETTLED→OPEN/PARTIAL），并刷新往来单位余额。&lt;br/&gt;&lt;span style='color:#8a6d3b'&gt;注意：核销冲销不生成红字凭证（凭证由收付款审核时生成）。&lt;/span&gt;&lt;br/&gt;确认后核销单状态将置为「已冲销」，不可恢复。"/>
                                        </body>
                                        <actions>
                                            <action>
                                                <type>button</type>
                                                <actionType>ajax</actionType>
                                                <label>确认冲销</label>
                                                <level>danger</level>
                                                <api url="@mutation:ErpFinReconciliation__reverse?reconciliationId=$id"/>
                                                <messages><success>核销单已冲销</success></messages>
                                                <close>true</close>
                                            </action>
                                            <action>
                                                <type>button</type>
                                                <actionType>close</actionType>
                                                <label>取消</label>
                                            </action>
                                        </actions>
                                    </dialog>
                                </action>
                            </actions>
                        </click>
                    </onEvent>
                </action>
            </rowActions>
        </crud>
        <picker name="picker"/>
    </pages>
</view>