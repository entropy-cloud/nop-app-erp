<?xml version="1.0" encoding="UTF-8" ?>
<view xmlns:i18n-en="i18n-en" x:extends="_gen/_ErpFinVoucher.view.xml" x:schema="/nop/schema/xui/xview.xdef" xmlns:x="/nop/schema/xdsl.xdef">

    <grids>
        <grid id="list">
            <cols x:override="bounded-merge">
                <col id="id" mandatory="true" ui:number="true" sortable="true"/>
                <col id="code" mandatory="true" sortable="true"/>
                <col id="voucherType" mandatory="true" sortable="true"/>
                <col id="voucherDate" mandatory="true" sortable="true" align="center">
                    <gen-control>
                        <c:script><![CDATA[
                            return { type: 'date', format: 'YYYY-MM-DD' };
                        ]]></c:script>
                    </gen-control>
                </col>
                <col id="orgId" label="业务组织" i18n-en:label="Business Org"/>
                <col id="isReversed" sortable="true"/>
                <col id="totalDebit" ui:number="true" sortable="true" align="right">
                    <gen-control>
                        <c:script><![CDATA[
                            return { type: 'number', kilometer: true, precision: 2 };
                        ]]></c:script>
                    </gen-control>
                </col>
                <col id="totalCredit" ui:number="true" sortable="true" align="right">
                    <gen-control>
                        <c:script><![CDATA[
                            return { type: 'number', kilometer: true, precision: 2 };
                        ]]></c:script>
                    </gen-control>
                </col>
                <col id="balanceStatus" label="平衡状态" i18n-en:label="Balance Status" sortable="true" custom="true">
                    <gen-control>
                        <c:script><![CDATA[
                            return {
                                type: 'tpl',
                                tpl: '<span class="label label-${totalDebit == totalCredit ? "success" : "danger"}">' +
                                    '${totalDebit == totalCredit ? "✓ 平衡" : "✗ 不平衡"}</span>'
                            };
                        ]]></c:script>
                    </gen-control>
                </col>
                <col id="docStatus" mandatory="true" sortable="true">
                    <gen-control>
                        <c:script><![CDATA[
                            const valueProp = dispMeta?.id || 'docStatus';
                            const labelProp = propMeta?.['graphql:labelProp'] || (valueProp + '_label');
                            return {
                                type: "tpl",
                                tpl: '<span class="label label-${' + valueProp
                                    + " == 'ACTIVE' ? 'primary' : 'default'}\" "
                                    + "${" + valueProp
                                    + " == 'CANCELLED' ? \"style='text-decoration:line-through'\" : ''}>"
                                    + "${" + labelProp + "}</span>"
                            };
                        ]]></c:script>
                    </gen-control>
                </col>
            </cols>
        </grid>
        <grid id="pick-list"/>
    </grids>

    <forms>
        <form id="view" layoutControl="tabs">
            <layout x:override="replace">
=========>baseInfo[基本信息]======
 code[凭证号] voucherType[凭证字]
 voucherDate[凭证日期] voucherNo[凭证编号]
 orgId[核算组织] acctSchemaId[账套]
 periodId[会计期间] docStatus[凭证状态]
==========>posting[过账信息]=========
 @totalDebit[借方合计] @totalCredit[贷方合计]
 postingType[过账类型] isReversed[是否红字冲销凭证]
 reversalOfVoucherId[原冲销凭证ID]
=========>lines[分录行]======
 lines[分录行](2)
==========^audit[审计信息]=========
 remark[备注]
 createdBy[创建人] createTime[创建时间]
 updatedBy[修改人] updateTime[修改时间]
            </layout>
            <cells>
                <cell id="lines">
                    <view path="/erp/fin/pages/ErpFinVoucherLine/ErpFinVoucherLine.view.xml" grid="sub-grid-view"/>
                </cell>
            </cells>
        </form>
        <form id="edit" layoutControl="tabs">
            <layout x:override="replace">
=========>baseInfo[基本信息]======
 code[凭证号] voucherType[凭证字]
 voucherDate[凭证日期] voucherNo[凭证编号]
 orgId[核算组织] acctSchemaId[账套]
 periodId[会计期间] docStatus[凭证状态]
=========>posting[过账信息]=========
 @totalDebit[借方合计] @totalCredit[贷方合计]
 balanceBadge[平衡校验]
=========>lines[分录行]======
 quickTemplate[快捷模板](2)
 autoBalance[借贷自动平衡](2)
 lines[分录行](2)
 remark[备注](2)
            </layout>
            <cells>
                <!--
                  借贷平衡实时警示 badge（F16 P1，plan §Phase 1，Phase 0 Explore (a) 降级方案落地）。
                  per Explore (a) 裁决：行级 onEvent→头合计聚合受 xview schema 约束（行 scope 无法干净写头 totalDebit/totalCredit），
                  故采用 autoBalance 按钮扩展（既有，用户点击刷新头合计）+ 本 badge（实时可见性）。
                  visibleOn：仅当存在分录行或合计非 0 时显示，避免新建空凭证时噪声。
                -->
                <cell id="balanceBadge" custom="true" notSubmit="true">
                    <gen-control>
                        <c:script><![CDATA[
                            return {
                                type: 'tpl',
                                className: 'mb-0',
                                tpl: '<span class="label label-${' + 'Number(totalDebit) == Number(totalCredit) ? "success" : "danger' + '}"><i class="fa ${' + 'Number(totalDebit) == Number(totalCredit) ? "fa-check-circle" : "fa-exclamation-triangle' + '}"></i> ${' + 'Number(totalDebit) == Number(totalCredit) ? "借贷平衡" : "借贷不平衡（需点击下方刷新合计按钮）"' + '}</span>'
                            };
                        ]]></c:script>
                    </gen-control>
                </cell>
                <!--
                  快捷模板 toolbar 按钮（F16 P1，plan §Phase 1）。
                  per Phase 0 Explore (a)+(b)：链接到凭证模板配置页（previewTemplate 按钮在该页调用
                  ErpFinVoucherTemplate__renderTemplate @BizMutation 完成预览）。采用 link 而非内嵌 dialog，
                  因 xview <c:script> 为 XLang（${} 会被编译期插值），复杂 AMIS dialog 的 ${} 运行期表达式
                  需经 page.yaml（YAML）承载——voucher 录入页的快捷入口降级为导航链接，模板预览在配置页落地。
                -->
                <cell id="quickTemplate" custom="true" notSubmit="true">
                    <gen-control>
                        <c:script><![CDATA[
                            return {
                                type: 'button',
                                label: '快捷模板',
                                level: 'primary',
                                icon: 'fa fa-magic',
                                actionType: 'link',
                                link: '/ErpFinVoucherTemplate-main',
                                tooltip: '跳转到凭证模板配置页，使用「预览测试生成凭证」按钮（调用 renderTemplate 表达式引擎）预览分录行'
                            };
                        ]]></c:script>
                    </gen-control>
                </cell>
                <!--
                  借贷自动平衡按钮（ui-patterns §1 line 67）+ 头余额合计刷新：
                  点击计算 totalDebit - totalCredit 差额，填入最后一行（借<贷补借方，反之补贷方）。
                  同时刷新头 totalDebit/totalCredit 实时聚合（行 SUM）。
                  
                  实时聚合 onEvent 在 P0/P1 plan 中已 DEFERRED（P1 plan `2026-07-20-0629-1` §Deferred「头聚合 onEvent
                  在 P0 实际未实施」），本计划对齐既有行为：head totals 由本按钮 + 保存后服务端写入。
                  actionType=custom + script 经 doAction(setValue) 写回 lines + totalDebit + totalCredit。
                -->
                <cell id="autoBalance" custom="true" notSubmit="true">
                    <gen-control>
                        <c:script><![CDATA[
                            return {
                                type: 'button',
                                label: '刷新合计 + 借贷自动平衡（差额填入末行）',
                                level: 'warning',
                                icon: 'fa fa-balance-scale',
                                onEvent: {
                                    click: {
                                        actions: [
                                            {
                                                actionType: 'custom',
                                                script: 'const lines = Array.isArray(event.data.lines) ? event.data.lines.slice() : []; const totalD = lines.reduce((s, l) => s + (Number(l.debitAmount) || 0), 0); const totalC = lines.reduce((s, l) => s + (Number(l.creditAmount) || 0), 0); if (lines.length === 0) { doAction({actionType:"setValue", args:{value:{totalDebit: 0, totalCredit: 0}}}); doAction({actionType:"toast", args:{msgtype:"info", msg:"无分录行"}}); return; } if (Math.abs(totalD - totalC) < 0.0001) { doAction({actionType:"setValue", args:{value:{totalDebit: totalD, totalCredit: totalC}}}); doAction({actionType:"toast", args:{msgtype:"success", msg:"凭证已平衡，合计已刷新"}}); return; } const last = lines[lines.length - 1]; const diff = totalD - totalC; if (diff > 0) { last.creditAmount = (Number(last.creditAmount) || 0) + diff; } else { last.debitAmount = (Number(last.debitAmount) || 0) + (-diff); } doAction({actionType:"setValue", args:{value:{lines: lines, totalDebit: totalD + (diff < 0 ? (-diff) : 0), totalCredit: totalC + (diff > 0 ? diff : 0)}}});'
                                            }
                                        ]
                                    }
                                }
                            };
                        ]]></c:script>
                    </gen-control>
                </cell>
                <!--
                  lines 子表 cell：引用 ErpFinVoucherLine sub-grid-edit（17 列布局）。
                  xview schema 限制 <view> 仅允许 <data> 子节点，onEvent 头聚合已移到 autoBalance 按钮触发。
                -->
                <cell id="lines">
                    <view path="/erp/fin/pages/ErpFinVoucherLine/ErpFinVoucherLine.view.xml" grid="sub-grid-edit"/>
                </cell>
            </cells>
        </form>
        <form id="add"/>
        <form id="asideFilter" editMode="query" submitOnChange="true">
            <layout>
 voucherType[凭证字] docStatus[凭证状态]
 voucherNo[凭证编号] periodId[会计期间]
 postingType[过账类型] acctSchemaId[账套]
            </layout>
            <cells>
                <cell id="voucherType" filterOp="eq"/>
                <cell id="docStatus" filterOp="eq"/>
                <cell id="voucherNo" filterOp="like"/>
                <cell id="periodId" filterOp="eq"/>
                <cell id="postingType" filterOp="eq"/>
                <cell id="acctSchemaId" filterOp="eq"/>
            </cells>
        </form>
        <form id="query" editMode="query" title="查询条件" i18n-en:title="Query Condition">
            <layout>
 code[凭证号] voucherDate[凭证日期]
            </layout>
            <cells>
                <cell id="code" filterOp="like"/>
                <cell id="voucherDate" filterOp="date-between"/>
            </cells>
        </form>
    </forms>

    <pages>
        <crud name="main">
            <rowActions x:override="bounded-merge">
                <action id="row-view-button"/>
                <action id="row-update-button" actionType="drawer"/>
                <action id="row-post-button" label="过账" i18n-en:label="Post" level="success" icon="fa fa-check-circle"
                        tooltip="借贷不平衡时无法过账（列表「平衡状态」列显示差额）">
                    <api url="@mutation:ErpFinVoucher__postVoucher?voucherId=$id"/>
                    <confirmText>确认过账此凭证？过账后不可编辑。</confirmText>
                    <messages>
                        <success>凭证已过账</success>
                    </messages>
                    <visibleOn>${docStatus == 'DRAFT'}</visibleOn>
                    <disabledOn>${(Number(totalDebit) || 0) != (Number(totalCredit) || 0)}</disabledOn>
                </action>
                <action id="row-reverse-button" label="红冲" i18n-en:label="Red Reverse" level="danger" icon="fa fa-undo">
                    <visibleOn>${docStatus == 'POSTED' &amp;&amp; !isReversed}</visibleOn>
                    <!-- F7 §3 冲销预览（plan 2026-07-23-1145-2 Phase 2）：先调 previewReverseVoucher 展示冲销影响，
                         用户确认后才执行 reverseVoucher。preview-then-confirm 范式（区别于删除的 blocker 范式）。 -->
                    <onEvent>
                        <click>
                            <actions>
                                <action>
                                    <actionType>ajax</actionType>
                                    <api>
                                        <method>post</method>
                                        <url>/graphql</url>
                                        <data>
                                            <query>${"query{ErpFinVoucher__previewReverseVoucher(voucherId:" + id + "){voucherCode voucherType voucherDate totalDebit totalCredit reversedDebit reversedCredit lineCount willSetReversed billLinks{billType billCode businessType}}}"}</query>
                                        </data>
                                        <responseType>response</responseType>
                                    </api>
                                    <outputVar>preview</outputVar>
                                </action>
                                <action>
                                    <actionType>dialog</actionType>
                                    <dialog>
                                        <title>红字冲销预览</title>
                                        <body>
                                            <tpl tpl="凭证号：&lt;b&gt;${'$'}{preview.data.ErpFinVoucher__previewReverseVoucher.voucherCode}&lt;/b&gt;（${'$'}{preview.data.ErpFinVoucher__previewReverseVoucher.voucherType}）&lt;br/&gt;凭证日期：${'$'}{preview.data.ErpFinVoucher__previewReverseVoucher.voucherDate} ｜ 分录行数：${'$'}{preview.data.ErpFinVoucher__previewReverseVoucher.lineCount}&lt;br/&gt;原借方合计：${'$'}{preview.data.ErpFinVoucher__previewReverseVoucher.totalDebit} ｜ 原贷方合计：${'$'}{preview.data.ErpFinVoucher__previewReverseVoucher.totalCredit}&lt;br/&gt;红字预估借方：&lt;span style='color:#d9534f'&gt;${'$'}{preview.data.ErpFinVoucher__previewReverseVoucher.reversedDebit}&lt;/span&gt; ｜ 红字预估贷方：&lt;span style='color:#d9534f'&gt;${'$'}{preview.data.ErpFinVoucher__previewReverseVoucher.reversedCredit}&lt;/span&gt;&lt;br/&gt;确认后原凭证将被标记为「已红冲」，不可恢复。"/>
                                        </body>
                                        <actions>
                                            <action>
                                                <type>button</type>
                                                <actionType>ajax</actionType>
                                                <label>确认红冲</label>
                                                <level>danger</level>
                                                <api url="@mutation:ErpFinVoucher__reverseVoucher?voucherId=$id"/>
                                                <messages><success>凭证已红冲</success></messages>
                                                <close>true</close>
                                            </action>
                                            <action>
                                                <type>button</type>
                                                <actionType>close</actionType>
                                                <label>取消</label>
                                            </action>
                                        </actions>
                                    </dialog>
                                </action>
                            </actions>
                        </click>
                    </onEvent>
                </action>
                <action id="row-delete-button"/>
            </rowActions>
        </crud>
        <picker name="picker"/>
    </pages>
</view>