<?xml version="1.0" encoding="UTF-8" ?>
<beans x:schema="/nop/schema/beans.xdef" xmlns:x="/nop/schema/xdsl.xdef"
       xmlns="http://www.springframework.org/schema/beans" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans
        http://www.springframework.org/schema/beans/spring-beans-2.5.xsd">

    <import resource="_dao.beans.xml"/>

    <import resource="_service.beans.xml"/>

    <!-- HR 薪酬核算引擎组件（payroll.md §五/§六/§七）。BizModel 逻辑挂在 ErpHrSalaryBizModel（实体绑定，
         由 _service.beans.xml 自动注册 BizProxy），此处仅注册核算/过账辅助组件。 -->
    <bean id="app.erp.hr.service.payroll.TaxBracketParser"
          class="app.erp.hr.service.payroll.TaxBracketParser"/>
    <bean id="app.erp.hr.service.payroll.SocialInsuranceCalculator"
          class="app.erp.hr.service.payroll.SocialInsuranceCalculator"/>
    <bean id="app.erp.hr.service.payroll.IncomeTaxCalculator"
          class="app.erp.hr.service.payroll.IncomeTaxCalculator"/>
    <bean id="app.erp.hr.service.payroll.PayrollCalculator"
          class="app.erp.hr.service.payroll.PayrollCalculator"/>

    <!-- HR 业财过账：执行器 + 派发器 + Provider（Registry 容器级 collect-by-type 自动收录） -->
    <bean id="app.erp.hr.service.posting.SalaryPostingExecutor"
          class="app.erp.hr.service.posting.SalaryPostingExecutor"/>
    <bean id="app.erp.hr.service.posting.SalaryPostingDispatcher"
          class="app.erp.hr.service.posting.SalaryPostingDispatcher"/>
    <bean id="app.erp.hr.service.posting.SalaryPostingProvider"
          class="app.erp.hr.service.posting.SalaryPostingProvider"/>

    <!-- HR 胜任力管理引擎组件（competency-management.md §评估流程/§差距分析）。
         纯函数式 + 注入加载函数便于单测；BizModel 经 @Inject 引用。 -->
    <bean id="app.erp.hr.service.competency.AssessmentAggregator"
          class="app.erp.hr.service.competency.AssessmentAggregator"/>
    <bean id="app.erp.hr.service.competency.GapAnalysisCalculator"
          class="app.erp.hr.service.competency.GapAnalysisCalculator"/>

    <!-- HR 域报表渲染入口（plan 2026-07-06-1247-1）：非实体 BizModel，注入平台 IReportEngine，
          经 @BizQuery 暴露 renderHtml/download。@BizModel 注解由 bizObject 管理器自动识别。
          镜像 finance ErpFinReportBizModel / manufacturing ErpMfgReportBizModel / inventory ErpInvReportBizModel
          （域隔离 /hr/ vs /fin/ vs /mfg/ vs /inv/）。员工净余额跨域只读经 IErpFinArApItemBiz 聚合。 -->
    <bean id="app.erp.hr.service.report.ErpHrReportBizModel" ioc:type="@bean:id"/>

    <!-- HR 合同到期扫描 Job Bean（UC-HR-07），由 scheduler.yaml 经 BeanMethodJobInvoker 反射调用 -->
    <bean id="erpHrContractExpiryJob" class="app.erp.hr.service.job.ErpHrContractExpiryJob"/>
    <!-- HR 休假审批超时转派 Job Bean（UC-HR-02⑦），由 scheduler.yaml 经 BeanMethodJobInvoker 反射调用 -->
    <bean id="erpHrLeaveApproverTimeoutJob" class="app.erp.hr.service.job.ErpHrLeaveApproverTimeoutJob"/>
    <!-- per-mutation Processor beans (R6.7，processor-extension-pattern.md 每 mutation 一 Processor)：
         hr 域 30 须拆 mutation 全部拆为独立 Processor；域专属抽象基类（Abstract*）不注册。 -->
    <bean id="app.erp.hr.service.processor.ErpHrSalaryCalculateSalaryProcessor"
          class="app.erp.hr.service.processor.ErpHrSalaryCalculateSalaryProcessor"/>
    <bean id="app.erp.hr.service.processor.ErpHrSalaryRunPayrollProcessor"
          class="app.erp.hr.service.processor.ErpHrSalaryRunPayrollProcessor"/>
    <bean id="app.erp.hr.service.processor.ErpHrSalaryMarkPaidProcessor"
          class="app.erp.hr.service.processor.ErpHrSalaryMarkPaidProcessor"/>
    <!-- approve 后置计提过账编排 Processor（RC-R1.89）：270/290/300 三连计提 + posted writer D3 语义，
          由 ErpHrSalary.xbiz approve source 状态写回后一行 inject 委托调用（XScript try/catch 不可行，
          编排/失败隔离下沉 Java Bean，对齐 M4.64 Guard/StateMachine Bean 范式）。 -->
    <bean id="app.erp.hr.service.processor.ErpHrSalaryPostApprovalProcessor"
          class="app.erp.hr.service.processor.ErpHrSalaryPostApprovalProcessor"/>
    <bean id="app.erp.hr.service.processor.ErpHrSalaryGenerateBankFileProcessor"
          class="app.erp.hr.service.processor.ErpHrSalaryGenerateBankFileProcessor"/>
    <bean id="app.erp.hr.service.processor.ErpHrSalarySimulationCreateSimulationProcessor"
          class="app.erp.hr.service.processor.ErpHrSalarySimulationCreateSimulationProcessor"/>
    <bean id="app.erp.hr.service.processor.ErpHrSalarySimulationAdjustItemProcessor"
          class="app.erp.hr.service.processor.ErpHrSalarySimulationAdjustItemProcessor"/>
    <bean id="app.erp.hr.service.processor.ErpHrSalarySimulationApplyBatchAdjustmentProcessor"
          class="app.erp.hr.service.processor.ErpHrSalarySimulationApplyBatchAdjustmentProcessor"/>
    <bean id="app.erp.hr.service.processor.ErpHrSalarySimulationConvertToFormalProcessor"
          class="app.erp.hr.service.processor.ErpHrSalarySimulationConvertToFormalProcessor"/>
    <bean id="app.erp.hr.service.processor.ErpHrAttendanceClockInProcessor"
          class="app.erp.hr.service.processor.ErpHrAttendanceClockInProcessor"/>
    <bean id="app.erp.hr.service.processor.ErpHrAttendanceClockOutProcessor"
          class="app.erp.hr.service.processor.ErpHrAttendanceClockOutProcessor"/>
    <bean id="app.erp.hr.service.processor.ErpHrLeaveRequestSubmitProcessor"
          class="app.erp.hr.service.processor.ErpHrLeaveRequestSubmitProcessor"/>
    <bean id="app.erp.hr.service.processor.ErpHrLeaveRequestApproveProcessor"
          class="app.erp.hr.service.processor.ErpHrLeaveRequestApproveProcessor"/>
    <bean id="app.erp.hr.service.processor.ErpHrLeaveRequestCancelProcessor"
          class="app.erp.hr.service.processor.ErpHrLeaveRequestCancelProcessor"/>
    <bean id="app.erp.hr.service.processor.ErpHrShiftCalcAttendanceProcessor"
          class="app.erp.hr.service.processor.ErpHrShiftCalcAttendanceProcessor"/>
    <bean id="app.erp.hr.service.processor.ErpHrShiftOnLeaveApprovedProcessor"
          class="app.erp.hr.service.processor.ErpHrShiftOnLeaveApprovedProcessor"/>
    <bean id="app.erp.hr.service.processor.ErpHrShiftOnLeaveCancelledProcessor"
          class="app.erp.hr.service.processor.ErpHrShiftOnLeaveCancelledProcessor"/>
    <bean id="app.erp.hr.service.processor.ErpHrShiftAssignmentAssignSingleProcessor"
          class="app.erp.hr.service.processor.ErpHrShiftAssignmentAssignSingleProcessor"/>
    <bean id="app.erp.hr.service.processor.ErpHrShiftAssignmentAssignBatchProcessor"
          class="app.erp.hr.service.processor.ErpHrShiftAssignmentAssignBatchProcessor"/>
    <bean id="app.erp.hr.service.processor.ErpHrShiftAssignmentCopyFromPeriodProcessor"
          class="app.erp.hr.service.processor.ErpHrShiftAssignmentCopyFromPeriodProcessor"/>
    <bean id="app.erp.hr.service.processor.ErpHrShiftRotationPatternGenerateRotationProcessor"
          class="app.erp.hr.service.processor.ErpHrShiftRotationPatternGenerateRotationProcessor"/>
    <bean id="app.erp.hr.service.processor.ErpHrShiftSwapRequestSubmitProcessor"
          class="app.erp.hr.service.processor.ErpHrShiftSwapRequestSubmitProcessor"/>
    <bean id="app.erp.hr.service.processor.ErpHrShiftSwapRequestApproveProcessor"
          class="app.erp.hr.service.processor.ErpHrShiftSwapRequestApproveProcessor"/>
    <bean id="app.erp.hr.service.processor.ErpHrEmployeeTransferEmployeeProcessor"
          class="app.erp.hr.service.processor.ErpHrEmployeeTransferEmployeeProcessor"/>
    <bean id="app.erp.hr.service.processor.ErpHrEmployeeAssessmentCompleteAssessmentProcessor"
          class="app.erp.hr.service.processor.ErpHrEmployeeAssessmentCompleteAssessmentProcessor"/>
    <bean id="app.erp.hr.service.processor.ErpHrDevelopmentPlanGenerateDevelopmentPlanProcessor"
          class="app.erp.hr.service.processor.ErpHrDevelopmentPlanGenerateDevelopmentPlanProcessor"/>
    <bean id="app.erp.hr.service.processor.ErpHrDevelopmentPlanUpdatePlanItemStatusProcessor"
          class="app.erp.hr.service.processor.ErpHrDevelopmentPlanUpdatePlanItemStatusProcessor"/>
    <bean id="app.erp.hr.service.processor.ErpHrEmploymentContractExpireOverdueContractsProcessor"
          class="app.erp.hr.service.processor.ErpHrEmploymentContractExpireOverdueContractsProcessor"/>
    <bean id="app.erp.hr.service.processor.ErpHrGapAnalysisRefreshGapAnalysisProcessor"
          class="app.erp.hr.service.processor.ErpHrGapAnalysisRefreshGapAnalysisProcessor"/>
    <bean id="app.erp.hr.service.processor.ErpHrGapAnalysisRefreshGapAnalysisWithLevelsProcessor"
          class="app.erp.hr.service.processor.ErpHrGapAnalysisRefreshGapAnalysisWithLevelsProcessor"/>
    <bean id="app.erp.hr.service.processor.ErpHrRecruitmentHireProcessor"
          class="app.erp.hr.service.processor.ErpHrRecruitmentHireProcessor"/>

    <!-- 实体级 StateMachine Bean（契约 docs/architecture/entity-state-machine-bean.md §5）：一 Bean 对应
          ErpHrLeaveRequest.status 轴 / ErpHrEmploymentContract.status 轴 / ErpHrTimesheet.status 轴 /
          ErpHrEmployee.employmentStatus 轴（退化解）。按类型注入 Processor/BizModel；
          Delta 同名 bean id 覆盖替换基线矩阵（§6）。 -->
    <bean id="app.erp.hr.service.statemachine.ErpHrLeaveRequestStateMachine"
          class="app.erp.hr.service.statemachine.ErpHrLeaveRequestStateMachine"/>
    <bean id="app.erp.hr.service.statemachine.ErpHrEmploymentContractStateMachine"
          class="app.erp.hr.service.statemachine.ErpHrEmploymentContractStateMachine"/>
    <bean id="app.erp.hr.service.statemachine.ErpHrTimesheetStateMachine"
          class="app.erp.hr.service.statemachine.ErpHrTimesheetStateMachine"/>
    <bean id="app.erp.hr.service.statemachine.ErpHrEmployeeStateMachine"
          class="app.erp.hr.service.statemachine.ErpHrEmployeeStateMachine"/>
    <bean id="app.erp.hr.service.statemachine.ErpHrSalaryPaymentStateMachine"
          class="app.erp.hr.service.statemachine.ErpHrSalaryPaymentStateMachine"/>
    <bean id="app.erp.hr.service.statemachine.ErpHrSalaryApprovalStateMachine"
          class="app.erp.hr.service.statemachine.ErpHrSalaryApprovalStateMachine"/>
    <bean id="app.erp.hr.service.processor.ErpHrSalaryApprovalGuard"
          class="app.erp.hr.service.processor.ErpHrSalaryApprovalGuard"/>

</beans>
