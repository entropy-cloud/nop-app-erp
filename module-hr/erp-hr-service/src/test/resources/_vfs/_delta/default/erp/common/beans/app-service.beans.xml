<!-- 平台 bean 初始化循环等待兼容层 II（plan 2026-08-22-0731-1 Phase 3（M3.3 hr 迁移），2026-08-22）：
     nop-orm 08-22 08:20 重装 jar（上游 ignore-depends 断环修复后）暴露第二个 self-wait 环：
     $DEFAULT$nopOrmSessionFactory（initBean，经 by-type 装配 nopDataAuthEntityFilterProvider，
     其 on-bean 条件拉起 nopDataAuthChecker）→ nopDataAuthChecker.daoProvider（@Inject 字段）
     → $DEFAULT$nopDaoProvider（ctor-arg ref nopOrmTemplate，无豁免）→ $DEFAULT$nopOrmTemplate
     （autowire sessionFactory）→ 回到 $DEFAULT$nopOrmSessionFactory 同线程重入
     （nop.err.ioc.bean-init-self-wait）。
     本 delta 将 nopDataAuthChecker 的 daoProvider 注入改为 XML 显式 ioc:lazy-property（镜像
     nopSequenceGenerator delta / 平台 nopDefaultTransactionListener.ormTemplate 先例），
     容器启动期不建立强依赖边，运行期首次使用再注入。ErpRoleDataAuthChecker 为 config-gated
     默认关闭（getFilter→null），运行期延迟注入无语义影响。平台修复该环后移除。 -->
<beans x:schema="/nop/schema/beans.xdef" xmlns:x="/nop/schema/xdsl.xdef"
       xmlns="http://www.springframework.org/schema/beans" xmlns:ioc="ioc"
       x:extends="super">

    <bean id="nopDataAuthChecker" class="app.erp.common.auth.ErpRoleDataAuthChecker"
          x:override="replace">
        <property name="daoProvider" ref="nopDaoProvider" ioc:lazy-property="true"/>
    </bean>
</beans>
