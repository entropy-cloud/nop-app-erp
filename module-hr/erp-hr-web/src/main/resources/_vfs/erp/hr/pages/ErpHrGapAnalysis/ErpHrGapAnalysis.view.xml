<?xml version="1.0" encoding="UTF-8" ?>
<view xmlns:i18n-en="i18n-en" x:extends="_gen/_ErpHrGapAnalysis.view.xml" x:schema="/nop/schema/xui/xview.xdef" xmlns:x="/nop/schema/xdsl.xdef">
    <controlLib>/erp/xlib/control.xlib</controlLib>

    <grids>
        <grid id="list">
            <cols x:override="bounded-merge">
                <col id="id" mandatory="true" ui:number="true" sortable="true"/>
                <col id="employee" label="员工" i18n-en:label="Employee"/>
                <col id="competencyId" label="胜任力" i18n-en:label="Competency"/>
                <col id="requiredLevel" ui:number="true" sortable="true"/>
                <col id="actualLevel" ui:number="true" sortable="true"/>
                <col id="gapValue" ui:number="true" sortable="true" align="right" domain="amount"></col>
                <col id="gapSeverity" sortable="true"/>
                <col id="assessmentDate" sortable="true" align="center"></col>
                <col id="analysisDate" sortable="true" align="center"></col>
            </cols>
        </grid>
        <grid id="pick-list"/>
    </grids>

    <forms>
        <form id="view"/>
        <form id="edit"/>
        <form id="add"/>
    </forms>

    <pages>
        <crud name="main"/>
        <picker name="picker"/>
    </pages>
</view>