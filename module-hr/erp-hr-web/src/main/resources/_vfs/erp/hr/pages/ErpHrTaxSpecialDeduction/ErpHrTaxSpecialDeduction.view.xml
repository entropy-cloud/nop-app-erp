<?xml version="1.0" encoding="UTF-8" ?>
<view xmlns:i18n-en="i18n-en" x:extends="_gen/_ErpHrTaxSpecialDeduction.view.xml" x:schema="/nop/schema/xui/xview.xdef"
      xmlns:x="/nop/schema/xdsl.xdef">
    <controlLib>/erp/xlib/control.xlib</controlLib>

    <grids>
        <grid id="list">
            <cols x:override="bounded-merge">
                <col id="id" mandatory="true" ui:number="true" sortable="true"/>
                <col id="employee" label="员工" i18n-en:label="Employee"/>
                <col id="year" mandatory="true" ui:number="true" sortable="true"/>
                <col id="month" mandatory="true" ui:number="true" sortable="true"/>
                <col id="deductionType" mandatory="true" sortable="true"/>
                <col id="monthlyAmount" mandatory="true" ui:number="true" sortable="true" align="right" domain="amount"></col>
                <col id="verified" sortable="true"/>
                <col id="orgId" label="业务组织" i18n-en:label="Business Org"/>
            </cols>
        </grid>
        <grid id="pick-list"/>
    </grids>

    <forms>
        <form id="view"/>
        <form id="edit"/>
        <form id="add"/>
    </forms>

    <pages>
        <crud name="main"/>
        <picker name="picker"/>
    </pages>
</view>