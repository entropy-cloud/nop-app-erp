<?xml version="1.0" encoding="UTF-8" ?>
<view xmlns:i18n-en="i18n-en" x:extends="_gen/_ErpMdOrganization.view.xml" x:schema="/nop/schema/xui/xview.xdef" xmlns:x="/nop/schema/xdsl.xdef">
    <controlLib>/erp/xlib/control.xlib</controlLib>

    <grids>
                <grid id="list">
            <cols x:override="bounded-merge">
                <col id="id" mandatory="true" ui:number="true" sortable="true"/>
                <col id="code" mandatory="true" sortable="true"/>
                <col id="name" mandatory="true" sortable="true"/>
                <col id="parentId" label="父级组织" i18n-en:label="Parent Organization"/>
                <col id="orgType" mandatory="true" sortable="true"/>
                <col id="functionalCurrencyId" label="本位币" i18n-en:label="Functional Currency"/>
                <col id="status" mandatory="true" sortable="true">
                    <gen-control>
                        <c:script><![CDATA[
                            const valueProp = dispMeta?.id || 'status';
                            const labelProp = propMeta?.['graphql:labelProp'] || (valueProp + '_label');
                            return {
                                type: "tpl",
                                tpl: '<span class="label label-${' + valueProp
                                    + " == 'ACTIVE' ? 'success' : 'default'}\">"
                                    + "${" + labelProp + "}</span>"
                            };
                        ]]></c:script>
                    </gen-control>
                </col>
                <col id="delVersion" mandatory="true" ui:number="true" sortable="true"/>
                <col id="createdBy" mandatory="true" sortable="true"/>
                <col id="createTime" mandatory="true" sortable="true" align="center"></col>
                <col id="updatedBy" mandatory="true" sortable="true"/>
                <col id="updateTime" mandatory="true" sortable="true" align="center"></col>
            </cols>
        </grid>
        <grid id="pick-list"/>
    </grids>

    <forms>
        <form id="view">
            <layout x:override="replace">
==========>baseInfo[基本信息]======
 code[编码] name[名称]
 parentId[父级组织] orgType[组织类型]
 functionalCurrencyId[本位币] status[状态]
==========^audit[审计信息]=========
 createdBy[创建人] createTime[创建时间]
 updatedBy[修改人] updateTime[修改时间]
            </layout>
        </form>
        <form id="edit">
            <layout x:override="replace">
==========>baseInfo[基本信息]======
 code[编码] name[名称]
 parentId[父级组织] orgType[组织类型]
 functionalCurrencyId[本位币] status[状态]
            </layout>
        </form>
        <form id="add"/>
        <form id="query" editMode="query" title="查询条件" i18n-en:title="Query Condition">
            <layout>
 code[编码] name[名称]
 status[状态] orgType[组织类型]
            </layout>
            <cells>
                <cell id="code" filterOp="like"/>
                <cell id="name" filterOp="like"/>
            </cells>
        </form>
    </forms>

    <pages>
        <crud name="main">
            <rowActions x:override="bounded-merge">
                <action id="row-view-button"/>
                <action id="row-update-button" actionType="drawer"/>
                <!-- F7 §3 删除引用阻断（blocker 范式，对齐 ErpMdMaterial）：
                     有引用时弹 dialog 阻断 + "知道了"，无引用时静默放行走原 __delete。 -->
                <action id="row-delete-button" level="danger" label="删除" i18n-en:label="Delete">
                    <api url="@mutation:ErpMdOrganization__delete?id=$id"/>
                    <confirmText>确认删除此组织？</confirmText>
                    <onEvent>
                        <click>
                            <actions>
                                <action>
                                    <actionType>ajax</actionType>
                                    <api>
                                        <method>post</method>
                                        <url>/graphql</url>
                                        <data>
                                            <query>${"query{ErpMdOrganization__countReferences(id:" + id + "){k v}}"}</query>
                                        </data>
                                        <responseType>response</responseType>
                                    </api>
                                    <outputVar>refCount</outputVar>
                                </action>
                                <action>
                                    <actionType>dialog</actionType>
                                    <condition>${refCount &amp;&amp; refCount.data &amp;&amp; refCount.data.ErpMdOrganization__countReferences &amp;&amp; refCount.data.ErpMdOrganization__countReferences.length > 0}</condition>
                                    <dialog>
                                        <title>无法删除：存在引用</title>
                                        <body>该组织被以下业务对象引用，删除将被阻断。请先解除引用关系。</body>
                                        <actions>
                                            <action>
                                                <type>button</type>
                                                <actionType>close</actionType>
                                                <label>知道了</label>
                                            </action>
                                        </actions>
                                    </dialog>
                                </action>
                            </actions>
                        </click>
                    </onEvent>
                </action>
            </rowActions>
        </crud>
        <picker name="picker"/>
    </pages>
</view>