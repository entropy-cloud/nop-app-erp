<?xml version="1.0" encoding="UTF-8" ?>
<!-- M2.1 Delta same-name Bean override proof (plan 2026-08-12-2142-1 Phase 3):
     Delta layer file. When nop.core.vfs.delta-layer-Ids=test-md-delta is active, this file is merged
     over the baseline app-service.beans.xml. The same bean id overrides the baseline
     ErpMdSupplierApprovalStateMachine with derived ErpMdSupplierApprovalStateMachineDelta (tightens approve source:
     APPLIED+PROBATION to APPLIED-only). All other baseline beans (Processors, dashboard, report, party, etc.)
     are preserved by XDsl merge. -->
<beans x:schema="/nop/schema/beans.xdef" xmlns:x="/nop/schema/xdsl.xdef"
       xmlns="http://www.springframework.org/schema/beans">

    <bean id="app.erp.md.service.statemachine.ErpMdSupplierApprovalStateMachine"
          class="app.erp.md.service.statemachine.ErpMdSupplierApprovalStateMachineDelta"/>
</beans>
