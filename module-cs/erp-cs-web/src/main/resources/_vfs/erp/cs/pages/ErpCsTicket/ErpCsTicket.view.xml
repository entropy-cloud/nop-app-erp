<?xml version="1.0" encoding="UTF-8" ?>
<view xmlns:i18n-en="i18n-en" x:extends="_gen/_ErpCsTicket.view.xml" x:schema="/nop/schema/xui/xview.xdef" xmlns:x="/nop/schema/xdsl.xdef">
    <controlLib>/erp/xlib/control.xlib</controlLib>

    <grids>
                <grid id="list">
            <cols x:override="bounded-merge">
                <col id="id" mandatory="true" ui:number="true" sortable="true"/>
                <col id="code" mandatory="true" sortable="true"/>
                <col id="orgId" label="业务组织" i18n-en:label="Business Org"/>
                <col id="subject" sortable="true"/>
                <col id="customerId" label="客户" i18n-en:label="Customer"/>
                <col id="contactId" label="联系人" i18n-en:label="Contact"/>
                <col id="ticketTypeId" label="工单类型" i18n-en:label="Work Order Type"/>
                <col id="slaPolicyId" label="SLA策略" i18n-en:label="SLA Policy"/>
                <col id="catalogItemId" label="目录项" i18n-en:label="Catalog Item"/>
                <col id="priority" sortable="true"/>
                <col id="status" sortable="true">
                    <gen-control>
                        <c:script><![CDATA[
                            const valueProp = dispMeta?.id || 'status';
                            const labelProp = propMeta?.['graphql:labelProp'] || (valueProp + '_label');
                            const successVals = ['COMPLETED','APPROVED','RECEIVED','DELIVERED','PAID','SETTLED','HONORED','RETRIED','EXECUTED','COMPUTED','CONFIRMED','RUNNING','MATERIAL_TRANSFERRED','ACTIVE','CLOSED','DONE','SUCCESS'];
                            const dangerVals = ['REJECTED','CANCELLED','FAILED','DISHONORED','OVERDUE','DOWN','TERMINATED','WRITE_OFF'];
                            const warningVals = ['ON_HOLD','SUSPENDED','EXPIRED','RETRYING'];
                            const primaryVals = ['SUBMITTED','IN_PROGRESS','PARTIAL','PARTIALLY_TRANSFERRED','WORK_IN_PROGRESS','PROCESSING','NEGOTIATION','OPEN','UNDER_MAINTENANCE','COLLECTION_PENDING','DISCOUNTED','ENDORSED','ISSUED'];
                            function quote(v){return "'" + v + "'";}
                            function inList(vals){return "[" + vals.map(quote).join(",") + "].indexOf(" + valueProp + ") >= 0";}
                            const expr = inList(successVals) + " ? 'success' : "
                                + inList(dangerVals) + " ? 'danger' : "
                                + inList(warningVals) + " ? 'warning' : "
                                + inList(primaryVals) + " ? 'primary' : 'default'";
                            return {
                                type: "tpl",
                                tpl: '<span class="label label-${' + expr + "}"
                                    + ">"
                                    + "${" + labelProp + "}</span>"
                            };
                        ]]></c:script>
                    </gen-control>
                </col>
                <col id="docStatus" sortable="true">
                    <gen-control>
                        <c:script><![CDATA[
                            const valueProp = dispMeta?.id || 'docStatus';
                            const labelProp = propMeta?.['graphql:labelProp'] || (valueProp + '_label');
                            return {
                                type: "tpl",
                                tpl: '<span class="label label-${' + valueProp
                                    + " == 'ACTIVE' ? 'primary' : 'default'}\" "
                                    + "${" + valueProp
                                    + " == 'CANCELLED' ? \"style='text-decoration:line-through'\" : ''}>"
                                    + "${" + labelProp + "}</span>"
                            };
                        ]]></c:script>
                    </gen-control>
                </col>
                <col id="approveStatus" sortable="true">
                    <gen-control>
                        <c:script><![CDATA[
                            const valueProp = dispMeta?.id || 'approveStatus';
                            const labelProp = propMeta?.['graphql:labelProp'] || (valueProp + '_label');
                            return {
                                type: "tpl",
                                tpl: '<span class="label label-${' + valueProp
                                    + " == 'APPROVED' ? 'success' : "
                                    + valueProp + " == 'REJECTED' ? 'danger' : "
                                    + valueProp + " == 'SUBMITTED' ? 'info' : 'default'}\">"
                                    + "${" + labelProp + "}</span>"
                            };
                        ]]></c:script>
                    </gen-control>
                </col>
                <col id="deadlineDateTime" sortable="true" align="center"></col>
                <col id="isSlaCompleted" sortable="true"/>
            </cols>
        </grid>
        <grid id="pick-list"/>
    </grids>

    <forms>
        <form id="view" size="lg" layoutControl="tabs">
            <layout x:override="replace">
=========>baseInfo[基本信息]======
 code[单号] orgId[业务组织]
 subject[工单主题] customerId[客户]
 ticketTypeId[工单类型] priority[优先级]
 source[来源] status[工单状态]
 docStatus[单据状态] approveStatus[审核状态]
 contactId[联系人] catalogItemId[服务目录项]
 description[问题描述](2)
=========>sla[SLA与处理]======
 assignedToId[分配处理人] slaPolicyId[SLA 策略]
 deadlineDateTime[SLA 截止时间] isSlaCompleted[SLA 是否完成]
 startDateTime[开始处理时间] endDateTime[关闭时间]
 duration[处理时长(分钟)] progress[进度(%)]
=========>actions[操作历史]======
 actions[操作历史](2)
==========^audit[审计信息]=========
 remark[备注] businessDate[业务日期]
 createdBy[创建人] createTime[创建时间]
 updatedBy[修改人] updateTime[修改时间]
            </layout>
            <cells>
                <cell id="actions">
                    <view path="/erp/cs/pages/ErpCsTicketAction/ErpCsTicketAction.view.xml" grid="sub-grid-view"/>
                </cell>
            </cells>
        </form>
        <form id="add" size="lg" layoutControl="tabs">
            <layout x:override="replace">
=========>baseInfo[基本信息]======
 code[单号] orgId[业务组织]
 subject[工单主题] customerId[客户]
 ticketTypeId[工单类型] priority[优先级]
 source[来源] assignedToId[分配处理人]
 status[工单状态] docStatus[单据状态]
 approveStatus[审核状态] contactId[联系人]
 catalogItemId[服务目录项]
 description[问题描述](2)
=========>sla[SLA与处理]======
 slaPolicyId[SLA 策略] deadlineDateTime[SLA 截止时间]
 isSlaCompleted[SLA 是否完成] startDateTime[开始处理时间]
 endDateTime[关闭时间] duration[处理时长(分钟)]
 progress[进度(%)]
=========>actions[操作历史]======
 actions[操作历史](2)
==========^audit[审计信息]=========
 remark[备注]
 __kbSuggestion[相关知识库文章]
            </layout>
            <cells>
                <cell id="actions">
                    <view path="/erp/cs/pages/ErpCsTicketAction/ErpCsTicketAction.view.xml" grid="sub-grid-view"/>
                </cell>
                <cell id="__kbSuggestion" custom="true" notSubmit="true">
                    <gen-control>
                        <wrapper className="m-t-sm">
                            <body j:list="true">
                                <service name="kbSuggestion">
                                    <api method="post" url="/graphql" dataType="raw"
                                         sendOn="${'$'}{subject &amp;&amp; subject.length >= 2}">
                                        <data>
                                            <query><![CDATA[query($subject:String,$limit:Int){ ErpCsKnowledgeBase__suggestForTicket(subject:$subject,limit:$limit) }]]></query>
                                            <variables>
                                                <subject>${'$'}{subject}</subject>
                                                <limit>5</limit>
                                            </variables>
                                        </data>
                                        <adaptor><![CDATA[var d=payload.data||{};var g=d.data?d.data:d;var it=(g.ErpCsKnowledgeBase__suggestForTicket||[]).map(function(i){return{kbId:i.id,code:i.code,title:i.title,contentSummary:i.contentSummary};});return{status:0,msg:'',data:{items:it}};]]></adaptor>
                                    </api>
                                    <body j:list="true">
                                        <list source="${'$'}{items}" placeholder="${'$'}{subject &amp;&amp; subject.length >= 2 ? '未匹配到知识库文章，建议解决后创建新条目' : '输入工单主题后将显示相关知识库文章'}">
                                            <listItem>
                                                <body j:list="true">
                                                    <tpl tpl="&lt;strong&gt;${'$'}{title}&lt;/strong&gt;&lt;br/&gt;&lt;span class='text-muted text-sm'&gt;${'$'}{contentSummary}&lt;/span&gt;"/>
                                                </body>
                                                <actions j:list="true">
                                                    <button label="采纳并参考" i18n-en:label="Adopt &amp; Reference" level="primary" size="sm" actionType="dialog"
                                                             visibleOn="${'$'}{!!id}">
                                                        <dialog page="adoptKnowledge" size="sm"/>
                                                    </button>
                                                </actions>
                                            </listItem>
                                        </list>
                                    </body>
                                </service>
                            </body>
                        </wrapper>
                    </gen-control>
                </cell>
            </cells>
        </form>
        <form id="edit" size="lg" layoutControl="tabs">
            <layout x:override="replace">
=========>baseInfo[基本信息]======
 code[单号] orgId[业务组织]
 subject[工单主题] customerId[客户]
 ticketTypeId[工单类型] priority[优先级]
 source[来源] assignedToId[分配处理人]
 status[工单状态] docStatus[单据状态]
 approveStatus[审核状态] contactId[联系人]
 catalogItemId[服务目录项]
 description[问题描述](2)
=========>sla[SLA与处理]======
 slaPolicyId[SLA 策略] deadlineDateTime[SLA 截止时间]
 isSlaCompleted[SLA 是否完成] startDateTime[开始处理时间]
 endDateTime[关闭时间] duration[处理时长(分钟)]
 progress[进度(%)]
=========>actions[操作历史]======
 actions[操作历史](2)
==========^audit[审计信息]=========
 remark[备注]
 __kbSuggestion[相关知识库文章]
            </layout>
            <cells>
                <cell id="actions">
                    <view path="/erp/cs/pages/ErpCsTicketAction/ErpCsTicketAction.view.xml" grid="sub-grid-view"/>
                </cell>
                <cell id="__kbSuggestion" custom="true" notSubmit="true">
                    <gen-control>
                        <wrapper className="m-t-sm">
                            <body j:list="true">
                                <service name="kbSuggestion">
                                    <api method="post" url="/graphql" dataType="raw"
                                         sendOn="${'$'}{subject &amp;&amp; subject.length >= 2}">
                                        <data>
                                            <query><![CDATA[query($subject:String,$limit:Int){ ErpCsKnowledgeBase__suggestForTicket(subject:$subject,limit:$limit) }]]></query>
                                            <variables>
                                                <subject>${'$'}{subject}</subject>
                                                <limit>5</limit>
                                            </variables>
                                        </data>
                                        <adaptor><![CDATA[var d=payload.data||{};var g=d.data?d.data:d;var it=(g.ErpCsKnowledgeBase__suggestForTicket||[]).map(function(i){return{kbId:i.id,code:i.code,title:i.title,contentSummary:i.contentSummary};});return{status:0,msg:'',data:{items:it}};]]></adaptor>
                                    </api>
                                    <body j:list="true">
                                        <list source="${'$'}{items}" placeholder="${'$'}{subject &amp;&amp; subject.length >= 2 ? '未匹配到知识库文章，建议解决后创建新条目' : '输入工单主题后将显示相关知识库文章'}">
                                            <listItem>
                                                <body j:list="true">
                                                    <tpl tpl="&lt;strong&gt;${'$'}{title}&lt;/strong&gt;&lt;br/&gt;&lt;span class='text-muted text-sm'&gt;${'$'}{contentSummary}&lt;/span&gt;"/>
                                                </body>
                                                <actions j:list="true">
                                                    <button label="采纳并参考" i18n-en:label="Adopt &amp; Reference" level="primary" size="sm" actionType="dialog"
                                                             visibleOn="${'$'}{!!id}">
                                                        <dialog page="adoptKnowledge" size="sm"/>
                                                    </button>
                                                </actions>
                                            </listItem>
                                        </list>
                                    </body>
                                </service>
                            </body>
                        </wrapper>
                    </gen-control>
                </cell>
            </cells>
        </form>
        <form id="asideFilter" editMode="query" submitOnChange="true">
            <layout>
 ticketTypeId[工单类型] slaPolicyId[SLA策略]
 status[工单状态] priority[优先级]
 assignedToId[分配处理人] createTime[创建时间]
            </layout>
            <cells>
                <cell id="ticketTypeId" filterOp="eq"/>
                <cell id="slaPolicyId" filterOp="eq"/>
                <cell id="status" filterOp="in"/>
                <cell id="priority" filterOp="eq"/>
                <cell id="assignedToId" filterOp="eq"/>
                <cell id="createTime" filterOp="date-between"/>
            </cells>
        </form>
        <form id="query" editMode="query" title="查询条件" i18n-en:title="Query Condition">
            <layout>
 code[单号] customerId[客户]
            </layout>
            <cells>
                <cell id="code" filterOp="like"/>
                <cell id="customerId" filterOp="eq"/>
            </cells>
        </form>

        <!-- 质量问题升级参数表单（RC-R1.68，P1-RC-057，UC-CS-06 ①）：materialId/缺陷描述必填 +
             批次/数量/严重度可选（对齐 ErpFinBudgetScenario rollForward 参数化 dialog 范式）。 -->
        <form id="escalateQuality" editMode="add" title="质量问题升级" i18n-en:title="Quality Escalation" size="md">
            <layout>
 materialId[物料] defectDescription[缺陷描述](2)
 batchInfo[批次信息] quantity[不合格数量] severity[严重程度]
</layout>
            <cells>
                <cell id="materialId" label="物料" i18n-en:label="Material" domain="long" custom="true" mandatory="true">
                    <gen-control>
                        <input-number placeholder="必填：缺陷物料 ID"/>
                    </gen-control>
                </cell>
                <cell id="defectDescription" label="缺陷描述" i18n-en:label="Defect Description" domain="string" custom="true" mandatory="true">
                    <gen-control>
                        <textarea placeholder="必填：缺陷现象描述（将作为 NCR 问题描述）" minRows="2"/>
                    </gen-control>
                </cell>
                <cell id="batchInfo" label="批次信息" i18n-en:label="Batch Info" domain="string" custom="true">
                    <gen-control>
                        <input-text placeholder="选填：批次号"/>
                    </gen-control>
                </cell>
                <cell id="quantity" label="不合格数量" i18n-en:label="Quantity" domain="decimal" custom="true">
                    <gen-control>
                        <input-number placeholder="选填：不合格数量"/>
                    </gen-control>
                </cell>
                <cell id="severity" label="严重程度" i18n-en:label="Severity" domain="string" custom="true">
                    <gen-control>
                        <select value="NORMAL">
                            <options j:list="true">
                                <_ label="轻微" i18n-en:label="Low" value="LOW"/>
                                <_ label="一般" i18n-en:label="Normal" value="NORMAL"/>
                                <_ label="严重" i18n-en:label="High" value="HIGH"/>
                                <_ label="致命" i18n-en:label="Critical" value="CRITICAL"/>
                            </options>
                        </select>
                    </gen-control>
                </cell>
            </cells>
        </form>

        <!-- 采纳知识库参数表单（RC-R1.69，P1-RC-058，UC-CS-05 ⑦）：autoResolve 勾选 → 采纳后直接解决。 -->
        <form id="adoptKnowledge" editMode="add" title="采纳知识库文章" i18n-en:title="Adopt Knowledge" size="sm">
            <layout>
 autoResolve[采纳后直接解决]
</layout>
            <cells>
                <cell id="autoResolve" label="采纳后直接解决" i18n-en:label="Resolve after adopt" custom="true">
                    <gen-control>
                        <checkbox/>
                    </gen-control>
                </cell>
            </cells>
        </form>
    </forms>

    <pages>
        <crud name="main">
            <rowActions x:override="bounded-merge">
                <action id="row-view-button"/>
                <action id="row-update-button" actionType="drawer"/>
                <action id="row-assign-button" label="分派" i18n-en:label="Dispatch" level="primary" icon="fa fa-user">
                    <api url="@mutation:ErpCsTicket__assign?ticketId=$id&amp;assignedToId=0"/>
                    <confirmText>确认分派此工单？</confirmText>
                    <messages>
                        <success>工单已分派</success>
                    </messages>
                </action>
                <action id="row-start-button" label="开始处理" i18n-en:label="Start Processing" level="primary" icon="fa fa-play">
                    <api url="@mutation:ErpCsTicket__start?ticketId=$id"/>
                    <confirmText>确认开始处理此工单？</confirmText>
                    <messages>
                        <success>工单已开始处理</success>
                    </messages>
                </action>
                <action id="row-resolve-button" label="解决" i18n-en:label="Resolve" level="success" icon="fa fa-check">
                    <api url="@mutation:ErpCsTicket__resolve?ticketId=$id&amp;resolution="/>
                    <confirmText>确认解决此工单？</confirmText>
                    <messages>
                        <success>工单已解决</success>
                    </messages>
                </action>
                <!-- 质量问题升级（RC-R1.68，P1-RC-057，UC-CS-06 ①-④）：IN_PROCESS 可用，dialog 收集
                     materialId/缺陷描述（必填）+ 批次/数量/严重度（可选）后调 escalateToQuality 创建 NCR。 -->
                <action id="row-escalate-quality-button" label="质量问题升级" i18n-en:label="Quality Escalation"
                        level="warning" icon="fa fa-bug" actionType="dialog">
                    <dialog page="escalateQuality" size="md"/>
                    <visibleOn>${status == 'IN_PROGRESS'}</visibleOn>
                </action>
                <action id="row-close-button" label="关闭" i18n-en:label="Close" level="info" icon="fa fa-archive">
                    <api url="@mutation:ErpCsTicket__close?ticketId=$id"/>
                    <confirmText>确认关闭此工单？</confirmText>
                    <messages>
                        <success>工单已关闭</success>
                    </messages>
                </action>
                <action id="row-cancel-button" label="作废" i18n-en:label="Void" level="danger" icon="fa fa-ban">
                    <api url="@mutation:ErpCsTicket__cancel?ticketId=$id"/>
                    <confirmText>确认作废此工单？</confirmText>
                    <messages>
                        <success>工单已作废</success>
                    </messages>
                </action>
                <action id="row-view-action-button" label="操作历史" i18n-en:label="Action History" level="info" icon="fa fa-history"
                        actionType="drawer">
                    <drawer page="/erp/cs/pages/ErpCsTicketAction/ref-ticket.page.yaml" size="xl">
                        <data>
                            <ticketId>${id}</ticketId>
                        </data>
                    </drawer>
                </action>
                <!-- 履行进度查看（RC-R1.71，P1-RC-061，UC-CS-12 后置「履行流程状态可跟踪」最小接线）：
                     drawer 展示该工单物化的履行步骤执行行（sequence/actionType/status/retryCount/lastError）。 -->
                <action id="row-view-fulfillment-button" label="履行进度" i18n-en:label="Fulfillment Progress"
                        level="info" icon="fa fa-tasks" actionType="drawer">
                    <drawer page="/erp/cs/pages/ErpCsTicketFulfillmentStep/ref-ticket.page.yaml" size="xl">
                        <data>
                            <ticketId>${id}</ticketId>
                        </data>
                    </drawer>
                </action>
                <!-- 失败链手动重试（RC-R1.71，P1-RC-061，UC-CS-12 异常「支持重试，最多 3 次」）：
                     仅 FAILED 步骤重执行（刷新模板 actionConfig）；重试超限被拒绝并通知管理员人工介入。 -->
                <action id="row-retry-fulfillment-button" label="重试履行" i18n-en:label="Retry Fulfillment"
                        level="warning" icon="fa fa-repeat">
                    <api url="@mutation:ErpCsCatalogFulfillment__retryFulfillment?ticketId=$id"/>
                    <confirmText>确认重试此工单的失败履行步骤？（最多 3 次，超限须人工介入）</confirmText>
                    <messages>
                        <success>失败履行步骤已重试（进度见「履行进度」）</success>
                    </messages>
                </action>
                <action id="row-delete-button"/>
            </rowActions>
        </crud>
        <!-- 质量问题升级提交页（RC-R1.68）：materialId/defectDescription 必填经 escalateQuality 表单收集 -->
        <simple name="escalateQuality" form="escalateQuality" useFormActions="true">
            <api url="@mutation:ErpCsTicket__escalateToQuality?ticketId=$id" withFormData="true"/>
            <actions>
                <action id="cancel" label="取消" i18n-en:label="Cancel" actionType="cancel"/>
                <action id="confirm" label="确认升级" i18n-en:label="Confirm Escalation" actionType="submit" level="warning">
                    <messages>
                        <success>已升级为质量事件（NCR 创建/降级重试见操作历史）</success>
                    </messages>
                </action>
            </actions>
        </simple>
        <!-- 采纳知识库提交页（RC-R1.69，UC-CS-05 ⑦）：autoResolve 勾选经 adoptKnowledge 表单收集 -->
        <simple name="adoptKnowledge" form="adoptKnowledge" useFormActions="true">
            <api url="@mutation:ErpCsTicket__adoptKnowledge?ticketId=$id&amp;knowledgeBaseId=$kbId" withFormData="true"/>
            <actions>
                <action id="cancel" label="取消" i18n-en:label="Cancel" actionType="cancel"/>
                <action id="confirm" label="确认采纳" i18n-en:label="Confirm Adopt" actionType="submit" level="primary">
                    <messages>
                        <success>已采纳知识库文章</success>
                    </messages>
                </action>
            </actions>
        </simple>
        <picker name="picker"/>
    </pages>
</view>
