<?xml version="1.0" encoding="UTF-8" ?>
<beans x:schema="/nop/schema/beans.xdef" xmlns:x="/nop/schema/xdsl.xdef"
       xmlns="http://www.springframework.org/schema/beans" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans
        http://www.springframework.org/schema/beans/spring-beans-2.5.xsd">

    <import resource="_dao.beans.xml"/>

    <import resource="_service.beans.xml"/>

    <!-- APS 排产状态机编排 Processor（Facade + Processor 两层结构，protected step 方法供下游覆盖） -->
    <bean id="app.erp.aps.service.processor.ErpApsSchedulingProcessor"
          class="app.erp.aps.service.processor.ErpApsSchedulingProcessor"/>

    <!-- per-mutation D-mutation Processor beans (R6.7)：类别 A 每 D-mutation 独立 Processor。
         facade delete-after-extract（类保留为 helper 持有者），per-mutation 经 @Inject facade 调用共享 protected helper。 -->
    <bean id="app.erp.aps.service.processor.ErpApsSchedulingScheduleForwardProcessor"
          class="app.erp.aps.service.processor.ErpApsSchedulingScheduleForwardProcessor"/>
    <bean id="app.erp.aps.service.processor.ErpApsSchedulingScheduleBackwardProcessor"
          class="app.erp.aps.service.processor.ErpApsSchedulingScheduleBackwardProcessor"/>
    <bean id="app.erp.aps.service.processor.ErpApsSchedulingInsertRushOrderProcessor"
          class="app.erp.aps.service.processor.ErpApsSchedulingInsertRushOrderProcessor"/>

    <!-- ATP/CTP 交期承诺模拟服务（跨域 I*Biz 只读聚合 inventory + 工艺路线追溯 mfg） -->
    <bean id="app.erp.aps.service.atpctp.ErpApsAtpCtpService"
          class="app.erp.aps.service.atpctp.ErpApsAtpCtpServiceImpl"/>

    <!-- CRP 负荷来源 SPI 实现（plan 2026-07-05-0306-2）：实现 mfg-dao 声明的 IErpApsLoadSourceProvider，
          读 ErpApsOperationOrder 按 workOrderId 聚合排程时段。注册为 Bean 后由 mfg CrpLoadCalculator 经
          ioc:collect-beans by-type 跨模块收集（镜像 finance IErpFinAcctDocProvider 跨域 SPI 范式）。
          APS 模块缺失时 mfg 侧收集到空 list，CRP 回退 WorkOrder 计划日期（行为不变）。 -->
    <bean id="app.erp.aps.service.loadsource.ApsLoadSourceProvider"
          class="app.erp.aps.service.loadsource.ApsLoadSourceProvider"/>

    <!-- OperationOrder 实体级状态机 Bean（plan 2026-08-12-2142-3 M2.13）：一 Bean 对一实体一轴 status。
         严格无状态，承载命名动作迁移矩阵 + 终态分类 + 只读元数据。BizModel/Processor 按类型注入；同名 Delta
         bean id 覆盖替换基线矩阵（契约 §6）。 -->
    <bean id="app.erp.aps.service.statemachine.ErpApsOperationOrderStateMachine"
          class="app.erp.aps.service.statemachine.ErpApsOperationOrderStateMachine"/>
</beans>
