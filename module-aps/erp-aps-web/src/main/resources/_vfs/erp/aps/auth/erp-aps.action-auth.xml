<?xml version="1.0" encoding="UTF-8" ?>
<auth x:extends="_erp-aps.action-auth.xml" x:schema="/nop/schema/action-auth.xdef" xmlns:x="/nop/schema/xdsl.xdef"
      xmlns:i18n-en="i18n-en" xmlns:app="app">
    <site id="main">
        <!-- 继承生成层：恢复逐实体 FNPT 权限点入聚合链（app-001-r3）；显式移除生成层测试菜单根 -->
        <resource id="test-orm-erp-aps" x:override="remove"/>
        <resource id="erp-aps" displayName="高级排产" i18n-en:displayName="Advanced Planning &amp; Scheduling"
                  icon="cpu" resourceType="TOPM" orderNo="850"
                  routePath="/erp-aps" component="layouts/default/index">
            <children>
                <resource id="aps-schedule" displayName="排产执行" i18n-en:displayName="Scheduling"
                          icon="cpu" resourceType="SUBM" orderNo="100">
                    <children>
                        <resource id="ErpApsOperationOrder-main" app:useCases="UC-APS-01,UC-APS-02,UC-APS-03,UC-APS-04,UC-APS-05,UC-APS-06"
                                  displayName="工序工单" i18n-en:displayName="Operation Order" icon="cpu"
                                  component="FLUX" resourceType="SUBM" orderNo="100"
                                  url="/erp/aps/pages/ErpApsOperationOrder/main.page.yaml">
                                      <children>
                                          <resource id="FNPT:ErpApsOperationOrder:scheduleForward" displayName="前向排产" i18n-en:displayName="Schedule Forward"
                                                    resourceType="FNPT" orderNo="10010" roles="生产计划员">
                                              <permissions>ErpApsOperationOrder:scheduleForward</permissions>
                                          </resource>
                                          <resource id="FNPT:ErpApsOperationOrder:scheduleBackward" displayName="后向排产" i18n-en:displayName="Schedule Backward"
                                                    resourceType="FNPT" orderNo="10020" roles="生产计划员">
                                              <permissions>ErpApsOperationOrder:scheduleBackward</permissions>
                                          </resource>
                                          <resource id="FNPT:ErpApsOperationOrder:scheduleToc" displayName="TOC 鼓-缓冲排产" i18n-en:displayName="Schedule TOC"
                                                    resourceType="FNPT" orderNo="10030" roles="生产计划员">
                                              <permissions>ErpApsOperationOrder:scheduleToc</permissions>
                                          </resource>
                                          <resource id="FNPT:ErpApsOperationOrder:batchScheduleForward" displayName="批量前向排产" i18n-en:displayName="Batch Schedule Forward"
                                                    resourceType="FNPT" orderNo="10040" roles="生产计划员">
                                              <permissions>ErpApsOperationOrder:batchScheduleForward</permissions>
                                          </resource>
                                          <resource id="FNPT:ErpApsOperationOrder:insertRushOrder" displayName="插入加急单" i18n-en:displayName="Insert Rush Order"
                                                    resourceType="FNPT" orderNo="10050" roles="生产计划员">
                                              <permissions>ErpApsOperationOrder:insertRushOrder</permissions>
                                          </resource>
                                          <resource id="FNPT:ErpApsOperationOrder:createOperationOrdersFromWorkOrder" displayName="从主工单创建工序工单" i18n-en:displayName="Create From Work Order"
                                                    resourceType="FNPT" orderNo="10060" roles="生产计划员">
                                              <permissions>ErpApsOperationOrder:createOperationOrdersFromWorkOrder</permissions>
                                          </resource>
                                          <resource id="FNPT:ErpApsOperationOrder:scanReleasedWorkOrders" displayName="扫描已下达工单" i18n-en:displayName="Scan Released Work Orders"
                                                    resourceType="FNPT" orderNo="10070" roles="生产计划员">
                                              <permissions>ErpApsOperationOrder:scanReleasedWorkOrders</permissions>
                                          </resource>
                                          <resource id="FNPT:ErpApsOperationOrder:manualOverrideRouting" displayName="手工改替代工艺" i18n-en:displayName="Manual Override Routing"
                                                    resourceType="FNPT" orderNo="10080" roles="生产计划员">
                                              <permissions>ErpApsOperationOrder:manualOverrideRouting</permissions>
                                          </resource>
                                          <resource id="FNPT:ErpApsOperationOrder:scanAutoDispatch" displayName="自动派工扫描" i18n-en:displayName="Scan Auto Dispatch"
                                                    resourceType="FNPT" orderNo="10090" roles="生产计划员">
                                              <permissions>ErpApsOperationOrder:scanAutoDispatch</permissions>
                                          </resource>
                                          <resource id="FNPT:ErpApsOperationOrder:dispatchManually" displayName="手工派工" i18n-en:displayName="Dispatch Manually"
                                                    resourceType="FNPT" orderNo="10100" roles="生产计划员">
                                              <permissions>ErpApsOperationOrder:dispatchManually</permissions>
                                          </resource>
                                          <resource id="FNPT:ErpApsOperationOrder:hold" displayName="暂停工序" i18n-en:displayName="Hold Operation"
                                                    resourceType="FNPT" orderNo="10110" roles="生产计划员">
                                              <permissions>ErpApsOperationOrder:hold</permissions>
                                          </resource>
                                          <resource id="FNPT:ErpApsOperationOrder:unhold" displayName="恢复工序" i18n-en:displayName="Unhold Operation"
                                                    resourceType="FNPT" orderNo="10120" roles="生产计划员">
                                              <permissions>ErpApsOperationOrder:unhold</permissions>
                                          </resource>
                                          <resource id="FNPT:ErpApsOperationOrder:start" displayName="开工工序" i18n-en:displayName="Start Operation"
                                                    resourceType="FNPT" orderNo="10130" roles="生产计划员">
                                              <permissions>ErpApsOperationOrder:start</permissions>
                                          </resource>
                                          <resource id="FNPT:ErpApsOperationOrder:complete" displayName="完工工序" i18n-en:displayName="Complete Operation"
                                                    resourceType="FNPT" orderNo="10140" roles="生产计划员">
                                              <permissions>ErpApsOperationOrder:complete</permissions>
                                          </resource>
                                          <resource id="FNPT:ErpApsOperationOrder:cancel" displayName="取消工序工单" i18n-en:displayName="Cancel Operation Order"
                                                    resourceType="FNPT" orderNo="10150" roles="生产计划员">
                                              <permissions>ErpApsOperationOrder:cancel</permissions>
                                          </resource>
                                          <resource id="FNPT:ErpApsOperationOrder:updateSchedule" displayName="更新排程" i18n-en:displayName="Update Schedule"
                                                    resourceType="FNPT" orderNo="10160" roles="生产计划员">
                                              <permissions>ErpApsOperationOrder:updateSchedule</permissions>
                                          </resource>
                                          <resource id="FNPT:ErpApsOperationOrder:earliestCompletionDate" displayName="最早完工时间查询" i18n-en:displayName="Earliest Completion Date"
                                                    resourceType="FNPT" orderNo="10170" roles="生产计划员">
                                              <permissions>ErpApsOperationOrder:earliestCompletionDate</permissions>
                                          </resource>
                                          <resource id="FNPT:ErpApsOperationOrder:checkFeasibility" displayName="可行性校验" i18n-en:displayName="Check Feasibility"
                                                    resourceType="FNPT" orderNo="10180" roles="生产计划员">
                                              <permissions>ErpApsOperationOrder:checkFeasibility</permissions>
                                          </resource>
                                          <resource id="FNPT:ErpApsOperationOrder:findGanttData" displayName="甘特图数据查询" i18n-en:displayName="Find Gantt Data"
                                                    resourceType="FNPT" orderNo="10190" roles="生产计划员">
                                              <permissions>ErpApsOperationOrder:findGanttData</permissions>
                                          </resource>
                                      </children>
                                  </resource>
                        <resource id="ErpApsSchedule-main" app:useCases="UC-APS-02,UC-APS-03,UC-APS-04"
                                  displayName="排产方案" i18n-en:displayName="Schedule Plan" icon="calendar-check"
                                  component="FLUX" resourceType="SUBM" orderNo="110"
                                  url="/erp/aps/pages/ErpApsSchedule/main.page.yaml">
                                      <children>
                                          <resource id="FNPT:ErpApsSchedule:publish" displayName="发布排程" i18n-en:displayName="Publish Schedule"
                                                    resourceType="FNPT" orderNo="20010" roles="生产计划员">
                                              <permissions>ErpApsSchedule:publish</permissions>
                                          </resource>
                                          <resource id="FNPT:ErpApsSchedule:archive" displayName="归档排程" i18n-en:displayName="Archive Schedule"
                                                    resourceType="FNPT" orderNo="20020" roles="生产计划员">
                                              <permissions>ErpApsSchedule:archive</permissions>
                                          </resource>
                                          <resource id="FNPT:ErpApsAtpCtpService:earliestCompletionDate" displayName="ATP 最早可得时间" i18n-en:displayName="ATP Earliest Completion"
                                                    resourceType="FNPT" orderNo="20030" roles="生产计划员">
                                              <permissions>ErpApsAtpCtpService:earliestCompletionDate</permissions>
                                          </resource>
                                          <resource id="FNPT:ErpApsAtpCtpService:checkFeasibility" displayName="CTP 可行性校验" i18n-en:displayName="CTP Check Feasibility"
                                                    resourceType="FNPT" orderNo="20040" roles="生产计划员">
                                              <permissions>ErpApsAtpCtpService:checkFeasibility</permissions>
                                          </resource>
                                          <resource id="FNPT:ErpApsAtpCtpService:simulateSchedule" displayName="CTP 模拟排程" i18n-en:displayName="CTP Simulate Schedule"
                                                    resourceType="FNPT" orderNo="20050" roles="生产计划员">
                                              <permissions>ErpApsAtpCtpService:simulateSchedule</permissions>
                                          </resource>
                                      </children>
                                  </resource>
                        <resource id="aps-schedule-gantt" displayName="排产甘特图"
                                  i18n-en:displayName="Schedule Gantt" icon="calendar"
                                  component="FLUX" resourceType="SUBM" orderNo="115"
                                  url="/erp/aps/pages/dashboard/schedule-gantt.page.yaml"/>
                        <resource id="ErpApsOpRouting-main" displayName="替代工艺路线"
                                  i18n-en:displayName="Alternative Routing" icon="route"
                                  component="FLUX" resourceType="SUBM" orderNo="120"
                                  url="/erp/aps/pages/ErpApsOpRouting/main.page.yaml"/>
                    </children>
                </resource>
                <resource id="aps-dispatch" displayName="派工管理" i18n-en:displayName="Dispatch"
                          icon="play-circle" resourceType="SUBM" orderNo="150">
                    <children>
                        <resource id="ErpApsDispatchRule-main" app:useCases="UC-APS-07"
                                  displayName="自动派工规则" i18n-en:displayName="Dispatch Rule" icon="play-circle"
                                  component="FLUX" resourceType="SUBM" orderNo="150"
                                  url="/erp/aps/pages/ErpApsDispatchRule/main.page.yaml"/>
                    </children>
                </resource>
                <resource id="aps-constraint" displayName="约束管理" i18n-en:displayName="Constraints"
                          icon="alert-triangle" resourceType="SUBM" orderNo="200">
                    <children>
                        <resource id="ErpApsConstraint-main" displayName="排产约束"
                                  i18n-en:displayName="Scheduling Constraint" icon="alert-triangle"
                                  component="FLUX" resourceType="SUBM" orderNo="200"
                                  url="/erp/aps/pages/ErpApsConstraint/main.page.yaml"/>
                    </children>
                </resource>
            </children>
        </resource>
    </site>
</auth>
