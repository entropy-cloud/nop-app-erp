<!-- M2.14 Delta same-name Bean override proof (plan 2026-08-12-1841-1 Phase 3):
     Delta layer file. When nop.core.vfs.delta-layer-ids=test-drp-delta is active, this file is merged
     over the baseline app-service.beans.xml. The same bean id overrides the baseline
     ErpDrpPlanStateMachine with derived ErpDrpPlanStateMachineDelta (tightens resetToDraft source:
     COMPUTED/APPROVED to COMPUTED only). All other baseline beans (Processors, StateMachines, etc.)
     are preserved by XDsl merge. -->
<beans x:schema="/nop/schema/beans.xdef" xmlns:x="/nop/schema/xdsl.xdef"
       xmlns="http://www.springframework.org/schema/beans">

    <bean id="app.erp.drp.service.statemachine.ErpDrpPlanStateMachine"
          class="app.erp.drp.service.statemachine.ErpDrpPlanStateMachineDelta"/>
</beans>
