{
  "data": "<div id=\"xpt-report\">\n<style>\n#xpt-report .xpt-hidden{ display:none}\n#xpt-report .xpt-table{\n   border-collapse:collapse;border-spacing:0;table-layout:fixed;\n}\n#xpt-report .xpt-row{ line-height:normal;}\n#xpt-report .xpt-cell-num{ text-align:right; }\n#xpt-report .xpt-cell{\n   word-wrap:break-word;word-break:break-all;padding:2px;box-sizing:border-box;\n}\n#xpt-report .xpt-s-title{\nvertical-align:middle;\ntext-align:center;\nfont-family:\"等线\";\nfont-weight:bold;\nfont-size:14pt;\n}\n#xpt-report .xpt-s-header{\nvertical-align:middle;\ntext-align:center;\nfont-family:\"等线\";\nfont-weight:bold;\nfont-size:11pt;\nborder:1px solid black;\n}\n#xpt-report .xpt-s-cell{\nvertical-align:middle;\nfont-family:\"等线\";\nfont-size:11pt;\nborder-bottom:1px solid black;\nborder-left:1px solid black;\nborder-right:1px solid black;\n}\n#xpt-report .xpt-s-num{\nvertical-align:middle;\ntext-align:right;\nfont-family:\"等线\";\nfont-size:11pt;\nborder-bottom:1px solid black;\nborder-left:1px solid black;\nborder-right:1px solid black;\n}\n#xpt-report .xpt-s-alert{\nvertical-align:middle;\ntext-align:right;\nfont-family:\"等线\";\nfont-weight:bold;\nfont-size:11pt;\nborder-bottom:1px solid black;\nborder-left:1px solid black;\nborder-right:1px solid black;\n}\n#xpt-report .xpt-s-total{\nvertical-align:middle;\ntext-align:center;\nfont-family:\"等线\";\nfont-weight:bold;\nfont-size:11pt;\nborder:1px solid black;\n}\n</style>\n<div id=\"xpt-report-sheet-1\" data-sheet-name=\"ticket-sla-csat\">\n<table  class=\"xpt-table\">\n<colgroup><col  style=\"width:90.0pt\" /><col  style=\"width:120.0pt\" /><col  style=\"width:80.0pt\" /><col  style=\"width:90.0pt\" /><col  style=\"width:90.0pt\" /><col  style=\"width:80.0pt\" /><col  style=\"width:80.0pt\" /><col  style=\"width:80.0pt\" /></colgroup>\n<thead>\n</thead>\n<tbody>\n<tr  class=\"xpt-row\" style=\"height:24.0pt\"><td  class=\"xpt-cell xpt-s-title\" colspan=\"8\">工单 SLA/CSAT 综合统计表</td></tr>\n<tr  class=\"xpt-row\" style=\"height:18.0pt\"><td  class=\"xpt-cell xpt-s-header\">工单类型ID</td><td  class=\"xpt-cell xpt-s-header\">类型名称</td><td  class=\"xpt-cell xpt-s-header\">工单总数</td><td  class=\"xpt-cell xpt-s-header\">SLA命中数</td><td  class=\"xpt-cell xpt-s-header\">SLA超时数</td><td  class=\"xpt-cell xpt-s-header\">调查回复数</td><td  class=\"xpt-cell xpt-s-header\">CSAT均值</td><td  class=\"xpt-cell xpt-s-header\">NPS均值</td></tr>\n<tr  class=\"xpt-row\" style=\"height:16.0pt\"><td  class=\"xpt-cell xpt-s-num\">1</td><td  class=\"xpt-cell xpt-s-cell\">投诉</td><td  class=\"xpt-cell-num xpt-cell xpt-s-num\">2.00</td><td  class=\"xpt-cell-num xpt-cell xpt-s-num\">2.00</td><td  class=\"xpt-cell-num xpt-cell xpt-s-alert\">0.00</td><td  class=\"xpt-cell-num xpt-cell xpt-s-num\">1.00</td><td  class=\"xpt-cell-num xpt-cell xpt-s-num\">5.00</td><td  class=\"xpt-cell-num xpt-cell xpt-s-num\">9.00</td></tr>\n<tr  class=\"xpt-row\" style=\"height:16.0pt\"><td  class=\"xpt-cell xpt-s-num\">2</td><td  class=\"xpt-cell xpt-s-cell\">咨询</td><td  class=\"xpt-cell-num xpt-cell xpt-s-num\">1.00</td><td  class=\"xpt-cell-num xpt-cell xpt-s-num\">0.00</td><td  class=\"xpt-cell-num xpt-cell xpt-s-alert\">1.00</td><td  class=\"xpt-cell-num xpt-cell xpt-s-num\">0.00</td><td  class=\"xpt-cell xpt-s-num\"></td><td  class=\"xpt-cell xpt-s-num\"></td></tr>\n<tr  class=\"xpt-row\" style=\"height:18.0pt\"><td  class=\"xpt-cell xpt-s-total\" colspan=\"2\">合计</td><td  class=\"xpt-cell-num xpt-cell xpt-s-num\">2.00</td><td  class=\"xpt-cell-num xpt-cell xpt-s-num\">1.00</td><td  class=\"xpt-cell-num xpt-cell xpt-s-num\">1.00</td><td  class=\"xpt-cell xpt-s-cell\"></td><td  class=\"xpt-cell xpt-s-cell\"></td><td  class=\"xpt-cell\"></td></tr>\n</tbody>\n<tfoot></tfoot>\n</table>\n</div>\n</div>\n",
