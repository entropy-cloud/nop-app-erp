{
  "data": "<div id=\"xpt-report\">\n<style>\n#xpt-report .xpt-hidden{ display:none}\n#xpt-report .xpt-table{\n   border-collapse:collapse;border-spacing:0;table-layout:fixed;\n}\n#xpt-report .xpt-row{ line-height:normal;}\n#xpt-report .xpt-cell-num{ text-align:right; }\n#xpt-report .xpt-cell{\n   word-wrap:break-word;word-break:break-all;padding:2px;box-sizing:border-box;\n}\n#xpt-report .xpt-s-title{\nvertical-align:middle;\ntext-align:center;\nfont-family:\"等线\";\nfont-weight:bold;\nfont-size:14pt;\n}\n#xpt-report .xpt-s-header{\nvertical-align:middle;\ntext-align:center;\nfont-family:\"等线\";\nfont-weight:bold;\nfont-size:11pt;\nborder:1px solid black;\n}\n#xpt-report .xpt-s-cell{\nvertical-align:middle;\nfont-family:\"等线\";\nfont-size:11pt;\nborder-bottom:1px solid black;\nborder-left:1px solid black;\nborder-right:1px solid black;\n}\n#xpt-report .xpt-s-num{\nvertical-align:middle;\ntext-align:right;\nfont-family:\"等线\";\nfont-size:11pt;\nborder-bottom:1px solid black;\nborder-left:1px solid black;\nborder-right:1px solid black;\n}\n#xpt-report .xpt-s-alert{\nvertical-align:middle;\ntext-align:center;\nfont-family:\"等线\";\nfont-weight:bold;\nfont-size:11pt;\nborder-bottom:1px solid black;\nborder-left:1px solid black;\nborder-right:1px solid black;\n}\n</style>\n<div id=\"xpt-report-sheet-1\" data-sheet-name=\"crp-load\">\n<table  class=\"xpt-table\">\n<colgroup><col  style=\"width:70.0pt\" /><col  style=\"width:100.0pt\" /><col  style=\"width:80.0pt\" /><col  style=\"width:70.0pt\" /><col  style=\"width:70.0pt\" /><col  style=\"width:70.0pt\" /><col  style=\"width:60.0pt\" /><col  style=\"width:60.0pt\" /></colgroup>\n<thead>\n</thead>\n<tbody>\n<tr  class=\"xpt-row\" style=\"height:24.0pt\"><td  class=\"xpt-cell xpt-s-title\" colspan=\"8\">CRP 工作中心负荷分析表</td></tr>\n<tr  class=\"xpt-row\" style=\"height:18.0pt\"><td  class=\"xpt-cell xpt-s-header\">工作中心ID</td><td  class=\"xpt-cell xpt-s-header\">工作中心编码</td><td  class=\"xpt-cell xpt-s-header\">负荷日期</td><td  class