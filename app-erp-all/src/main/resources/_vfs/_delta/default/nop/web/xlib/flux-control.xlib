<?xml version="1.0" encoding="UTF-8" ?>
<!--
  Delta 覆盖 nop-entropy /nop/web/xlib/flux-control.xlib 的 5 个 picker tag
  （plan 2026-08-24-1147-1；flux-control.xlib 当前实现输出 AMIS 风格 picker schema，
  与 nop-chaos-flux picker-renderer.tsx:325-327 契约错位，触发 "未配置 picker 弹层" warning）

  修复机制：
  - view-gen.xlib:DefaultViewPostExtends 在 flux 模式下将 controlLib 强制重写为 flux-control.xlib
  - 本 delta 文件位于 _vfs/_delta/default/nop/web/xlib/flux-control.xlib，x:extends="super" 继承基线
  - 仅重写 edit-relation / edit-roleId / edit-userId / edit-ref-id / edit-ref-ids 的 source 输出
  - 其余 70 个 tag（edit-double / edit-text / edit-date / etc.）从 super 继承不变

输出契约（flux PickerSchema，composite-schemas.ts:168-181）：
  - type: 'picker'
  - pickerDialog: { title, size:lg }    必需，触发 dialog 打开
  - loadAction: { action:ajax, args:{url, gql:selection} }  必需，crudMode 触发嵌入 CRUD
  - columns: [...]                       嵌入 CRUD 的列定义
  - valueKey / labelKey / multiple       匹配 flux PickerSchema（picker-renderer.tsx:56-57 只读 valueKey/labelKey）

  显式不输出 AMIS 关键字：x:extends / source / joinValues / extractValue / pickerSchema
-->
<lib x:extends="super"
     x:schema="/nop/schema/xlib.xdef"
     xmlns:x="/nop/schema/xdsl.xdef"
     xmlns:c="c">

    <tags>

        <!--
            字段级 picker: 外键关系字段
            bizObjName 派生优先级（修复 null__findPage 问题，closure-audit P0-2）：
              1. relProp（已通过 XuiHelper.getRelationProp 解析的关联属性）派生最可靠
              2. propMeta['ui:queryUrl'] 显式标注
              3. XuiHelper.getRefBizObjName(propMeta) 通用派生
              4. dispMeta['ui:queryUrl'] fallback
            valueKey/labelKey 而非 valueField/labelField（修复 closure-audit P0-1，匹配 flux PickerSchema 契约）
        -->
        <edit-relation>
            <attr name="dispMeta"/>
            <attr name="propMeta"/>
            <attr name="objMeta"/>
            <attr name="editMode"/>

            <source><![CDATA[
                import io.nop.xui.utils.XuiHelper;

                const relProp = XuiHelper.getRelationProp(propMeta, objMeta);
                const bizObjName = (relProp ? XuiHelper.getRefBizObjName(relProp) : null)
                    || propMeta['ui:queryUrl']
                    || XuiHelper.getRefBizObjName(propMeta)
                    || (dispMeta && dispMeta['ui:queryUrl']);
                const valueKey = relProp ? relProp['ext:joinRightProp'] : (propMeta.name || 'id');
                const labelKey = relProp ? (relProp['ext:joinRightDisplayProp'] || relProp['ext:joinRightProp']) : 'name';
                const titleKey = '@i18n:control.picker.title|' + (relProp && relProp.displayName || labelKey || bizObjName || '选择');

                if (!bizObjName) {
                    // 退化方案: bizObjName 缺失时不输出 pickerDialog,让 picker 渲染器走 fallback
                    return _.filterNull({
                        type: 'picker',
                        pickerDialog: false,
                        valueKey: valueKey,
                        labelKey: labelKey
                    });
                }

                return _.filterNull({
                    type: 'picker',
                    pickerDialog: {
                        title: titleKey,
                        size: 'lg'
                    },
                    valueKey: valueKey,
                    labelKey: labelKey,
                    loadAction: {
                        action: 'ajax',
                        args: {
                            url: '@query:' + bizObjName + '__findPage',
                            'gql:selection': '{@pageSelection}'
                        }
                    },
                    columns: [
                        { type: 'index', name: 'index', label: '@i18n:common.index', width: 50, fixed: 'left', align: 'center', toggled: false },
                        { name: valueKey, label: valueKey, hidden: true },
                        { name: 'code', label: '@i18n:common.code' },
                        { name: 'name', label: '@i18n:common.name' },
                        ...(labelKey && labelKey !== 'name' ? [{ name: labelKey, label: labelKey }] : [])
                    ],
                    multiple: propMeta.type?.collectionLike || propMeta.listSchema
                });
            ]]></source>
        </edit-relation>

        <!--
            NopAuthRole 选择器
            硬编码 url: '@query:NopAuthRole__findPage' + roleId/roleName 列
        -->
        <edit-roleId>
            <attr name="dispMeta"/>
            <attr name="propMeta"/>
            <attr name="objMeta"/>
            <attr name="editMode"/>

            <source><![CDATA[
                return _.filterNull({
                    type: 'picker',
                    pickerDialog: {
                        title: '@i18n:control.picker.roleSelect|选择角色',
                        size: 'lg'
                    },
                    valueKey: 'roleId',
                    labelKey: 'roleName',
                    loadAction: {
                        action: 'ajax',
                        args: {
                            url: '@query:NopAuthRole__findPage',
                            'gql:selection': '{@pageSelection}'
                        }
                    },
                    columns: [
                        { type: 'index', name: 'index', label: '@i18n:common.index', width: 50, fixed: 'left', align: 'center', toggled: false },
                        { name: 'roleId', label: '@i18n:auth.role.id', hidden: true },
                        { name: 'roleName', label: '@i18n:auth.role.name' }
                    ],
                    multiple: false
                });
            ]]></source>
        </edit-roleId>

        <!--
            NopAuthUser 选择器
            硬编码 url: '@query:NopAuthUser__findPage' + userId/userName 列
        -->
        <edit-userId>
            <attr name="dispMeta"/>
            <attr name="propMeta"/>
            <attr name="objMeta"/>
            <attr name="editMode"/>

            <source><![CDATA[
                return _.filterNull({
                    type: 'picker',
                    pickerDialog: {
                        title: '@i18n:control.picker.userSelect|选择用户',
                        size: 'lg'
                    },
                    valueKey: 'userId',
                    labelKey: 'userName',
                    loadAction: {
                        action: 'ajax',
                        args: {
                            url: '@query:NopAuthUser__findPage',
                            'gql:selection': '{@pageSelection}'
                        }
                    },
                    columns: [
                        { type: 'index', name: 'index', label: '@i18n:common.index', width: 50, fixed: 'left', align: 'center', toggled: false },
                        { name: 'userId', label: '@i18n:auth.user.id', hidden: true },
                        { name: 'userName', label: '@i18n:auth.user.name' }
                    ],
                    multiple: false
                });
            ]]></source>
        </edit-userId>

        <!--
            单值 ref id 字段 (edit-ref-id)
            ui:pickerUrl 是 picker.page.yaml 路径（如 /erp/md/pages/ErpMdMaterial/picker.page.yaml），
            从路径末段提取 BizObjName 构造 findPage URL
        -->
        <edit-ref-id>
            <attr name="dispMeta"/>
            <attr name="propMeta"/>
            <attr name="objMeta"/>
            <attr name="editMode"/>

            <source><![CDATA[
                const pickerUrl = propMeta['ui:pickerUrl'] || '';
                // 从 /module/pages/BizObjName/picker.page.yaml 路径末段提取 bizObjName
                const urlMatch = pickerUrl.match(/\/pages\/([^/]+)\/picker\.page\.yaml/);
                const bizObjName = urlMatch ? urlMatch[1] : (propMeta['ui:queryUrl'] || propMeta['refBizObjName']);
                const valueKey = 'id';
                const labelKey = propMeta['ui:refLabelProp'] || 'name';

                if (!bizObjName) {
                    // 退化方案: bizObjName 缺失时不输出 pickerDialog,让 picker 渲染器走 fallback
                    return {
                        type: 'picker',
                        pickerDialog: false,
                        valueKey: valueKey,
                        labelKey: labelKey
                    };
                }

                return _.filterNull({
                    type: 'picker',
                    pickerDialog: {
                        title: '@i18n:control.picker.refSelect|选择引用',
                        size: 'lg'
                    },
                    valueKey: valueKey,
                    labelKey: labelKey,
                    loadAction: {
                        action: 'ajax',
                        args: {
                            url: '@query:' + bizObjName + '__findPage',
                            'gql:selection': '{@pageSelection}'
                        }
                    },
                    columns: [
                        { type: 'index', name: 'index', label: '@i18n:common.index', width: 50, fixed: 'left', align: 'center', toggled: false },
                        { name: valueKey, label: valueKey, hidden: true },
                        { name: 'code', label: '@i18n:common.code' },
                        { name: labelKey, label: labelKey }
                    ],
                    multiple: false
                });
            ]]></source>
        </edit-ref-id>

        <!--
            多值 ref id 字段 (edit-ref-ids)
            同 edit-ref-id 但 multiple: true
        -->
        <edit-ref-ids>
            <attr name="dispMeta"/>
            <attr name="propMeta"/>
            <attr name="objMeta"/>
            <attr name="editMode"/>

            <source><![CDATA[
                const pickerUrl = propMeta['ui:pickerUrl'] || '';
                const urlMatch = pickerUrl.match(/\/pages\/([^/]+)\/picker\.page\.yaml/);
                const bizObjName = urlMatch ? urlMatch[1] : (propMeta['ui:queryUrl'] || propMeta['refBizObjName']);
                const valueKey = 'id';
                const labelKey = propMeta['ui:refLabelProp'] || 'name';

                if (!bizObjName) {
                    return {
                        type: 'picker',
                        pickerDialog: false,
                        valueKey: valueKey,
                        labelKey: labelKey
                    };
                }

                return _.filterNull({
                    type: 'picker',
                    pickerDialog: {
                        title: '@i18n:control.picker.refSelect|选择引用',
                        size: 'lg'
                    },
                    valueKey: valueKey,
                    labelKey: labelKey,
                    loadAction: {
                        action: 'ajax',
                        args: {
                            url: '@query:' + bizObjName + '__findPage',
                            'gql:selection': '{@pageSelection}'
                        }
                    },
                    columns: [
                        { type: 'index', name: 'index', label: '@i18n:common.index', width: 50, fixed: 'left', align: 'center', toggled: false },
                        { name: valueKey, label: valueKey, hidden: true },
                        { name: 'code', label: '@i18n:common.code' },
                        { name: labelKey, label: labelKey }
                    ],
                    multiple: true
                });
            ]]></source>
        </edit-ref-ids>

    </tags>
</lib>