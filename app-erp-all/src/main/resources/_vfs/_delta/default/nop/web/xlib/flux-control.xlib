<?xml version="1.0" encoding="UTF-8" ?>
<!--
  Delta 覆盖 nop-entropy /nop/web/xlib/flux-control.xlib 的 5 个 picker tag
  （plan 2026-08-24-1147-1；flux-control.xlib 当前实现输出 AMIS 风格 picker schema，
  与 nop-chaos-flux picker-renderer.tsx:325-327 契约错位，触发 "未配置 picker 弹层" warning）

  修复机制：
  - view-gen.xlib:DefaultViewPostExtends 在 flux 模式下将 controlLib 强制重写为 flux-control.xlib
  - 本 delta 文件位于 _vfs/_delta/default/nop/web/xlib/flux-control.xlib，x:extends="super" 继承基线
  - 仅重写 edit-relation / edit-roleId / edit-userId / edit-ref-id / edit-ref-ids 的 source 输出
  - 其余 70 个 tag（edit-double / edit-text / edit-date / etc.）从 super 继承不变

v3.2 落地契约（flux PickerSchema，composite-schemas.ts:172-249，picker-transfer.md）：
  - type: 'picker'
  - pickerPopup: { type:'dialog', size:'lg', title:... }    弹出层配置
  - pickerSchema: { type:'crud', loadAction:..., columns:..., selection:... }   弹窗内容
  - valueField / labelField / multiple       匹配 flux PickerSchema v3 契约

  v3.2 移除字段（不输出）：pickerDialog / valueKey / labelKey / 顶层 loadAction / 顶层 columns
  v3.2 选择提交：pickerSchema(CRUD) 内的操作列按钮通过 {action:'pick', args:{value, rows}} 提交选择
  （picker 渲染器统一通过 PickerContext 累积，不再读 CRUD selectionStatePath）

  历史参考：plan 2026-09-02-2028-1-flux-picker-schema-override.md（v3.2 架构调整）
-->
<lib x:extends="super"
     x:schema="/nop/schema/xlib.xdef"
     xmlns:x="/nop/schema/xdsl.xdef"
     xmlns:c="c">

    <tags>

        <!--
            字段级 picker: 外键关系字段
            bizObjName 派生优先级（修复 null__findPage 问题，closure-audit P0-2）：
              1. relProp（已通过 XuiHelper.getRelationProp 解析的关联属性）派生最可靠
              2. propMeta['ui:queryUrl'] 显式标注
              3. XuiHelper.getRefBizObjName(propMeta) 通用派生
              4. dispMeta['ui:queryUrl'] fallback
            v3.2 字段命名:valueField/labelField 而非 valueKey/labelKey（plan 2026-09-02-2028-1）
        -->
        <edit-relation>
            <attr name="dispMeta"/>
            <attr name="propMeta"/>
            <attr name="objMeta"/>
            <attr name="editMode"/>

            <source><![CDATA[
                import io.nop.xui.utils.XuiHelper;

                const relProp = XuiHelper.getRelationProp(propMeta, objMeta);
                const bizObjName = (relProp ? XuiHelper.getRefBizObjName(relProp) : null)
                    || propMeta['ui:queryUrl']
                    || XuiHelper.getRefBizObjName(propMeta)
                    || (dispMeta && dispMeta['ui:queryUrl']);
                const valueField = relProp ? relProp['ext:joinRightProp'] : (propMeta.name || 'id');
                const labelField = relProp ? (relProp['ext:joinRightDisplayProp'] || relProp['ext:joinRightProp']) : 'name';
                const titleKey = '@i18n:control.picker.title|' + (relProp && relProp.displayName || labelField || bizObjName || '选择');

                if (!bizObjName) {
                    return _.filterNull({
                        type: 'picker',
                        pickerPopup: false,
                        valueField: valueField,
                        labelField: labelField
                    });
                }

                return _.filterNull({
                    type: 'picker',
                    pickerPopup: {
                        type: 'dialog',
                        title: titleKey,
                        size: 'lg'
                    },
                    valueField: valueField,
                    labelField: labelField,
                    multiple: propMeta.type?.collectionLike || propMeta.listSchema,
                    // 内容异步复用实体 picker 页面：dynamic-renderer 运行时拉取 .flux.yaml（已加载页面缓存，
                    // 二次打开无异步）；异步边界天然打破 x:extends 构建期自引用递归，selection 由页面级
                    // NormalizeApi 拼出真实值（docs/bugs/2026-09-03-picker-loadaction-selection-convert-time-misjudgment.md）。
                    pickerSchema: {
                        type: 'dynamic-renderer',
                        autoLoad: true,
                        loadAction: {
                            action: 'ajax',
                            args: { url: XuiHelper.getRelationPickerUrl(dispMeta, propMeta, objMeta) }
                        }
                    }
                });
            ]]></source>
        </edit-relation>

        <!--
            NopAuthRole 选择器
            硬编码 url: '@query:NopAuthRole__findPage' + roleId/roleName 列
        -->
        <edit-roleId>
            <attr name="dispMeta"/>
            <attr name="propMeta"/>
            <attr name="objMeta"/>
            <attr name="editMode"/>

            <source><![CDATA[
                return _.filterNull({
                    type: 'picker',
                    pickerPopup: {
                        type: 'dialog',
                        title: '@i18n:control.picker.roleSelect|选择角色',
                        size: 'lg'
                    },
                    valueField: 'roleId',
                    labelField: 'roleName',
                    multiple: false,
                    // 内容异步复用实体 picker 页面：dynamic-renderer 运行时拉取 .flux.yaml（已加载页面缓存，
                    // 二次打开无异步）；异步边界天然打破 x:extends 构建期自引用递归，selection 由页面级
                    // NormalizeApi 拼出真实值（docs/bugs/2026-09-03-picker-loadaction-selection-convert-time-misjudgment.md）。
                    pickerSchema: {
                        type: 'dynamic-renderer',
                        autoLoad: true,
                        loadAction: {
                            action: 'ajax',
                            args: { url: '/nop/auth/pages/NopAuthRole/picker.page.yaml' }
                        }
                    }
                });
            ]]></source>
        </edit-roleId>

        <!--
            NopAuthUser 选择器
            硬编码 url: '@query:NopAuthUser__findPage' + userId/userName 列
        -->
        <edit-userId>
            <attr name="dispMeta"/>
            <attr name="propMeta"/>
            <attr name="objMeta"/>
            <attr name="editMode"/>

            <source><![CDATA[
                return _.filterNull({
                    type: 'picker',
                    pickerPopup: {
                        type: 'dialog',
                        title: '@i18n:control.picker.userSelect|选择用户',
                        size: 'lg'
                    },
                    valueField: 'userId',
                    labelField: 'userName',
                    multiple: false,
                    // 内容异步复用实体 picker 页面：dynamic-renderer 运行时拉取 .flux.yaml（已加载页面缓存，
                    // 二次打开无异步）；异步边界天然打破 x:extends 构建期自引用递归，selection 由页面级
                    // NormalizeApi 拼出真实值（docs/bugs/2026-09-03-picker-loadaction-selection-convert-time-misjudgment.md）。
                    pickerSchema: {
                        type: 'dynamic-renderer',
                        autoLoad: true,
                        loadAction: {
                            action: 'ajax',
                            args: { url: '/nop/auth/pages/NopAuthUser/picker.page.yaml' }
                        }
                    }
                });
            ]]></source>
        </edit-userId>

        <!--
            单值 ref id 字段 (edit-ref-id)
            ui:pickerUrl 是 picker.page.yaml 路径（如 /erp/md/pages/ErpMdMaterial/picker.page.yaml），
            从路径末段提取 BizObjName 构造 findPage URL
        -->
        <edit-ref-id>
            <attr name="dispMeta"/>
            <attr name="propMeta"/>
            <attr name="objMeta"/>
            <attr name="editMode"/>

            <source><![CDATA[
                const pickerUrl = propMeta['ui:pickerUrl'] || '';
                const urlMatch = pickerUrl.match(/\/pages\/([^/]+)\/picker\.page\.yaml/);
                const bizObjName = urlMatch ? urlMatch[1] : (propMeta['ui:queryUrl'] || propMeta['refBizObjName']);
                const valueField = 'id';
                const labelField = propMeta['ui:refLabelProp'] || 'name';

                if (!bizObjName) {
                    return {
                        type: 'picker',
                        pickerPopup: false,
                        valueField: valueField,
                        labelField: labelField
                    };
                }

                return _.filterNull({
                    type: 'picker',
                    pickerPopup: {
                        type: 'dialog',
                        title: '@i18n:control.picker.refSelect|选择引用',
                        size: 'lg'
                    },
                    valueField: valueField,
                    labelField: labelField,
                    multiple: false,
                    // 内容异步复用实体 picker 页面：dynamic-renderer 运行时拉取 .flux.yaml（已加载页面缓存，
                    // 二次打开无异步）；异步边界天然打破 x:extends 构建期自引用递归，selection 由页面级
                    // NormalizeApi 拼出真实值（docs/bugs/2026-09-03-picker-loadaction-selection-convert-time-misjudgment.md）。
                    pickerSchema: {
                        type: 'dynamic-renderer',
                        autoLoad: true,
                        loadAction: {
                            action: 'ajax',
                            args: { url: pickerUrl }
                        }
                    }
                });
            ]]></source>
        </edit-ref-id>

        <!--
            多值 ref id 字段 (edit-ref-ids)
            同 edit-ref-id 但 multiple: true
        -->
        <edit-ref-ids>
            <attr name="dispMeta"/>
            <attr name="propMeta"/>
            <attr name="objMeta"/>
            <attr name="editMode"/>

            <source><![CDATA[
                const pickerUrl = propMeta['ui:pickerUrl'] || '';
                const urlMatch = pickerUrl.match(/\/pages\/([^/]+)\/picker\.page\.yaml/);
                const bizObjName = urlMatch ? urlMatch[1] : (propMeta['ui:queryUrl'] || propMeta['refBizObjName']);
                const valueField = 'id';
                const labelField = propMeta['ui:refLabelProp'] || 'name';

                if (!bizObjName) {
                    return {
                        type: 'picker',
                        pickerPopup: false,
                        valueField: valueField,
                        labelField: labelField
                    };
                }

                return _.filterNull({
                    type: 'picker',
                    pickerPopup: {
                        type: 'dialog',
                        title: '@i18n:control.picker.refSelect|选择引用',
                        size: 'lg'
                    },
                    valueField: valueField,
                    labelField: labelField,
                    multiple: true,
                    // 内容异步复用实体 picker 页面：dynamic-renderer 运行时拉取 .flux.yaml（已加载页面缓存，
                    // 二次打开无异步）；异步边界天然打破 x:extends 构建期自引用递归，selection 由页面级
                    // NormalizeApi 拼出真实值（docs/bugs/2026-09-03-picker-loadaction-selection-convert-time-misjudgment.md）。
                    pickerSchema: {
                        type: 'dynamic-renderer',
                        autoLoad: true,
                        loadAction: {
                            action: 'ajax',
                            args: { url: pickerUrl }
                        }
                    }
                });
            ]]></source>
        </edit-ref-ids>

    </tags>
</lib>