<!-- fixture-bundle M2.1 batch entry (nop-app-erp plan 2026-10-02-0026-1, route (a)).
     Loaded EXPLICITLY via @NopTestConfig(testBeansFile=...) — this file's name does not
     match the app*.beans.xml directory scan (a same-named pattern would become an
     implicit load entry for every test in the shared JVM). Defines the consumer-side
     processor bean wrapping the nop-autotest.bundle framework classes (which are
     deliberately not IoC beans). Test scope only. -->
<beans x:schema="/nop/schema/beans.xdef" xmlns:x="/nop/schema/xdsl.xdef">

    <bean id="fixtureBundleImportProcessor" class="io.nop.app.all.it.FixtureBundleImportBatchProcessor"/>

</beans>
