<?xml version="1.0" encoding="UTF-8" ?>
<auth x:extends="_erp-ct.action-auth.xml" x:schema="/nop/schema/action-auth.xdef" xmlns:x="/nop/schema/xdsl.xdef"
      xmlns:i18n-en="i18n-en" xmlns:app="app">
    <site id="main">
        <!-- 继承生成层：恢复逐实体 FNPT 权限点入聚合链（app-001-r3）；显式移除生成层测试菜单根 -->
        <resource id="test-orm-erp-ct" x:override="remove"/>
        <resource id="erp-ct" displayName="合同管理" i18n-en:displayName="Contract Management"
                  icon="file-text" resourceType="TOPM" orderNo="950"
                  routePath="/erp-ct" component="layouts/default/index" roles="合同专员,合同审批人">
            <children>
                <resource id="ct-contract" displayName="合同列表" i18n-en:displayName="Contracts"
                          icon="file-text" resourceType="SUBM" orderNo="100" roles="合同专员,合同审批人">
                    <children>
                        <resource id="ErpCtContract-main" app:useCases="UC-CT-01,UC-CT-02,UC-CT-05,UC-CT-06"
                                  displayName="合同" i18n-en:displayName="Contract" icon="file-text"
                                  component="FLUX" resourceType="SUBM" orderNo="100"
                                  url="/erp/ct/pages/ErpCtContract/main.page.yaml">
                            <children>
                                <resource id="FNPT:ErpCtContract:activate" displayName="激活合同(审批门控)" i18n-en:displayName="Activate Contract"
                                          resourceType="FNPT" orderNo="10010" roles="合同审批人">
                                    <permissions>ErpCtContract:activate</permissions>
                                </resource>
                                <resource id="FNPT:ErpCtContractVersion:finalizeVersion" displayName="定稿合同版本" i18n-en:displayName="Finalize Version"
                                          resourceType="FNPT" orderNo="10020" roles="合同专员">
                                    <permissions>ErpCtContractVersion:finalizeVersion</permissions>
                                </resource>
                                <resource id="FNPT:ErpCtContractVersion:signVersion" displayName="签署合同版本(签章门控)" i18n-en:displayName="Sign Version"
                                          resourceType="FNPT" orderNo="10030" roles="合同审批人">
                                    <permissions>ErpCtContractVersion:signVersion</permissions>
                                </resource>
                                <resource id="FNPT:ErpCtContract:submit" displayName="提交合同审批" i18n-en:displayName="Submit Contract"
                                          resourceType="FNPT" orderNo="10040" roles="合同专员">
                                    <permissions>ErpCtContract:submit</permissions>
                                </resource>
                                <resource id="FNPT:ErpCtContract:amend" displayName="合同变更" i18n-en:displayName="Amend Contract"
                                          resourceType="FNPT" orderNo="10050" roles="合同专员">
                                    <permissions>ErpCtContract:amend</permissions>
                                </resource>
                                <resource id="FNPT:ErpCtContract:rejectAmend" displayName="驳回合同变更" i18n-en:displayName="Reject Amend"
                                          resourceType="FNPT" orderNo="10060" roles="合同审批人">
                                    <permissions>ErpCtContract:rejectAmend</permissions>
                                </resource>
                                <resource id="FNPT:ErpCtContract:suspend" displayName="暂停合同" i18n-en:displayName="Suspend Contract"
                                          resourceType="FNPT" orderNo="10070" roles="合同专员">
                                    <permissions>ErpCtContract:suspend</permissions>
                                </resource>
                                <resource id="FNPT:ErpCtContract:resume" displayName="恢复合同" i18n-en:displayName="Resume Contract"
                                          resourceType="FNPT" orderNo="10080" roles="合同专员">
                                    <permissions>ErpCtContract:resume</permissions>
                                </resource>
                                <resource id="FNPT:ErpCtContract:expire" displayName="合同到期" i18n-en:displayName="Expire Contract"
                                          resourceType="FNPT" orderNo="10090" roles="合同专员">
                                    <permissions>ErpCtContract:expire</permissions>
                                </resource>
                                <resource id="FNPT:ErpCtContract:terminate" displayName="终止合同" i18n-en:displayName="Terminate Contract"
                                          resourceType="FNPT" orderNo="10100" roles="合同审批人">
                                    <permissions>ErpCtContract:terminate</permissions>
                                </resource>
                                <resource id="FNPT:ErpCtContract:approveTermination" displayName="审批合同终止" i18n-en:displayName="Approve Termination"
                                          resourceType="FNPT" orderNo="10110" roles="合同审批人">
                                    <permissions>ErpCtContract:approveTermination</permissions>
                                </resource>
                                <resource id="FNPT:ErpCtContract:rejectTermination" displayName="驳回合同终止" i18n-en:displayName="Reject Termination"
                                          resourceType="FNPT" orderNo="10120" roles="合同审批人">
                                    <permissions>ErpCtContract:rejectTermination</permissions>
                                </resource>
                            </children>
                        </resource>
                        <resource id="ct-version-diff" app:useCases="UC-CT-02,UC-CT-06" displayName="合同版本对比"
                                  i18n-en:displayName="Contract Version Diff" icon="git-compare"
                                  component="FLUX" resourceType="SUBM" orderNo="105"
                                  url="/erp/ct/pages/dashboard/version-diff.page.yaml"/>
                        <resource id="ErpCtContractLine-main" displayName="合同行"
                                  i18n-en:displayName="Contract Line" icon="list"
                                  component="FLUX" resourceType="SUBM" orderNo="110"
                                  url="/erp/ct/pages/ErpCtContractLine/main.page.yaml"/>
                    </children>
                </resource>
                <resource id="ct-template" displayName="合同模板" i18n-en:displayName="Templates"
                          icon="file" resourceType="SUBM" orderNo="200" roles="合同专员">
                    <children>
                        <resource id="ErpCtTemplate-main" displayName="合同模板"
                                  i18n-en:displayName="Contract Template" icon="file"
                                  component="FLUX" resourceType="SUBM" orderNo="200"
                                  url="/erp/ct/pages/ErpCtTemplate/main.page.yaml"/>
                    </children>
                </resource>
                <resource id="ct-approval" displayName="审批管理" i18n-en:displayName="Approval"
                          icon="check-square" resourceType="SUBM" orderNo="150" roles="合同审批人">
                    <children>
                        <resource id="ErpCtApprovalMatrix-main" app:useCases="UC-CT-07"
                                  displayName="审批矩阵" i18n-en:displayName="Approval Matrix" icon="check-square"
                                  component="FLUX" resourceType="SUBM" orderNo="150"
                                  url="/erp/ct/pages/ErpCtApprovalMatrix/main.page.yaml"/>
                        <resource id="ErpCtApprovalRecord-main" app:useCases="UC-CT-07"
                                  displayName="审批记录" i18n-en:displayName="Approval Record" icon="clipboard-check"
                                  component="FLUX" resourceType="SUBM" orderNo="160"
                                  url="/erp/ct/pages/ErpCtApprovalRecord/main.page.yaml"/>
                    </children>
                </resource>
                <resource id="ct-rebate" displayName="折扣与返利" i18n-en:displayName="Discount &amp; Rebate"
                          icon="percent" resourceType="SUBM" orderNo="180" roles="合同专员,合同审批人">
                    <children>
                        <resource id="ErpCtVolumeDiscount-main" app:useCases="UC-CT-08"
                                  displayName="批量折扣" i18n-en:displayName="Volume Discount" icon="percent"
                                  component="FLUX" resourceType="SUBM" orderNo="180"
                                  url="/erp/ct/pages/ErpCtVolumeDiscount/main.page.yaml"/>
                        <resource id="ErpCtRebateAgreement-main" app:useCases="UC-CT-08"
                                  displayName="返利协议" i18n-en:displayName="Rebate Agreement" icon="gift"
                                  component="FLUX" resourceType="SUBM" orderNo="190"
                                  url="/erp/ct/pages/ErpCtRebateAgreement/main.page.yaml">
                                      <children>
                                          <resource id="FNPT:ErpCtRebateAgreement:runAccrual" displayName="计提返利" i18n-en:displayName="Run Accrual"
                                                    resourceType="FNPT" orderNo="18010" roles="财务员">
                                              <permissions>ErpCtRebateAgreement:runAccrual</permissions>
                                          </resource>
                                      </children>
                                  </resource>
                        <resource id="ErpCtRebateSettlement-main" app:useCases="UC-CT-08"
                                  displayName="返利结算单" i18n-en:displayName="Rebate Settlement" icon="file-check"
                                  component="FLUX" resourceType="SUBM" orderNo="195"
                                  url="/erp/ct/pages/ErpCtRebateSettlement/main.page.yaml">
                                      <children>
                                          <resource id="FNPT:ErpCtRebateSettlement:postSettlement" displayName="过账返利结算" i18n-en:displayName="Post Settlement"
                                                    resourceType="FNPT" orderNo="18020" roles="财务员">
                                              <permissions>ErpCtRebateSettlement:postSettlement</permissions>
                                          </resource>
                                      </children>
                                  </resource>
                    </children>
                </resource>
                <resource id="ct-signature" displayName="签章管理" i18n-en:displayName="Signature Management"
                          icon="file-signature" resourceType="SUBM" orderNo="170" roles="合同专员,合同审批人">
                    <children>
                        <resource id="ErpCtSignatureRequest-main" app:useCases="UC-CT-09"
                                  displayName="签章请求" i18n-en:displayName="Signature Request" icon="file-signature"
                                  component="FLUX" resourceType="SUBM" orderNo="170"
                                  url="/erp/ct/pages/ErpCtSignatureRequest/main.page.yaml">
                            <children>
                                <resource id="FNPT:ErpCtSignatureRequest:initSignatureRequest" displayName="发起电子签(高危)" i18n-en:displayName="Init Signature Request"
                                          resourceType="FNPT" orderNo="17010" roles="合同审批人">
                                    <permissions>ErpCtSignatureRequest:initSignatureRequest</permissions>
                                </resource>
                                <resource id="FNPT:ErpCtSignatureRequest:handleSignatureCallback" displayName="处理签章回调(高危webhook)" i18n-en:displayName="Handle Signature Callback"
                                          resourceType="FNPT" orderNo="17020" roles="合同审批人">
                                    <permissions>ErpCtSignatureRequest:handleSignatureCallback</permissions>
                                </resource>
                                <resource id="FNPT:ErpCtSignatureRequest:queryAndUpdateStatus" displayName="轮询签章状态" i18n-en:displayName="Query And Update Status"
                                          resourceType="FNPT" orderNo="17030" roles="合同专员">
                                    <permissions>ErpCtSignatureRequest:queryAndUpdateStatus</permissions>
                                </resource>
                                <resource id="FNPT:ErpCtSignatureRequest:cancelSignatureRequest" displayName="取消签章请求" i18n-en:displayName="Cancel Signature Request"
                                          resourceType="FNPT" orderNo="17040" roles="合同审批人">
                                    <permissions>ErpCtSignatureRequest:cancelSignatureRequest</permissions>
                                </resource>
                                <resource id="FNPT:ErpCtSignatureRequest:rejectSignature" displayName="拒绝签章" i18n-en:displayName="Reject Signature"
                                          resourceType="FNPT" orderNo="17050" roles="合同审批人">
                                    <permissions>ErpCtSignatureRequest:rejectSignature</permissions>
                                </resource>
                            </children>
                        </resource>
                    </children>
                </resource>
                <resource id="ct-repository" displayName="仓库搜索" i18n-en:displayName="Repository &amp; Search"
                          icon="archive" resourceType="SUBM" orderNo="175" roles="合同专员,合同审批人">
                    <children>
                        <resource id="ErpCtDocument-main" app:useCases="UC-CT-10"
                                  displayName="合同文档" i18n-en:displayName="Contract Document" icon="archive"
                                  component="FLUX" resourceType="SUBM" orderNo="175"
                                  url="/erp/ct/pages/ErpCtDocument/main.page.yaml"/>
                    </children>
                </resource>
                <resource id="ct-billing" displayName="开票与消耗" i18n-en:displayName="Billing &amp; Consumption"
                          icon="credit-card" resourceType="SUBM" orderNo="300" roles="合同专员,合同审批人">
                    <children>
                        <resource id="ErpCtInvoicePlan-main" app:useCases="UC-CT-03"
                                  displayName="开票计划" i18n-en:displayName="Invoice Plan" icon="calendar"
                                  component="FLUX" resourceType="SUBM" orderNo="300"
                                  url="/erp/ct/pages/ErpCtInvoicePlan/main.page.yaml">
                                      <children>
                                          <resource id="FNPT:ErpCtInvoicePlan:triggerInvoice" displayName="触发开票" i18n-en:displayName="Trigger Invoice"
                                                    resourceType="FNPT" orderNo="30010" roles="财务员">
                                              <permissions>ErpCtInvoicePlan:triggerInvoice</permissions>
                                          </resource>
                                      </children>
                                  </resource>
                        <resource id="ErpCtConsumptionLine-main" app:useCases="UC-CT-04"
                                  displayName="消耗记录" i18n-en:displayName="Consumption Log" icon="bar-chart"
                                  component="FLUX" resourceType="SUBM" orderNo="310"
                                  url="/erp/ct/pages/ErpCtConsumptionLine/main.page.yaml"/>
                    </children>
                </resource>
            </children>
        </resource>
    </site>
</auth>
