<?xml version="1.0" encoding="UTF-8" ?>
<view xmlns:i18n-en="i18n-en" x:extends="_gen/_ErpCtVolumeDiscount.view.xml" x:schema="/nop/schema/xui/xview.xdef"
      xmlns:x="/nop/schema/xdsl.xdef">
    <controlLib>/erp/xlib/control.xlib</controlLib>

    <grids>
                <grid id="list">
            <cols x:override="bounded-merge">
                <col id="id" mandatory="true" ui:number="true" sortable="true"/>
                <col id="contractLineId" label="合同行" i18n-en:label="Contract Line"/>
                <col id="orgId" label="业务组织" i18n-en:label="Business Org"/>
                <col id="fromQty" mandatory="true" ui:number="true" sortable="true" align="right" domain="quantity"></col>
                <col id="toQty" ui:number="true" sortable="true" align="right" domain="quantity"></col>
                <col id="discountPercent" mandatory="true" ui:number="true" sortable="true"/>
                <col id="unitPrice" ui:number="true" sortable="true" align="right" domain="unitPrice"></col>
                <col id="remark" sortable="true"/>
                <col id="delVersion" mandatory="true" ui:number="true" sortable="true"/>
                <col id="createdBy" mandatory="true" sortable="true"/>
                <col id="createTime" mandatory="true" sortable="true" align="center"></col>
                <col id="updatedBy" mandatory="true" sortable="true"/>
                <col id="updateTime" mandatory="true" sortable="true" align="center"></col>
            </cols>
        </grid>
        <grid id="pick-list"/>
    </grids>

    <forms>
        <form id="view" size="lg">
            <layout x:override="replace">
=========>baseInfo[基本信息]======
 contractLineId[合同行] orgId[业务组织]
=========>range[数量范围]======
 fromQty[起始数量] toQty[截止数量]
=========>discount[折扣信息]======
 discountPercent[折扣百分比] unitPrice[覆盖单价]
========^audit[审计信息]=========
 remark[备注]
 createdBy[创建人] createTime[创建时间]
 updatedBy[修改人] updateTime[修改时间]
            </layout>
        </form>
        <form id="edit" size="lg">
            <layout x:override="replace">
=========>baseInfo[基本信息]======
 contractLineId[合同行] orgId[业务组织]
=========>range[数量范围]======
 fromQty[起始数量] toQty[截止数量]
=========>discount[折扣信息]======
 discountPercent[折扣百分比] unitPrice[覆盖单价]
========^audit[审计信息]=========
 remark[备注](2)
 createdBy[创建人] createTime[创建时间]
 updatedBy[修改人] updateTime[修改时间]
            </layout>
        </form>
        <form id="add" x:prototype="edit"/>
        <form id="query" editMode="query" title="查询条件" i18n-en:title="Query Condition">
            <layout>
 contractLineId[合同行] orgId[业务组织]
            </layout>
            <cells>
                <cell id="contractLineId" filterOp="eq"/>
                <cell id="orgId" filterOp="eq"/>
            </cells>
        </form>
    </forms>

    <pages>
        <crud name="main"/>
        <picker name="picker"/>
    </pages>
</view>