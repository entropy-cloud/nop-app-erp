<?xml version="1.0" encoding="UTF-8" ?>
<beans x:schema="/nop/schema/beans.xdef" xmlns:x="/nop/schema/xdsl.xdef"
       xmlns="http://www.springframework.org/schema/beans" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xmlns:ioc="ioc"
       xsi:schemaLocation="http://www.springframework.org/schema/beans
        http://www.springframework.org/schema/beans/spring-beans-2.5.xsd">

    <import resource="_dao.beans.xml"/>

    <import resource="_service.beans.xml"/>

    <!-- 合同域服务（非 BizModel）：返利计提引擎（PERIOD_END/PROGRESSIVE 两法 + 跨档追溯补差） -->
    <bean id="app.erp.ct.service.rebate.RebateEngine"
          class="app.erp.ct.service.rebate.RebateEngine"/>

    <!-- RC-R1.34（P1-RC-077，UC-CT-07）：审批工作流引擎——金额匹配矩阵节点 + 记录生成 +
         链状态推导（D2 角色→用户解析 / D3 派生计数 / D7 追加行语义），mutation 入口归
         ErpCtApprovalRecordBizModel（approve/reject/resubmit）与 ErpCtContractBizModel
         （terminate 法务门控 D1 选项 B）。 -->
    <bean id="app.erp.ct.service.approval.ErpCtApprovalWorkflowEngine"
          class="app.erp.ct.service.approval.ErpCtApprovalWorkflowEngine"/>

    <!-- RC-R1.34（P1-RC-077 ④）：72h 审批超时升级 job（R1.4 简单 job bean 范式，cron 空值跳过） -->
    <bean id="erpCtApprovalTimeoutEscalationJob"
          class="app.erp.ct.service.job.ErpCtApprovalTimeoutEscalationJob"/>

    <!-- 电子签章三层 SPI（plan 2026-07-04-2200-2，design e-signature.md §SPI 接口）：Registry 镜像
         logistics ErpLogCarrierGatewayRegistry / finance ErpFinAcctDocRegistry 的 List 注入 + 内部建图范式；
         MockSignatureProvider（providerCode="MOCK"）注册为 Bean。真实三方供应商（e签宝/DocuSign/Tsign）
         HTTP 集成归 follow-up（Non-Goal）。 -->
    <bean id="app.erp.ct.service.spi.ErpCtSignatureProviderRegistry"
          class="app.erp.ct.service.spi.ErpCtSignatureProviderRegistry">
        <property name="providers">
            <ioc:collect-beans by-type="app.erp.ct.service.spi.IErpCtSignatureProvider"
                               only-concrete-classes="true" ioc:ignore-depends="true"/>
        </property>
    </bean>

    <bean id="app.erp.ct.service.spi.mock.MockSignatureProvider"
          class="app.erp.ct.service.spi.mock.MockSignatureProvider"/>


    <!-- 实体级 StateMachine Bean（契约 docs/architecture/entity-state-machine-bean.md §5）：一 Bean 对一实体一轴。
         ErpCtContractStateMachine 承载合同头 status 轴已实现迁移矩阵（activate/suspend/resume/terminate/expire/amend）。
         下游可经 Delta beans.xml 同名 bean id 覆盖基线矩阵（契约 §6）。 -->
    <bean id="app.erp.ct.service.statemachine.ErpCtContractStateMachine"
          class="app.erp.ct.service.statemachine.ErpCtContractStateMachine"/>
    <!-- 合同版本 status 轴 Bean（M3.18，plan 2026-08-13-1430-3）：2 边 finalize/sign + 终态 SIGNED + transitions 元数据。
         下游可经 Delta beans.xml 同名 bean id 覆盖基线矩阵（契约 §6）。 -->
    <bean id="app.erp.ct.service.statemachine.ErpCtContractVersionStateMachine"
          class="app.erp.ct.service.statemachine.ErpCtContractVersionStateMachine"/>
    <!-- 返利协议 status 轴 Bean（M3.19，plan 2026-08-13-1430-3）：退化分类 Bean（transitions 空 + 3 死状态预留登记）
         + 集中化 ACTIVE accrual 只读守卫委托。下游可经 Delta beans.xml 同名 bean id 覆盖（契约 §6）。 -->
    <bean id="app.erp.ct.service.statemachine.ErpCtRebateAgreementStateMachine"
          class="app.erp.ct.service.statemachine.ErpCtRebateAgreementStateMachine"/>
    <!-- 返利结算单 settlement-status 轴 Bean（M4.65，plan 2026-08-14-2000-1）：1 实现边 postSettlement(DRAFT→POSTED)
         + CANCELLED intentional reserved 死状态裁定 + posted 不对称 watch-only residual 登记（不入轴）。
         下游可经 Delta beans.xml 同名 bean id 覆盖（契约 §6）。 -->
    <bean id="app.erp.ct.service.statemachine.ErpCtRebateSettlementStateMachine"
          class="app.erp.ct.service.statemachine.ErpCtRebateSettlementStateMachine"/>

    <!-- per-mutation Cat-B D-mutation Processor beans (R6.7)：类别 B 内联 mutation 每 mutation 独立 Processor。
         自包含 body（VERBATIM 迁移 + CrudBizModel 管道方法替换为 raw dao 等价）；下游可经 Delta beans.xml 同名 bean id 覆盖。 -->
    <bean id="app.erp.ct.service.processor.ErpCtContractActivateProcessor"
          class="app.erp.ct.service.processor.ErpCtContractActivateProcessor"/>
    <bean id="app.erp.ct.service.processor.ErpCtContractAmendProcessor"
          class="app.erp.ct.service.processor.ErpCtContractAmendProcessor"/>
    <bean id="app.erp.ct.service.processor.ErpCtContractVersionSignVersionProcessor"
          class="app.erp.ct.service.processor.ErpCtContractVersionSignVersionProcessor"/>
    <bean id="app.erp.ct.service.processor.ErpCtInvoicePlanTriggerInvoiceProcessor"
          class="app.erp.ct.service.processor.ErpCtInvoicePlanTriggerInvoiceProcessor"/>
    <bean id="app.erp.ct.service.processor.ErpCtInvoicePlanTriggerDuePlansProcessor"
          class="app.erp.ct.service.processor.ErpCtInvoicePlanTriggerDuePlansProcessor"/>
    <!-- RC-R1.33（P1-RC-074）：按生成项批量生成 InvoicePlan（合同 ACTIVE 守卫 + 行归属 + 幂等查重） -->
    <bean id="app.erp.ct.service.processor.ErpCtInvoicePlanGenerateByTermProcessor"
          class="app.erp.ct.service.processor.ErpCtInvoicePlanGenerateByTermProcessor"/>
    <!-- RC-R1.33（P1-RC-075）：消耗计费周期汇总 + 超量 InvoicePlan + 120% 通知 -->
    <bean id="app.erp.ct.service.processor.ErpCtConsumptionPeriodSummarizeProcessor"
          class="app.erp.ct.service.processor.ErpCtConsumptionPeriodSummarizeProcessor"/>
    <bean id="app.erp.ct.service.processor.ErpCtRebateAgreementRunAccrualProcessor"
          class="app.erp.ct.service.processor.ErpCtRebateAgreementRunAccrualProcessor"/>
    <bean id="app.erp.ct.service.processor.ErpCtRebateSettlementPostSettlementProcessor"
          class="app.erp.ct.service.processor.ErpCtRebateSettlementPostSettlementProcessor"/>
    <!-- SignatureRequest 3 D-mutation 共享状态机核心，集中 AbstractErpCtSignatureRequestProcessor 基类 -->
    <bean id="app.erp.ct.service.processor.ErpCtSignatureRequestInitSignatureRequestProcessor"
          class="app.erp.ct.service.processor.ErpCtSignatureRequestInitSignatureRequestProcessor"/>
    <bean id="app.erp.ct.service.processor.ErpCtSignatureRequestHandleSignatureCallbackProcessor"
          class="app.erp.ct.service.processor.ErpCtSignatureRequestHandleSignatureCallbackProcessor"/>
    <bean id="app.erp.ct.service.processor.ErpCtSignatureRequestQueryAndUpdateStatusProcessor"
          class="app.erp.ct.service.processor.ErpCtSignatureRequestQueryAndUpdateStatusProcessor"/>
</beans>