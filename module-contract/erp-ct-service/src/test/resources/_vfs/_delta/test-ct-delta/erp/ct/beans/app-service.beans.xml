<?xml version="1.0" encoding="UTF-8" ?>
<!-- M2.18 Delta same-name Bean override proof (plan 2026-08-12-1118-1 Phase 3):
     Delta layer file. When nop.core.vfs.delta-layer-Ids=test-ct-delta is active, this file is merged
     over the baseline app-service.beans.xml. The same bean id overrides the baseline
     ErpCtContractStateMachine with derived ErpCtContractStateMachineDelta (tightens terminate source:
     ACTIVE+NEGOTIATION to ACTIVE-only). All other baseline beans (Processors, RebateEngine, signature
     SPI, etc.) are preserved by XDsl merge. -->
<beans x:schema="/nop/schema/beans.xdef" xmlns:x="/nop/schema/xdsl.xdef"
       xmlns="http://www.springframework.org/schema/beans">

    <bean id="app.erp.ct.service.statemachine.ErpCtContractStateMachine"
          class="app.erp.ct.service.statemachine.ErpCtContractStateMachineDelta"/>
</beans>
