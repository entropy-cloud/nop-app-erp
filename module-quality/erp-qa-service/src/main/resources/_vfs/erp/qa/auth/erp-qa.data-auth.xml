<!-- 角色侧行级数据权限规则（plan 2026-07-31-1023-3-r3-4，P1-MA6-002；E2.2 employee-id 域列扩展 plan 2026-08-11-0915-1）。
     owner doc docs/design/roles-and-permissions.md §数据权限："质检员只能看分配给自己的质检任务"。

     过滤列分两类（按列域分类，见 owner doc §数据权限）：
     1. userId 域列（VARCHAR，直接与 userContext.userId 比较）：
        - ErpQaRiskRegister.ownerId（VARCHAR(36)，stdDomain="userId"，责任人）
     2. employee-id 域列（BIGINT，ref ErpMdEmployee.id，须 user.id==employee.id 种子对齐后直比，见 E2.2）：
        - ErpQaInspection.inspectorId（orm:187，检验员(职员)）
        - ErpQaSpcSample.inspectorId（orm:832，检验员）

     EL 用 ${userContext.userId}（DefaultDataAuthChecker.newEvalScope 注入的 scope 变量 = IUserContext）；
     注意 ${$context.user.userId} 无效（$context→IContext 无 getUser()）。

     E2.2 默认等效方案：employee-id 域列经专用测试账号 user.id==employee.id 种子对齐后，
     规则 eq(inspectorId, ${userContext.userId}) 整数直比成立（不触 ORM，ErpMdEmployee.userId 扩展为 successor）。

     role-auth 顺序语义（对齐平台 nop-auth.data-auth.xml 范式，详见 erp-sal.data-auth.xml 注释）：
     同 priority（默认 100）按【声明顺序】首匹配——管理员首位无 filter → 质检员次位带 filter → user 末位兜底。

     灰度：erp.data-auth.role-row-filter-enabled 默认 false（ErpRoleDataAuthChecker getFilter→null），
     且 nop.auth.enable-data-auth 默认 false——双层默认关闭，单组织基线零回归。 -->
<data-auth x:schema="/nop/schema/data-auth.xdef" xmlns:x="/nop/schema/xdsl.xdef">

    <objs>
        <obj name="ErpQaRiskRegister">
            <role-auths>
                <role-auth id="admin" roleIds="管理员"></role-auth>
                <role-auth id="inspector" roleIds="质检员">
                    <filter><eq name="ownerId" value="${userContext.userId}"/></filter>
                </role-auth>
                <role-auth id="default" roleIds="user"></role-auth>
            </role-auths>
        </obj>
        <!-- E2.2 employee-id 域列：质检员仅见分配给自己的检验单（inspectorId == userId，经种子对齐） -->
        <obj name="ErpQaInspection">
            <role-auths>
                <role-auth id="admin" roleIds="管理员"></role-auth>
                <role-auth id="inspector" roleIds="质检员">
                    <filter><eq name="inspectorId" value="${userContext.userId}"/></filter>
                </role-auth>
                <role-auth id="default" roleIds="user"></role-auth>
            </role-auths>
        </obj>
        <!-- E2.2 employee-id 域列：质检员仅见自己采集的 SPC 样本（inspectorId == userId，经种子对齐） -->
        <obj name="ErpQaSpcSample">
            <role-auths>
                <role-auth id="admin" roleIds="管理员"></role-auth>
                <role-auth id="inspector" roleIds="质检员">
                    <filter><eq name="inspectorId" value="${userContext.userId}"/></filter>
                </role-auth>
                <role-auth id="default" roleIds="user"></role-auth>
            </role-auths>
        </obj>
    </objs>
</data-auth>
