<?xml version="1.0" encoding="UTF-8" ?>
<beans x:schema="/nop/schema/beans.xdef" xmlns:x="/nop/schema/xdsl.xdef"
       xmlns="http://www.springframework.org/schema/beans" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans
        http://www.springframework.org/schema/beans/spring-beans-2.5.xsd">

    <import resource="_dao.beans.xml"/>

    <import resource="_service.beans.xml"/>

    <!-- NCR 生命周期服务（plan 2026-07-02-2237-3 Phase 3）：REJECTED 自动生成 NCR + resolve 门控校验 -->
    <bean id="app.erp.qa.service.entity.NcrLifecycleService"
          class="app.erp.qa.service.entity.NcrLifecycleService"/>

    <!-- 召回目标定位器（plan 2026-07-03-1707-3 Phase 2）：经库存批次追溯 batchTrace 反查受影响销售出库 → ErpQaRecallTarget -->
    <bean id="app.erp.qa.service.entity.RecallTargetLocator"
          class="app.erp.qa.service.entity.RecallTargetLocator"/>

    <!-- 召回事件审批状态机 Processor -->
    <bean id="app.erp.qa.service.processor.ErpQaRecallProcessor"
          class="app.erp.qa.service.processor.ErpQaRecallProcessor"/>

    <!-- NCR 财务过账（plan 2026-07-05-2352-2）：报废损失凭证 Provider + 派发器 + 执行器 -->
    <bean id="app.erp.qa.service.posting.NcrScrapAcctDocProvider"
          class="app.erp.qa.service.posting.NcrScrapAcctDocProvider"/>

    <bean id="app.erp.qa.service.posting.NcrPostingDispatcher"
          class="app.erp.qa.service.posting.NcrPostingDispatcher"/>

    <bean id="app.erp.qa.service.posting.NcrPostingExecutor"
          class="app.erp.qa.service.posting.NcrPostingExecutor"/>

    <!-- NCR→RETURN 处置退货编排器（plan 2026-07-05-2352-2 Phase 3） -->
    <bean id="app.erp.qa.service.posting.NcrReturnOrchestrator"
          class="app.erp.qa.service.posting.NcrReturnOrchestrator"/>
    <!-- 实体级状态机 Bean（契约 docs/architecture/entity-state-machine-bean.md；plan 2026-08-14-0930-2 M4.58-62） -->
    <bean id="app.erp.qa.service.statemachine.ErpQaInspectionResultStateMachine"
          class="app.erp.qa.service.statemachine.ErpQaInspectionResultStateMachine"/>
    <bean id="app.erp.qa.service.statemachine.ErpQaInspectionApprovalStateMachine"
          class="app.erp.qa.service.statemachine.ErpQaInspectionApprovalStateMachine"/>
    <bean id="app.erp.qa.service.statemachine.ErpQaNonConformanceStateMachine"
          class="app.erp.qa.service.statemachine.ErpQaNonConformanceStateMachine"/>
    <bean id="app.erp.qa.service.statemachine.ErpQaRecallStateMachine"
          class="app.erp.qa.service.statemachine.ErpQaRecallStateMachine"/>
    <bean id="app.erp.qa.service.statemachine.ErpQaRecallApprovalStateMachine"
          class="app.erp.qa.service.statemachine.ErpQaRecallApprovalStateMachine"/>

    <!-- 质量看板聚合入口（plan 2026-07-06-1606-1）：非实体 BizModel，注入 IDaoProvider/IOrmTemplate，
          经 @BizQuery 暴露 getDashboardKpi/getDashboardTrend/findDefectTopN/findCapaOverdueAlert。 -->
    <bean id="app.erp.qa.service.dashboard.ErpQaDashboardBizModel" ioc:type="@bean:id"/>

    <!-- 质量域报表渲染入口（plan 2026-07-06-1815-1）：非实体 BizModel，注入平台 IReportEngine，
          经 @BizQuery 暴露 renderHtml/download。镜像 finance ErpFinReportBizModel（域隔离 /qa/）。 -->
    <bean id="app.erp.qa.service.report.ErpQaReportBizModel" ioc:type="@bean:id"/>

    <!-- SPC 统计过程控制（plan 2026-07-07-0305-2）：采样引擎 + 控制限计算 + 规则引擎 + 能力分析 + 定时 Job -->
    <bean id="app.erp.qa.service.spc.SpcSamplingService"
          class="app.erp.qa.service.spc.SpcSamplingService"/>

    <bean id="app.erp.qa.service.spc.SpcControlLimitCalculator"
          class="app.erp.qa.service.spc.SpcControlLimitCalculator"/>

    <bean id="app.erp.qa.service.spc.SpcRuleEngine"
          class="app.erp.qa.service.spc.SpcRuleEngine"/>

    <bean id="app.erp.qa.service.spc.SpcOutOfControlHandler"
          class="app.erp.qa.service.spc.SpcOutOfControlHandler"/>

    <bean id="app.erp.qa.service.spc.SpcCapabilityCalculator"
          class="app.erp.qa.service.spc.SpcCapabilityCalculator"/>


    <!-- per-mutation Processor beans (plan 2026-07-25-1057-2) -->
    <bean id="app.erp.qa.service.processor.ErpQaRecallSubmitForApprovalProcessor"
          class="app.erp.qa.service.processor.ErpQaRecallSubmitForApprovalProcessor"/>
    <bean id="app.erp.qa.service.processor.ErpQaRecallApproveProcessor"
          class="app.erp.qa.service.processor.ErpQaRecallApproveProcessor"/>
    <bean id="app.erp.qa.service.processor.ErpQaRecallRejectProcessor"
          class="app.erp.qa.service.processor.ErpQaRecallRejectProcessor"/>
    <bean id="app.erp.qa.service.processor.ErpQaRecallReverseApproveProcessor"
          class="app.erp.qa.service.processor.ErpQaRecallReverseApproveProcessor"/>
    <bean id="app.erp.qa.service.processor.ErpQaRecallWithdrawApprovalProcessor"
          class="app.erp.qa.service.processor.ErpQaRecallWithdrawApprovalProcessor"/>

    <!-- per-mutation Processor beans (R6.6 quality domain, processor-extension-pattern.md 每 mutation 一 Processor) -->
    <bean id="app.erp.qa.service.processor.ErpQaInspectionRecordResultProcessor"
          class="app.erp.qa.service.processor.ErpQaInspectionRecordResultProcessor"/>
    <bean id="app.erp.qa.service.processor.ErpQaInspectionCreateForBusinessBillProcessor"
          class="app.erp.qa.service.processor.ErpQaInspectionCreateForBusinessBillProcessor"/>
    <bean id="app.erp.qa.service.processor.ErpQaInspectionPassInspectionProcessor"
          class="app.erp.qa.service.processor.ErpQaInspectionPassInspectionProcessor"/>
    <bean id="app.erp.qa.service.processor.ErpQaInspectionFailInspectionProcessor"
          class="app.erp.qa.service.processor.ErpQaInspectionFailInspectionProcessor"/>
    <bean id="app.erp.qa.service.processor.ErpQaInspectionBatchPassInspectionProcessor"
          class="app.erp.qa.service.processor.ErpQaInspectionBatchPassInspectionProcessor"/>

    <bean id="app.erp.qa.service.processor.ErpQaNonConformancePostNcrProcessor"
          class="app.erp.qa.service.processor.ErpQaNonConformancePostNcrProcessor"/>
    <bean id="app.erp.qa.service.processor.ErpQaNonConformanceResolveProcessor"
          class="app.erp.qa.service.processor.ErpQaNonConformanceResolveProcessor"/>
    <bean id="app.erp.qa.service.processor.ErpQaNonConformanceReverseNcrProcessor"
          class="app.erp.qa.service.processor.ErpQaNonConformanceReverseNcrProcessor"/>
    <bean id="app.erp.qa.service.processor.ErpQaNonConformanceUpgradeToRecallProcessor"
          class="app.erp.qa.service.processor.ErpQaNonConformanceUpgradeToRecallProcessor"/>

    <bean id="app.erp.qa.service.processor.ErpQaRecallCloseProcessor"
          class="app.erp.qa.service.processor.ErpQaRecallCloseProcessor"/>
    <bean id="app.erp.qa.service.processor.ErpQaRecallGenerateReturnsProcessor"
          class="app.erp.qa.service.processor.ErpQaRecallGenerateReturnsProcessor"/>
    <bean id="app.erp.qa.service.processor.ErpQaRecallLocateTargetsProcessor"
          class="app.erp.qa.service.processor.ErpQaRecallLocateTargetsProcessor"/>
    <bean id="app.erp.qa.service.processor.ErpQaRecallNotifyCustomersProcessor"
          class="app.erp.qa.service.processor.ErpQaRecallNotifyCustomersProcessor"/>
    <bean id="app.erp.qa.service.processor.ErpQaRecallRegisterProcessor"
          class="app.erp.qa.service.processor.ErpQaRecallRegisterProcessor"/>

    <bean id="app.erp.qa.service.processor.ErpQaSpcCapabilityCalculateCapabilityProcessor"
          class="app.erp.qa.service.processor.ErpQaSpcCapabilityCalculateCapabilityProcessor"/>

    <bean id="app.erp.qa.service.processor.ErpQaSpcChartCollectSamplesProcessor"
          class="app.erp.qa.service.processor.ErpQaSpcChartCollectSamplesProcessor"/>
    <bean id="app.erp.qa.service.processor.ErpQaSpcChartEvaluateRulesProcessor"
          class="app.erp.qa.service.processor.ErpQaSpcChartEvaluateRulesProcessor"/>
    <bean id="app.erp.qa.service.processor.ErpQaSpcChartRecalculateControlLimitProcessor"
          class="app.erp.qa.service.processor.ErpQaSpcChartRecalculateControlLimitProcessor"/>
</beans>