<?xml version="1.0" encoding="UTF-8" ?>
<view xmlns:i18n-en="i18n-en" x:extends="_gen/_ErpQaNonConformance.view.xml" x:schema="/nop/schema/xui/xview.xdef"
      xmlns:x="/nop/schema/xdsl.xdef">
    <controlLib>/erp/xlib/control.xlib</controlLib>

    <grids>
        <grid id="list">
            <cols x:override="bounded-merge">
                <col id="id" mandatory="true" ui:number="true" sortable="true"/>
                <col id="code" mandatory="true" sortable="true"/>
                <col id="ncrDate" mandatory="true" sortable="true" align="center"></col>
                <col id="sourceType" sortable="true"/>
                <col id="sourceCode" sortable="true"/>
                <col id="materialId" label="物料" i18n-en:label="Material"/>
                <col id="inspection" label="质检单" i18n-en:label="QC Order"/>
                <col id="quantity" ui:number="true" sortable="true" align="right" domain="quantity"></col>
                <col id="severity" mandatory="true" sortable="true"/>
                <col id="dispositionType" sortable="true"/>
                <col id="status" mandatory="true" sortable="true">
                    <gen-control>
                        <c:script><![CDATA[
                            const valueProp = dispMeta?.id || 'status';
                            const labelProp = propMeta?.['graphql:labelProp'] || (valueProp + '_label');
                            const successVals = ['COMPLETED','APPROVED','RECEIVED','DELIVERED','PAID','SETTLED','HONORED','RETRIED','EXECUTED','COMPUTED','CONFIRMED','RUNNING','MATERIAL_TRANSFERRED','ACTIVE','CLOSED','DONE','SUCCESS'];
                            const dangerVals = ['REJECTED','CANCELLED','FAILED','DISHONORED','OVERDUE','DOWN','TERMINATED','WRITE_OFF'];
                            const warningVals = ['ON_HOLD','SUSPENDED','EXPIRED','RETRYING'];
                            const primaryVals = ['SUBMITTED','IN_PROGRESS','PARTIAL','PARTIALLY_TRANSFERRED','WORK_IN_PROGRESS','PROCESSING','NEGOTIATION','OPEN','UNDER_MAINTENANCE','COLLECTION_PENDING','DISCOUNTED','ENDORSED','ISSUED'];
                            function quote(v){return "'" + v + "'";}
                            function inList(vals){return "[" + vals.map(quote).join(",") + "].indexOf(" + valueProp + ") >= 0";}
                            const expr = inList(successVals) + " ? 'success' : "
                                + inList(dangerVals) + " ? 'danger' : "
                                + inList(warningVals) + " ? 'warning' : "
                                + inList(primaryVals) + " ? 'primary' : 'default'";
                            return {
                                cell: { type: "text", text: '<span class="label label-${' + expr + "}"
                                    + ">"
                                    + "${" + labelProp + "}</span>" }
                            };
                        ]]></c:script>
                    </gen-control>
                </col>
                <col id="supplierId" label="供应商" i18n-en:label="Supplier"/>
            </cols>
        </grid>
        <grid id="pick-list"/>
    </grids>

    <forms>
        <form id="view" size="lg" layoutControl="tabs">
            <layout x:override="replace">
=========>baseInfo[基本信息]======
 code[NCR编码] ncrDate[发生日期]
 sourceType[来源类型] sourceCode[来源单号]
 materialId[物料] supplierId[供应商]
 quantity[数量] inspectionId[质检单]
 description[描述]
=========>spec[规格信息]======
 parameterName[参数名称] measuredValue[测量值]
 specMin[规格下限] specMax[规格上限]
 severity[严重程度]
=========>disposition[处置方式]======
 dispositionType[处置类型] returnCode[退货单号]
=========>status[状态信息]======
 status[状态] assignedTo[指派人]
=========>verification[效果验证]======
 resolvedBy[解决人] resolvedAt[解决时间]
 resolution[解决方案]
=========>capa[CAPA 纠正预防措施]======
 actions[CAPA 措施](2)
=========>posting[过账信息]======
 posted[已过账] postedAt[过账时间]
 postedBy[过账人]
========^audit[审计信息]=========
 remark[备注]
 createdBy[创建人] createTime[创建时间]
 updatedBy[修改人] updateTime[修改时间]
            </layout>
            <cells>
                <!--
                  CAPA 内嵌子表（F16 P1，plan §Phase 5）。
                  经 ErpQaNonConformance.actions to-many 关系（orm line 390）随头实体 gql:selection 嵌套加载。
                  引用 ErpQaAction sub-grid-view（含 actionType/description/responsiblePerson/dueDate/status/
                  completedAt/verificationPerson/verificationDate），覆盖 CAPA 措施 + 效果验证。
                  实时仓库核实：FK 字段名为 ncrId（ErpQaAction.ncrId → ErpQaNonConformance.id）。
                -->
                <cell id="actions">
                    <view path="/erp/qa/pages/ErpQaAction/ErpQaAction.view.xml" grid="sub-grid-view"/>
                </cell>
            </cells>
        </form>
        <form id="edit" size="lg" layoutControl="tabs">
            <layout x:override="replace">
=========>baseInfo[基本信息]======
 code[NCR编码] ncrDate[发生日期]
 sourceType[来源类型] sourceCode[来源单号]
 materialId[物料] supplierId[供应商]
 quantity[数量] inspectionId[质检单]
 description[描述]
=========>spec[规格信息]======
 parameterName[参数名称] measuredValue[测量值]
 specMin[规格下限] specMax[规格上限]
 severity[严重程度]
=========>disposition[处置方式]======
 dispositionType[处置类型] returnCode[退货单号]
=========>status[状态信息]======
 status[状态] assignedTo[指派人]
=========>verification[效果验证]======
 resolvedBy[解决人] resolvedAt[解决时间]
 resolution[解决方案]
=========>posting[过账信息]======
 posted[已过账] postedAt[过账时间]
 postedBy[过账人]
========^audit[审计信息]=========
 remark[备注](2)
 createdBy[创建人] createTime[创建时间]
 updatedBy[修改人] updateTime[修改时间]
            </layout>
        </form>
        <form id="add" x:prototype="edit"/>
        <form id="query" editMode="query" title="查询条件" i18n-en:title="Query Condition">
            <layout>
 code[NCR编码] status[状态]
 materialId[物料] supplierId[供应商]
 ncrDate[发生日期]
            </layout>
            <cells>
                <cell id="code" filterOp="like"/>
                <cell id="status" filterOp="eq"/>
                <cell id="materialId" filterOp="eq"/>
                <cell id="supplierId" filterOp="eq"/>
                <cell id="ncrDate" filterOp="date-between"/>
            </cells>
        </form>

        <!-- NCR 解决参数表单（perf-ux 2026-09-27 P1-2 同构）：resolution 必填 + noCapaReason 选填，
             替换原 resolution= 空串直提。 -->
        <form id="resolveNcr" editMode="add" title="解决 NCR" i18n-en:title="Resolve NCR" size="md">
            <layout>
 resolution[解决方案] noCapaReason[无CAPA原因]
</layout>
            <cells>
                <cell id="resolution" label="解决方案" i18n-en:label="Resolution" domain="string" custom="true" mandatory="true">
                    <gen-control>
                        <textarea placeholder="必填：解决方案描述（记入 NCR 解决记录）" minRows="2"/>
                    </gen-control>
                </cell>
                <cell id="noCapaReason" label="无 CAPA 原因" i18n-en:label="No-CAPA Reason" domain="string" custom="true">
                    <gen-control>
                        <input-text placeholder="选填：未启动 CAPA 的原因说明"/>
                    </gen-control>
                </cell>
            </cells>
        </form>
    </forms>

    <pages>
        <crud name="main">
            <rowActions x:override="bounded-merge">
                <action id="row-view-button"/>
                <action id="row-update-button" actionType="drawer"/>
                <action id="row-investigate-button" label="评审" i18n-en:label="Review" level="primary" icon="fa fa-search">
                    <api url="@mutation:ErpQaNonConformance__submitReview?ncrId=$id"/>
                    <confirmText>确认提交此 NCR 进入评审？</confirmText>
                    <messages>
                        <success>NCR 已进入评审</success>
                    </messages>
                    <visibleOn>${status == 'OPEN'}</visibleOn>
                </action>
                <!-- 解决（perf-ux 2026-09-27 P1-2 同构）：dialog 收集解决方案与无 CAPA 原因。 -->
                <action id="row-resolve-button" label="解决" i18n-en:label="Resolve" level="success" icon="fa fa-check"
                        actionType="dialog">
                    <dialog page="resolveNcr" size="md"/>
                    <visibleOn>${status == 'IN_REVIEW'}</visibleOn>
                </action>
                <action id="row-reject-button" label="拒绝" i18n-en:label="Refuse" level="warning" icon="fa fa-times">
                    <api url="@mutation:ErpQaNonConformance__cancel?ncrId=$id"/>
                    <confirmText>确认拒绝/取消此 NCR？</confirmText>
                    <messages>
                        <success>NCR 已取消</success>
                    </messages>
                    <visibleOn>${status == 'OPEN' || status == 'IN_REVIEW'}</visibleOn>
                </action>
                <action id="row-view-action-button" label="纠正措施(CAPA)" i18n-en:label="CAPA Actions" level="info" icon="fa fa-shield"
                        actionType="drawer">
                    <drawer page="/erp/qa/pages/ErpQaAction/ref-ncr.page.yaml" size="xl">
                        <data>
                            <ncrId>${id}</ncrId>
                        </data>
                    </drawer>
                </action>
                <action id="row-delete-button"/>
            </rowActions>
        </crud>
        <!-- NCR 解决提交页（perf-ux 2026-09-27 P1-2 同构）：resolution/noCapaReason 经 resolveNcr 表单收集 -->
        <simple name="resolveNcr" form="resolveNcr" useFormActions="true">
            <api url="@mutation:ErpQaNonConformance__resolve?ncrId=$id" withFormData="true"/>
            <actions>
                <action id="cancel" label="取消" i18n-en:label="Cancel" actionType="cancel"/>
                <action id="confirm" label="确认解决" i18n-en:label="Confirm Resolve" actionType="submit" level="success">
                    <messages>
                        <success>NCR 已解决</success>
                    </messages>
                </action>
            </actions>
        </simple>
        <picker name="picker"/>
    </pages>
</view>