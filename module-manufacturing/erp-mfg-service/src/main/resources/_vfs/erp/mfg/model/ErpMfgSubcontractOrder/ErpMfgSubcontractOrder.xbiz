<?xml version="1.0" encoding="UTF-8" ?>
<biz x:schema="/nop/schema/biz/xbiz.xdef" xmlns:x="/nop/schema/xdsl.xdef" xmlns:c="c" x:extends="_ErpMfgSubcontractOrder.xbiz">

    <actions>
        <mutation name="submitForApproval">
            <arg name="id" type="String" mandatory="true"/>
            <arg name="svcCtx" kind="ServiceContext"/>
            <return>
                <schema bizObjName="THIS_OBJ"/>
            </return>
            <source><c:script><![CDATA[
                return inject('app.erp.mfg.service.processor.ErpMfgSubcontractOrderSubmitForApprovalProcessor').submitForApproval(id, svcCtx);
            ]]></c:script></source>
        </mutation>
        <mutation name="approve">
            <arg name="id" type="String" mandatory="true"/>
            <arg name="svcCtx" kind="ServiceContext"/>
            <return>
                <schema bizObjName="THIS_OBJ"/>
            </return>
            <source><c:script><![CDATA[
                return inject('app.erp.mfg.service.processor.ErpMfgSubcontractOrderApproveProcessor').approve(id, svcCtx);
            ]]></c:script></source>
        </mutation>
        <mutation name="reject">
            <arg name="id" type="String" mandatory="true"/>
            <arg name="svcCtx" kind="ServiceContext"/>
            <return>
                <schema bizObjName="THIS_OBJ"/>
            </return>
            <source><c:script><![CDATA[
                return inject('app.erp.mfg.service.processor.ErpMfgSubcontractOrderRejectProcessor').reject(id, svcCtx);
            ]]></c:script></source>
        </mutation>
        <mutation name="reverseApprove">
            <arg name="id" type="String" mandatory="true"/>
            <arg name="svcCtx" kind="ServiceContext"/>
            <return>
                <schema bizObjName="THIS_OBJ"/>
            </return>
            <source><c:script><![CDATA[
                return inject('app.erp.mfg.service.processor.ErpMfgSubcontractOrderReverseApproveProcessor').reverseApprove(id, svcCtx);
            ]]></c:script></source>
        </mutation>
            <mutation name="withdrawApproval">
            <arg name="id" type="String" mandatory="true"/>
            <arg name="svcCtx" kind="ServiceContext"/>
            <return>
                <schema bizObjName="THIS_OBJ"/>
            </return>
            <source><c:script><![CDATA[
                return inject('app.erp.mfg.service.processor.ErpMfgSubcontractOrderWithdrawApprovalProcessor').withdrawApproval(id, svcCtx);
            ]]></c:script></source>
        </mutation>
    </actions>
</biz>
