<!-- Delta same-name Bean override proof (plan 2026-08-12-1841-3 Phase 3；契约 §6):
     Delta layer file. When nop.core.vfs.delta-layer-Ids=test-mfg-delta is active, this file is merged
     over the baseline app-service.beans.xml. The same bean id overrides the baseline
     ErpMfgForecastStateMachine with derived ErpMfgForecastStateMachineDelta (tightens cancel source:
     {DRAFT, APPROVED} to {DRAFT} only). All other baseline beans (Processors, jobs, etc.) are
     preserved by XDsl merge. -->
<beans x:schema="/nop/schema/beans.xdef" xmlns:x="/nop/schema/xdsl.xdef"
       xmlns="http://www.springframework.org/schema/beans">

    <bean id="app.erp.mfg.service.statemachine.ErpMfgForecastStateMachine"
          class="app.erp.mfg.service.statemachine.ErpMfgForecastStateMachineDelta"/>
</beans>
