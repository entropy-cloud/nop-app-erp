<?xml version="1.0" encoding="UTF-8" ?>
<meta x:schema="/nop/schema/xmeta.xdef" xmlns:x="/nop/schema/xdsl.xdef" x:extends="_ErpMfgCostRollupLine.xmeta">

    <props>
        <!-- E4.1 字段级隐藏（plan 2026-08-11-0915-3 Phase 2，Q1 (d) 冻结）：
             4 要素成本精确值全局隐藏（研发不可见），经代理视图 ErpMfgCostRollupLineBizModel
             @BizLoader(autoCreateField=true) 暴露为 materialBand/laborBand/overheadBand/subcontractBand
             high/mid/low 档位。totalCost/unitCost 聚合保持 published（masking 授权可见）。
             属性三元组参照 logistics ErpLogCarrierConfig.xmeta published=false 先例。-->
        <prop name="materialCost" published="false" queryable="false" sortable="false"/>
        <prop name="laborCost" published="false" queryable="false" sortable="false"/>
        <prop name="overheadCost" published="false" queryable="false" sortable="false"/>
        <prop name="subcontractCost" published="false" queryable="false" sortable="false"/>
    </props>
</meta>
