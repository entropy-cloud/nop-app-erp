<?xml version="1.0" encoding="UTF-8" ?>
<view xmlns:i18n-en="i18n-en" x:extends="_gen/_ErpMfgCostRollupLine.view.xml" x:schema="/nop/schema/xui/xview.xdef"
      xmlns:x="/nop/schema/xdsl.xdef">
    <controlLib>/erp/xlib/control.xlib</controlLib>

    <grids>
        <grid id="list">
            <cols x:override="bounded-merge">
                <col id="id" mandatory="true" ui:number="true" sortable="true"/>
                <col id="costRollup" label="滚算单" i18n-en:label="Rolling Calc Order"/>
                <col id="lineNo" mandatory="true" ui:number="true" sortable="true"/>
                <col id="materialId" label="产品" i18n-en:label="Product"/>
                <col id="uoMId" label="计量单位" i18n-en:label="UoM"/>
                <col id="currencyId" label="币种" i18n-en:label="Currency"/>
                <!-- E4.1：materialCost/laborCost/overheadCost/subcontractCost 已 published=false 隐藏，grid 不引用。
                     band 字段为 @BizLoader 代理视图字段（非实体属性），col 需 custom="true"（对齐 ErpFinVoucher balanceStatus 先例）。 -->
                <col id="materialBand" label="材料档位" i18n-en:label="Material Band" sortable="true" align="center" custom="true"/>
                <col id="laborBand" label="人工档位" i18n-en:label="Labor Band" sortable="true" align="center" custom="true"/>
                <col id="overheadBand" label="制费档位" i18n-en:label="Overhead Band" sortable="true" align="center" custom="true"/>
                <col id="subcontractBand" label="委外档位" i18n-en:label="Subcontract Band" sortable="true" align="center" custom="true"/>
                <col id="totalCost" ui:number="true" sortable="true" align="right" domain="amount"></col>
                <col id="unitCost" ui:number="true" sortable="true" align="right" domain="amount"></col>
            </cols>
        </grid>
        <grid id="pick-list"/>
    </grids>

    <forms>
        <form id="view" size="lg">
            <layout x:override="replace">
=========>baseInfo[基本信息]======
 lineNo[行号] materialId[物料]
 uoMId[计量单位]
=========>cost[成本信息]======
 materialBand[材料档位] laborBand[人工档位]
 overheadBand[制费档位] subcontractBand[委外档位]
 totalCost[总成本] unitCost[单位成本]
 currencyId[币种]
=========>reference[业务关联]======
 costRollupId[成本滚算单]
 ========^audit[审计信息]=========
 createdBy[创建人] createTime[创建时间]
 updatedBy[修改人] updateTime[修改时间]
            </layout>
            <cells>
                <!-- E4.1：band 字段为 @BizLoader 代理视图字段（非实体属性），cell 需 custom="true"
                     （对齐 ErpMfgWorkOrder workOrderProgress / ErpMfgSubcontractOrder 参数 cell 先例）。 -->
                <cell id="materialBand" custom="true"/>
                <cell id="laborBand" custom="true"/>
                <cell id="overheadBand" custom="true"/>
                <cell id="subcontractBand" custom="true"/>
            </cells>
        </form>
        <form id="edit" size="lg">
            <layout x:override="replace">
=========>baseInfo[基本信息]======
 lineNo[行号] materialId[物料]
 uoMId[计量单位]
=========>cost[成本信息]======
 totalCost[总成本] unitCost[单位成本]
 currencyId[币种]
=========>reference[业务关联]======
 costRollupId[成本滚算单]
 ========^audit[审计信息]=========
 createdBy[创建人] createTime[创建时间]
 updatedBy[修改人] updateTime[修改时间]
            </layout>
        </form>
        <form id="add" x:prototype="edit"/>
        <form id="query" editMode="query" title="查询条件" i18n-en:title="Query Condition">
            <layout>
 lineNo[行号] materialId[物料]
 costRollupId[成本滚算单] currencyId[币种]
 unitCost[单位成本]
            </layout>
            <cells>
                <cell id="lineNo" filterOp="eq"/>
                <cell id="materialId" filterOp="eq"/>
                <cell id="costRollupId" filterOp="eq"/>
                <cell id="currencyId" filterOp="eq"/>
                <cell id="unitCost" filterOp="gt"/>
            </cells>
        </form>
    </forms>

    <pages>
        <crud name="main"/>
        <picker name="picker"/>
    </pages>
</view>