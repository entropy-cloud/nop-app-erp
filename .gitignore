# IDE
/.idea/
*.iml
.settings/

# Build and release folders
bin-debug/
bin-release/
[Oo]bj/
[Bb]in/
target/
_dump/
# Per-module _dump (mirrors project-root _dump above; same rationale — runtime dump,
# regenerated by builds, never an authoritative artifact)
/**/_dump/

# Other
*.swf
*.air
*.ipa
*.apk

# Node.js (tools directory only)
node_modules/

# Playwright E2E test artifacts
test-results/
playwright-report/
# _tmp is reserved for the project root (temporary evidence dirs such as
# _tmp/<plan-id>-surefire-evidence/, _tmp/_tmp-server.sh, _tmp/e2e-server.log, etc.).
# Any nested _tmp/ under a module is a misplaced scratch dir and must be ignored
# (and ideally not created in the first place — redirect to the root _tmp/).
_tmp/
/**/_tmp/

# nop-file runtime store (E2E/local-run uploads via /f/upload, e.g. AP document pipeline)
/nop-file-store/

# OS files
.DS_Store

# Tools
tools/report/

# Local database
db/

# jqwik property-test run database (failed-run memory, regenerated per test run)
.jqwik-database

# Windows artifact
nul

# Local tool configs (skills are versioned)

# Codegen artifact: precompile/module-meta.yaml is copied to meta module root by the
# precompile dir-walk (BT5 overlay source lives in precompile/, root copy is a stray build artifact)
module-*/erp-*-meta/module-meta.yaml

# Stray root build artifacts: vfs-index/native-image config leaked to project root by a build
# run with the wrong CWD. The authoritative copies live under app-erp-all/src/main/resources/.
/src/
