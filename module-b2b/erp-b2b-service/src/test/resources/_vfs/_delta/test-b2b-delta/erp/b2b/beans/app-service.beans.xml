<!-- M2.16/M2.17 Delta same-name Bean override proof (plan 2026-08-12-1841-2 Phase 3):
     Delta layer file. When nop.core.vfs.delta-layer-Ids=test-b2b-delta is active, this file is merged
     over the baseline app-service.beans.xml. The same bean id overrides the baseline
     ErpB2bEdiDocStateMachine with derived ErpB2bEdiDocStateMachineDelta (tightens cancel source:
     TO_SEND/SENT/ERROR to TO_SEND only). All other baseline beans (Processors, Jobs, etc.) are
     preserved by XDsl merge. -->
<beans x:schema="/nop/schema/beans.xdef" xmlns:x="/nop/schema/xdsl.xdef"
       xmlns="http://www.springframework.org/schema/beans">

    <bean id="app.erp.b2b.service.statemachine.ErpB2bEdiDocStateMachine"
          class="app.erp.b2b.service.statemachine.ErpB2bEdiDocStateMachineDelta"/>
</beans>
