<!-- 角色侧行级数据权限规则（E2.2 employee-id 域列扩展 plan 2026-08-11-0915-1）。
     owner doc docs/design/roles-and-permissions.md §数据权限："维护人员只能看分配给自己的维护任务"。

     过滤列（employee-id 域，BIGINT，ref ErpMdEmployee.id，须 user.id==employee.id 种子对齐后直比，见 E2.2）：
     - ErpMntVisit.assignedTo（orm:259，指派人(职员)）
     - ErpMntRequest.assignedTo（orm:356，指派人(职员)）

     注：mnt assignedTo 列无 orm.xml 显式 ref 关系声明（仅 BIGINT + owner doc「指派人(职员)」语义），
     按 owner doc §数据权限「过滤列与列域分类」归类为 employee-id 域列（语义指 ErpMdEmployee.id）。

     E2.2 默认等效方案：employee-id 域列经专用测试账号 user.id==employee.id 种子对齐后，
     规则 eq(assignedTo, ${userContext.userId}) 整数直比成立（不触 ORM，ErpMdEmployee.userId 扩展为 successor）。

     EL 用 ${userContext.userId}（DefaultDataAuthChecker.newEvalScope 注入的 scope 变量 = IUserContext）。

     role-auth 顺序语义（对齐平台 nop-auth.data-auth.xml 范式，详见 erp-sal.data-auth.xml 注释）：
     同 priority（默认 100）按【声明顺序】首匹配——管理员首位无 filter → 维护人员次位带 filter → user 末位兜底。

     灰度：erp.data-auth.role-row-filter-enabled 默认 false（ErpRoleDataAuthChecker getFilter→null），
     且 nop.auth.enable-data-auth 默认 false——双层默认关闭，单组织基线零回归。 -->
<data-auth x:schema="/nop/schema/data-auth.xdef" xmlns:x="/nop/schema/xdsl.xdef">

    <objs>
        <!-- E2.2 employee-id 域列：维护人员仅见分配给自己的维护访问（assignedTo == userId，经种子对齐） -->
        <obj name="ErpMntVisit">
            <role-auths>
                <role-auth id="admin" roleIds="管理员"></role-auth>
                <role-auth id="technician" roleIds="维护人员">
                    <filter><eq name="assignedTo" value="${userContext.userId}"/></filter>
                </role-auth>
                <role-auth id="default" roleIds="user"></role-auth>
            </role-auths>
        </obj>
        <!-- E2.2 employee-id 域列：维护人员仅见分配给自己的维护请求（assignedTo == userId，经种子对齐） -->
        <obj name="ErpMntRequest">
            <role-auths>
                <role-auth id="admin" roleIds="管理员"></role-auth>
                <role-auth id="technician" roleIds="维护人员">
                    <filter><eq name="assignedTo" value="${userContext.userId}"/></filter>
                </role-auth>
                <role-auth id="default" roleIds="user"></role-auth>
            </role-auths>
        </obj>
    </objs>
</data-auth>
