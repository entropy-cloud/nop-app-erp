<?xml version="1.0" encoding="UTF-8" ?>
<auth x:extends="_erp-mnt.action-auth.xml" x:schema="/nop/schema/action-auth.xdef"
     xmlns:x="/nop/schema/xdsl.xdef" xmlns:i18n-en="i18n-en" xmlns:app="app">

    <site id="main">
        <!-- 删除自动生成的测试菜单根 -->
        <resource id="test-orm-erp-mnt" x:override="remove"/>

        <!-- 设备维护:maintenance域一级菜单 -->
        <resource id="erp-mnt" displayName="设备维护" i18n-en:displayName="Maintenance"
                  icon="wrench" resourceType="TOPM" orderNo="900"
                  routePath="/erp-mnt" component="layouts/default/index" roles="维护主管,维护人员">
            <children>
                <!-- 设备主数据 -->
                <resource id="mnt-equipment" displayName="设备主数据" i18n-en:displayName="Equipment"
                          icon="cog" resourceType="SUBM" orderNo="100" roles="维护主管">
                    <children>
                        <resource id="ErpMntEquipment-main" app:useCases="UC-MAIN-03,UC-MAIN-06,UC-MAIN-08,UC-MAIN-10" displayName="设备"
                                  i18n-en:displayName="Equipment" icon="cog"
                                  component="FLUX" resourceType="SUBM" orderNo="100"
                                  url="/erp/mnt/pages/ErpMntEquipment/main.page.yaml">
                                      <children>
                                          <resource id="FNPT:ErpMntEquipment:changeStatus" displayName="设备状态变更" i18n-en:displayName="Change Status"
                                                    resourceType="FNPT" orderNo="10010" roles="维护主管">
                                              <permissions>ErpMntEquipment:changeStatus</permissions>
                                          </resource>
                                          <resource id="FNPT:ErpMntEquipment:changeStatusForAssetDisposal" displayName="资产处置联动状态变更" i18n-en:displayName="Change Status For Asset Disposal"
                                                    resourceType="FNPT" orderNo="10020" roles="维护主管">
                                              <permissions>ErpMntEquipment:changeStatusForAssetDisposal</permissions>
                                          </resource>
                                          <resource id="FNPT:ErpMntEquipment:restoreFromAssetDisposal" displayName="资产处置恢复" i18n-en:displayName="Restore From Asset Disposal"
                                                    resourceType="FNPT" orderNo="10030" roles="维护主管">
                                              <permissions>ErpMntEquipment:restoreFromAssetDisposal</permissions>
                                          </resource>
                                      </children>
                                  </resource>
                        <resource id="ErpMntEquipmentCategory-main" app:useCases="UC-MAIN-08" displayName="设备分类"
                                  i18n-en:displayName="Equipment Category" icon="folder-tree"
                                  component="FLUX" resourceType="SUBM" orderNo="110"
                                  url="/erp/mnt/pages/ErpMntEquipmentCategory/main.page.yaml"/>
                    </children>
                </resource>
                <!-- 维护计划 -->
                <resource id="mnt-schedule" displayName="维护计划" i18n-en:displayName="Schedule"
                          icon="calendar-clock" resourceType="SUBM" orderNo="200" roles="维护主管">
                    <children>
                        <resource id="ErpMntSchedule-main" app:useCases="UC-MAIN-01,UC-MAIN-02" displayName="维护计划"
                                  i18n-en:displayName="Maintenance Schedule" icon="calendar-clock"
                                  component="FLUX" resourceType="SUBM" orderNo="200"
                                  url="/erp/mnt/pages/ErpMntSchedule/main.page.yaml">
                                      <children>
                                          <resource id="FNPT:ErpMntSchedule:generateDueVisits" displayName="生成到期维护访问" i18n-en:displayName="Generate Due Visits"
                                                    resourceType="FNPT" orderNo="20010" roles="维护主管">
                                              <permissions>ErpMntSchedule:generateDueVisits</permissions>
                                          </resource>
                                      </children>
                                  </resource>
                        <resource id="ErpMntCalibration-main" app:useCases="UC-MAIN-01" displayName="校准记录"
                                  i18n-en:displayName="Calibration" icon="gauge"
                                  component="FLUX" resourceType="SUBM" orderNo="210"
                                  url="/erp/mnt/pages/ErpMntCalibration/main.page.yaml">
                            <children>
                                <resource id="FNPT:ErpMntCalibration:approve" displayName="审核" i18n-en:displayName="Approve" resourceType="FNPT" orderNo="90010" roles="维护主管">
                                    <permissions>ErpMntCalibration:approve</permissions>
                                </resource>
                                <resource id="FNPT:ErpMntCalibration:reverseApprove" displayName="反审核设备校准" i18n-en:displayName="Reverse Approve"
                                          resourceType="FNPT" orderNo="20020" roles="管理员">
                                    <permissions>ErpMntCalibration:reverseApprove</permissions>
                                </resource>
                            </children>
                        </resource>
                    </children>
                </resource>
                <!-- 维护工单 -->
                <resource id="mnt-work" displayName="维护工单" i18n-en:displayName="Work Order"
                          icon="life-buoy" resourceType="SUBM" orderNo="300" roles="维护主管,维护人员">
                    <children>
                        <resource id="ErpMntVisit-main" app:useCases="UC-MAIN-03,UC-MAIN-04,UC-MAIN-07,UC-MAIN-09" displayName="维护访问"
                                  i18n-en:displayName="Maintenance Visit" icon="clipboard-check"
                                  component="FLUX" resourceType="SUBM" orderNo="300"
                                  url="/erp/mnt/pages/ErpMntVisit/main.page.yaml">
                                      <children>
                                          <resource id="FNPT:ErpMntVisit:schedule" displayName="排程维护访问" i18n-en:displayName="Schedule Visit"
                                                    resourceType="FNPT" orderNo="31010" roles="维护主管">
                                              <permissions>ErpMntVisit:schedule</permissions>
                                          </resource>
                                          <resource id="FNPT:ErpMntVisit:start" displayName="开始维护访问" i18n-en:displayName="Start Visit"
                                                    resourceType="FNPT" orderNo="31020" roles="维护人员">
                                              <permissions>ErpMntVisit:start</permissions>
                                          </resource>
                                          <resource id="FNPT:ErpMntVisit:complete" displayName="完成维护访问" i18n-en:displayName="Complete Visit"
                                                    resourceType="FNPT" orderNo="31030" roles="维护人员">
                                              <permissions>ErpMntVisit:complete</permissions>
                                          </resource>
                                          <resource id="FNPT:ErpMntVisit:cancel" displayName="取消维护访问" i18n-en:displayName="Cancel Visit"
                                                    resourceType="FNPT" orderNo="31040" roles="维护主管">
                                              <permissions>ErpMntVisit:cancel</permissions>
                                          </resource>
                                          <resource id="FNPT:ErpMntVisit:reportAdditionalFault" displayName="追加故障上报" i18n-en:displayName="Report Additional Fault"
                                                    resourceType="FNPT" orderNo="31050" roles="维护人员">
                                              <permissions>ErpMntVisit:reportAdditionalFault</permissions>
                                          </resource>
                                      </children>
                                  </resource>
                        <!-- F12 Tier C + F16 maintenance 4 步执行向导（plan 2026-07-23-1145-1）：引导式驱动 __start→__save→__complete + __cancel，零后端 delta -->
                        <resource id="mnt-visit-wizard" app:useCases="UC-MAIN-03,UC-MAIN-04,UC-MAIN-07,UC-MAIN-09" displayName="维护访问执行向导"
                                  i18n-en:displayName="Visit Execution Wizard" icon="magic"
                                  component="FLUX" resourceType="SUBM" orderNo="305"
                                  url="/erp/mnt/pages/visit-wizard/main.page.yaml"/>
                        <resource id="ErpMntRequest-main" app:useCases="UC-MAIN-05" displayName="维护请求"
                                  i18n-en:displayName="Maintenance Request" icon="life-buoy"
                                  component="FLUX" resourceType="SUBM" orderNo="310"
                                  url="/erp/mnt/pages/ErpMntRequest/main.page.yaml">
                            <children>
                                <resource id="FNPT:ErpMntRequest:approve" displayName="审核" i18n-en:displayName="Approve" resourceType="FNPT" orderNo="90010" roles="维护主管">
                                    <permissions>ErpMntRequest:approve</permissions>
                                </resource>
                                <resource id="FNPT:ErpMntRequest:reverseApprove" displayName="反审核维护请求" i18n-en:displayName="Reverse Approve"
                                          resourceType="FNPT" orderNo="10020" roles="管理员">
                                    <permissions>ErpMntRequest:reverseApprove</permissions>
                                </resource>
                                <resource id="FNPT:ErpMntRequest:accept" displayName="受理维护请求" i18n-en:displayName="Accept Request"
                                          resourceType="FNPT" orderNo="33010" roles="维护主管">
                                    <permissions>ErpMntRequest:accept</permissions>
                                </resource>
                                <resource id="FNPT:ErpMntRequest:startRepair" displayName="开始维修" i18n-en:displayName="Start Repair"
                                          resourceType="FNPT" orderNo="33020" roles="维护人员">
                                    <permissions>ErpMntRequest:startRepair</permissions>
                                </resource>
                                <resource id="FNPT:ErpMntRequest:complete" displayName="完成维修" i18n-en:displayName="Complete Repair"
                                          resourceType="FNPT" orderNo="33030" roles="维护人员">
                                    <permissions>ErpMntRequest:complete</permissions>
                                </resource>
                                <resource id="FNPT:ErpMntRequest:rejectRequest" displayName="拒绝维护请求" i18n-en:displayName="Reject Request"
                                          resourceType="FNPT" orderNo="33040" roles="维护主管">
                                    <permissions>ErpMntRequest:rejectRequest</permissions>
                                </resource>
                                <resource id="FNPT:ErpMntRequest:cancel" displayName="取消维护请求" i18n-en:displayName="Cancel Request"
                                          resourceType="FNPT" orderNo="33050" roles="维护主管">
                                    <permissions>ErpMntRequest:cancel</permissions>
                                </resource>
                            </children>
                        </resource>
                        <resource id="ErpMntDowntimeEntry-main" app:useCases="UC-MAIN-06,UC-MAIN-10" displayName="停机记录"
                                  i18n-en:displayName="Downtime Entry" icon="timer-off"
                                  component="FLUX" resourceType="SUBM" orderNo="320"
                                  url="/erp/mnt/pages/ErpMntDowntimeEntry/main.page.yaml">
                                      <children>
                                          <resource id="FNPT:ErpMntDowntimeEntry:record" displayName="记录停机" i18n-en:displayName="Record Downtime"
                                                    resourceType="FNPT" orderNo="34010" roles="维护人员">
                                              <permissions>ErpMntDowntimeEntry:record</permissions>
                                          </resource>
                                          <resource id="FNPT:ErpMntDowntimeEntry:complete" displayName="结束停机" i18n-en:displayName="Complete Downtime"
                                                    resourceType="FNPT" orderNo="34020" roles="维护人员">
                                              <permissions>ErpMntDowntimeEntry:complete</permissions>
                                          </resource>
                                      </children>
                                  </resource>
                    </children>
                </resource>
                <!-- 团队 -->
                <resource id="mnt-team" displayName="团队" i18n-en:displayName="Team"
                          icon="users" resourceType="SUBM" orderNo="400" roles="维护主管">
                    <children>
                        <resource id="ErpMntMaintenanceTeam-main" displayName="维护团队"
                                  i18n-en:displayName="Maintenance Team" icon="users"
                                  component="FLUX" resourceType="SUBM" orderNo="400"
                                  url="/erp/mnt/pages/ErpMntMaintenanceTeam/main.page.yaml"/>
                    </children>
                </resource>
                <!-- 备件 -->
                <resource id="mnt-spare" displayName="备件" i18n-en:displayName="Spare Part"
                          icon="package-minus" resourceType="SUBM" orderNo="500" roles="维护主管,维护人员">
                    <children>
                        <resource id="ErpMntSparePartUsage-main" app:useCases="UC-MAIN-04" displayName="备件消耗"
                                  i18n-en:displayName="Spare Part Usage" icon="package-minus"
                                  component="FLUX" resourceType="SUBM" orderNo="500"
                                  url="/erp/mnt/pages/ErpMntSparePartUsage/main.page.yaml">
                                      <children>
                                          <resource id="FNPT:ErpMntSparePartUsage:confirm" displayName="确认备件消耗" i18n-en:displayName="Confirm Usage"
                                                    resourceType="FNPT" orderNo="50010" roles="维护主管">
                                              <permissions>ErpMntSparePartUsage:confirm</permissions>
                                          </resource>
                                          <resource id="FNPT:ErpMntSparePartUsage:reverseConfirm" displayName="反冲备件消耗" i18n-en:displayName="Reverse Confirm"
                                                    resourceType="FNPT" orderNo="50020" roles="管理员">
                                              <permissions>ErpMntSparePartUsage:reverseConfirm</permissions>
                                          </resource>
                                      </children>
                                  </resource>
                    </children>
                </resource>
                <!-- 维护报表 -->
                <resource id="mnt-report" displayName="维护报表" i18n-en:displayName="Maintenance Reports"
                          icon="bar-chart-3" resourceType="SUBM" orderNo="600" roles="维护主管">
                    <children>
                        <resource id="maintenance-history" app:useCases="UC-MAIN-03,UC-MAIN-04,UC-MAIN-11" displayName="维护历史表"
                                  i18n-en:displayName="Maintenance History" icon="clipboard-check"
                                  component="FLUX" resourceType="SUBM" orderNo="6010"
                                  url="/erp/mnt/pages/report/maintenance-history.page.yaml"/>
                        <resource id="downtime-summary" app:useCases="UC-MAIN-06,UC-MAIN-10,UC-MAIN-11" displayName="停机统计表"
                                  i18n-en:displayName="Downtime Summary" icon="timer-off"
                                  component="FLUX" resourceType="SUBM" orderNo="6020"
                                  url="/erp/mnt/pages/report/downtime-summary.page.yaml"/>
                    </children>
                </resource>
                <!-- 报表看板 -->
                <resource id="mnt-dashboard" displayName="维护概览" i18n-en:displayName="Maintenance Overview"
                          icon="gauge" resourceType="SUBM" orderNo="999" roles="维护主管">
                    <children>
                        <resource id="mnt-dashboard-main" app:useCases="UC-MAIN-11" displayName="维护概览"
                                  i18n-en:displayName="Maintenance Overview" icon="gauge"
                                  component="FLUX" resourceType="SUBM" orderNo="9990"
                                  url="/erp/mnt/pages/dashboard/main.page.yaml"/>
                    </children>
                </resource>
            </children>
        </resource>
    </site>
</auth>
