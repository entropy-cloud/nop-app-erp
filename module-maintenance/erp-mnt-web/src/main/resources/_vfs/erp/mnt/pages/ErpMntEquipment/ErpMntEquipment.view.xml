<?xml version="1.0" encoding="UTF-8" ?>
<view xmlns:i18n-en="i18n-en" x:extends="_gen/_ErpMntEquipment.view.xml" x:schema="/nop/schema/xui/xview.xdef" xmlns:x="/nop/schema/xdsl.xdef">

    <grids>
        <grid id="list">
            <cols x:override="bounded-merge">
                <col id="id" mandatory="true" ui:number="true" sortable="true"/>
                <col id="code" mandatory="true" sortable="true"/>
                <col id="name" mandatory="true" sortable="true"/>
                <col id="orgId" label="组织" i18n-en:label="Organization"/>
                <col id="categoryId" label="设备类别" i18n-en:label="Equipment Category"/>
                <col id="locationId" label="位置" i18n-en:label="Location"/>
                <col id="asset" label="资产" i18n-en:label="Asset"/>
                <col id="status" mandatory="true" sortable="true">
                    <gen-control>
                        <c:script><![CDATA[
                            const valueProp = dispMeta?.id || 'status';
                            const labelProp = propMeta?.['graphql:labelProp'] || (valueProp + '_label');
                            const successVals = ['COMPLETED','APPROVED','RECEIVED','DELIVERED','PAID','SETTLED','HONORED','RETRIED','EXECUTED','COMPUTED','CONFIRMED','RUNNING','MATERIAL_TRANSFERRED','ACTIVE','CLOSED','DONE','SUCCESS'];
                            const dangerVals = ['REJECTED','CANCELLED','FAILED','DISHONORED','OVERDUE','DOWN','TERMINATED','WRITE_OFF'];
                            const warningVals = ['ON_HOLD','SUSPENDED','EXPIRED','RETRYING'];
                            const primaryVals = ['SUBMITTED','IN_PROGRESS','PARTIAL','PARTIALLY_TRANSFERRED','WORK_IN_PROGRESS','PROCESSING','NEGOTIATION','OPEN','UNDER_MAINTENANCE','COLLECTION_PENDING','DISCOUNTED','ENDORSED','ISSUED'];
                            function quote(v){return "'" + v + "'";}
                            function inList(vals){return "[" + vals.map(quote).join(",") + "].indexOf(" + valueProp + ") >= 0";}
                            const expr = inList(successVals) + " ? 'success' : "
                                + inList(dangerVals) + " ? 'danger' : "
                                + inList(warningVals) + " ? 'warning' : "
                                + inList(primaryVals) + " ? 'primary' : 'default'";
                            return {
                                type: "tpl",
                                tpl: '<span class="label label-${' + expr + "}"
                                    + ">"
                                    + "${" + labelProp + "}</span>"
                            };
                        ]]></c:script>
                    </gen-control>
                </col>
                <col id="serialNo" sortable="true"/>
                <col id="manufacturer" sortable="true"/>
                <col id="model" sortable="true"/>
                <col id="installDate" sortable="true" align="center">
                    <gen-control>
                        <c:script><![CDATA[
                            return { type: 'date', format: 'YYYY-MM-DD' };
                        ]]></c:script>
                    </gen-control>
                </col>
            </cols>
        </grid>
        <grid id="pick-list"/>
        <!-- Drawer 相关 crud grids：仅展示直接字段（custom="true" 因为字段属于关联实体 ErpMntVisit/ErpMntSparePartUsage） -->
        <grid id="archive-visit-list">
            <cols>
                <col id="id" custom="true" mandatory="true" ui:number="true" sortable="true" domain="long"/>
                <col id="code" custom="true" mandatory="true" sortable="true" domain="string"/>
                <col id="visitDate" custom="true" mandatory="true" sortable="true" align="center" domain="date">
                    <gen-control>
                        <c:script><![CDATA[
                            return { type: 'date', format: 'YYYY-MM-DD' };
                        ]]></c:script>
                    </gen-control>
                </col>
                <col id="visitType" custom="true" sortable="true" domain="string"/>
                <col id="status" custom="true" mandatory="true" sortable="true" domain="string">
                    <gen-control>
                        <c:script><![CDATA[
                            const valueProp = dispMeta?.id || 'status';
                            const labelProp = propMeta?.['graphql:labelProp'] || (valueProp + '_label');
                            const successVals = ['COMPLETED','APPROVED','RECEIVED','DELIVERED','PAID','SETTLED','HONORED','RETRIED','EXECUTED','COMPUTED','CONFIRMED','RUNNING','MATERIAL_TRANSFERRED','ACTIVE','CLOSED','DONE','SUCCESS'];
                            const dangerVals = ['REJECTED','CANCELLED','FAILED','DISHONORED','OVERDUE','DOWN','TERMINATED','WRITE_OFF'];
                            const warningVals = ['ON_HOLD','SUSPENDED','EXPIRED','RETRYING'];
                            const primaryVals = ['SUBMITTED','IN_PROGRESS','PARTIAL','PARTIALLY_TRANSFERRED','WORK_IN_PROGRESS','PROCESSING','NEGOTIATION','OPEN','UNDER_MAINTENANCE','COLLECTION_PENDING','DISCOUNTED','ENDORSED','ISSUED'];
                            function quote(v){return "'" + v + "'";}
                            function inList(vals){return "[" + vals.map(quote).join(",") + "].indexOf(" + valueProp + ") >= 0";}
                            const expr = inList(successVals) + " ? 'success' : "
                                + inList(dangerVals) + " ? 'danger' : "
                                + inList(warningVals) + " ? 'warning' : "
                                + inList(primaryVals) + " ? 'primary' : 'default'";
                            return {
                                type: "tpl",
                                tpl: '<span class="label label-${' + expr + "}"
                                    + ">"
                                    + "${" + labelProp + "}</span>"
                            };
                        ]]></c:script>
                    </gen-control>
                </col>
                <col id="totalMinutes" custom="true" ui:number="true" sortable="true" domain="long"/>
            </cols>
        </grid>
        <grid id="archive-spare-part-list">
            <cols>
                <col id="id" custom="true" mandatory="true" ui:number="true" sortable="true" domain="long"/>
                <col id="code" custom="true" mandatory="true" sortable="true" domain="string"/>
                <col id="businessDate" custom="true" mandatory="true" sortable="true" align="center" domain="date">
                    <gen-control>
                        <c:script><![CDATA[
                            return { type: 'date', format: 'YYYY-MM-DD' };
                        ]]></c:script>
                    </gen-control>
                </col>
                <col id="totalAmount" custom="true" ui:number="true" sortable="true" align="right" domain="amount">
                    <gen-control>
                        <c:script><![CDATA[
                            return { type: 'number', kilometer: true, precision: 2 };
                        ]]></c:script>
                    </gen-control>
                </col>
                <col id="docStatus" custom="true" mandatory="true" sortable="true" domain="string">
                    <gen-control>
                        <c:script><![CDATA[
                            const valueProp = dispMeta?.id || 'docStatus';
                            const labelProp = propMeta?.['graphql:labelProp'] || (valueProp + '_label');
                            return {
                                type: "tpl",
                                tpl: '<span class="label label-${' + valueProp
                                    + " == 'ACTIVE' ? 'primary' : 'default'}\">"
                                    + "${" + labelProp + "}</span>"
                            };
                        ]]></c:script>
                    </gen-control>
                </col>
            </cols>
        </grid>
    </grids>

    <forms>
        <form id="view" size="lg" layoutControl="tabs">
            <layout x:override="replace">
=========>baseInfo[基本信息]======
 code[设备编码] name[设备名称]
 orgId[所属组织] assetId[资产卡片]
 workcenterId[工作中心] locationId[位置]
 categoryId[分类] status[状态]
 serialNo[序列号] manufacturer[制造商]
 model[型号] installDate[安装日期]
 warrantyExpiry[保修到期]
=========>audit[审计信息]======
 remark[备注]
 createdBy[创建人] createTime[创建时间]
 updatedBy[修改人] updateTime[修改时间]
            </layout>
        </form>
        <form id="edit" size="lg" layoutControl="tabs">
            <layout x:override="replace">
=========>baseInfo[基本信息]======
 code[设备编码] name[设备名称]
 orgId[所属组织] assetId[资产卡片]
 workcenterId[工作中心] locationId[位置]
 categoryId[分类] status[状态]
 serialNo[序列号] manufacturer[制造商]
 model[型号] installDate[安装日期]
 warrantyExpiry[保修到期]
=========>audit[审计信息]======
 remark[备注](2)
 createdBy[创建人] createTime[创建时间]
 updatedBy[修改人] updateTime[修改时间]
            </layout>
        </form>
        <form id="add" x:prototype="edit"/>
        <form id="query" editMode="query" title="查询条件" i18n-en:title="Query Condition">
            <layout>
 code[设备编码] name[设备名称]
 status[状态] categoryId[分类]
 orgId[所属组织]
            </layout>
            <cells>
                <cell id="code" filterOp="like"/>
                <cell id="name" filterOp="like"/>
                <cell id="status" filterOp="eq"/>
                <cell id="categoryId" filterOp="eq"/>
                <cell id="orgId" filterOp="eq"/>
            </cells>
        </form>
    </forms>

    <pages>
        <crud name="main">
            <rowActions x:override="bounded-merge">
                <action id="row-view-button"/>
                <action id="row-update-button" actionType="drawer"/>
                <action id="row-view-equipment-dashboard-button" label="完整仪表板" i18n-en:label="Full Dashboard" level="info" icon="fa fa-tachometer"
                        actionType="drawer">
                    <dialog page="equipmentDashboard" size="xl">
                        <data>
                            <id>${'$'}{id}</id>
                        </data>
                    </dialog>
                </action>
                <action id="row-create-request-button" label="创建维修请求" i18n-en:label="Create Request" level="primary" icon="fa fa-plus"
                        tooltip="跳转到维修请求列表（带设备上下文筛选），新建请求时自动预填设备"
                        link="/ErpMntRequest-main?filter_equipmentId=${id}">
                    <visibleOn>${status != 'DECOMMISSIONED'}</visibleOn>
                </action>
                <action id="row-view-visit-button" label="巡检记录" i18n-en:label="Visits" level="info" icon="fa fa-wrench"
                        actionType="drawer">
                    <drawer page="/erp/mnt/pages/ErpMntVisit/ref-equipment.page.yaml" size="xl">
                        <data>
                            <equipmentId>${id}</equipmentId>
                        </data>
                    </drawer>
                </action>
                <action id="row-view-schedule-button" label="保养计划" i18n-en:label="Schedules" level="info" icon="fa fa-calendar"
                        actionType="drawer">
                    <drawer page="/erp/mnt/pages/ErpMntSchedule/ref-equipment.page.yaml" size="xl">
                        <data>
                            <equipmentId>${id}</equipmentId>
                        </data>
                    </drawer>
                </action>
                <action id="row-view-request-button" label="维修请求" i18n-en:label="Requests" level="info" icon="fa fa-bell"
                        actionType="drawer">
                    <drawer page="/erp/mnt/pages/ErpMntRequest/ref-equipment.page.yaml" size="xl">
                        <data>
                            <equipmentId>${id}</equipmentId>
                        </data>
                    </drawer>
                </action>
                <action id="row-view-spare-part-button" label="备件消耗" i18n-en:label="Spare Parts" level="info" icon="fa fa-cogs"
                        actionType="drawer">
                    <drawer page="/erp/mnt/pages/ErpMntSparePartUsage/ref-equipment.page.yaml" size="xl">
                        <data>
                            <equipmentId>${id}</equipmentId>
                        </data>
                    </drawer>
                </action>
                <action id="row-view-downtime-button" label="停机记录" i18n-en:label="Downtime" level="info" icon="fa fa-power-off"
                        actionType="drawer">
                    <drawer page="/erp/mnt/pages/ErpMntDowntimeEntry/ref-equipment.page.yaml" size="xl">
                        <data>
                            <equipmentId>${id}</equipmentId>
                        </data>
                    </drawer>
                </action>
                <action id="row-delete-button"/>
            </rowActions>
        </crud>

        <!-- 完整仪表板 drawer（机制 B）：headerForm simple + 维护时间线 + 备件消耗 crud tab。
             状态色块由 headerForm 内既有 status gen-control 渲染（无需独立 tab）。
             维护时间线用 ErpMntVisit findPage filter_equipmentId（分页）；@BizQuery maintenanceHistoryData 为非分页 List，归报表用。 -->
        <simple name="equipmentHeader" form="view">
            <initApi url="@query:ErpMntEquipment__get?id=${'$'}{id}" gql:selection="{@formSelection}"/>
        </simple>

        <crud name="equipmentMaintenanceHistory" grid="archive-visit-list">
            <table noOperations="true">
                <api url="@query:ErpMntVisit__findPage/{@pageSelection}?filter_equipmentId=${'$'}{id}"/>
            </table>
        </crud>

        <crud name="equipmentSpareParts" grid="archive-spare-part-list">
            <table noOperations="true">
                <api url="@query:ErpMntSparePartUsage__findPage/{@pageSelection}?filter_equipmentId=${'$'}{id}"/>
            </table>
        </crud>

        <tabs name="equipmentDashboard" mountOnEnter="true" unmountOnExit="false">
            <tab name="header" page="equipmentHeader" title="基本信息" i18n-en:title="Basic Info"/>
            <tab name="maintenance" page="equipmentMaintenanceHistory" title="维护时间线" i18n-en:title="Maintenance Timeline"/>
            <tab name="spareParts" page="equipmentSpareParts" title="备件消耗" i18n-en:title="Spare Parts Used"/>
        </tabs>

        <picker name="picker"/>
    </pages>
</view>