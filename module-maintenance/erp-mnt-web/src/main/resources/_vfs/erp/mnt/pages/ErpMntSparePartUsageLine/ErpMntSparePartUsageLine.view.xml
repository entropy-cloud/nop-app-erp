<?xml version="1.0" encoding="UTF-8" ?>
<view xmlns:i18n-en="i18n-en" x:extends="_gen/_ErpMntSparePartUsageLine.view.xml" x:schema="/nop/schema/xui/xview.xdef"
      xmlns:x="/nop/schema/xdsl.xdef">
    <controlLib>/erp/xlib/control.xlib</controlLib>

    <grids>
        <grid id="list">
            <cols x:override="bounded-merge">
                <col id="id" mandatory="true" ui:number="true" sortable="true"/>
                <col id="sparePartUsage" label="备件消耗" i18n-en:label="Spare Parts Used"/>
                <col id="lineNo" mandatory="true" ui:number="true" sortable="true"/>
                <col id="materialId" label="物料" i18n-en:label="Material"/>
                <col id="uoMId" label="计量单位" i18n-en:label="UoM"/>
                <col id="quantity" mandatory="true" ui:number="true" sortable="true" align="right" domain="quantity"></col>
                <col id="unitCost" ui:number="true" sortable="true" align="right" domain="amount"></col>
                <col id="amount" ui:number="true" sortable="true" align="right" domain="amount"></col>
                <col id="batchNo" sortable="true"/>
            </cols>
        </grid>
        <grid id="pick-list"/>

        <!-- SparePartUsage 独立 CRUD 页面的行内编辑子表（Phase 2 Item 2，Phase 0 Decision 候选 a）。
             经 ErpMntSparePartUsage.view.xml edit/view form 的 <cell name="lines"> 引用。 -->
        <grid id="sub-grid-edit" x:prototype="list" editMode="list-edit">
            <cols x:override="bounded-merge">
                <col id="lineNo" mandatory="true" ui:number="true">
                    <gen-control>
                        <c:script><![CDATA[
                            return {
                                type: 'input-number',
                                name: 'lineNo',
                                required: true,
                                step: 1,
                                validations: { minimum: 0 },
                                validationErrors: { minimum: '行号不能为负' }
                            };
                        ]]></c:script>
                    </gen-control>
                </col>
                <col id="materialId" mandatory="true">
                    <gen-control>
                        <c:script><![CDATA[
                            return {
                                type: 'picker',
                                name: 'materialId',
                                label: '备件(物料)',
                                required: true,
                                source: '/erp/md/pages/ErpMdMaterial/picker.page.yaml',
                                valueField: 'id',
                                labelField: 'name',
                                joinValues: false,
                                extractValue: true
                            };
                        ]]></c:script>
                    </gen-control>
                </col>
                <col id="uoMId" mandatory="true">
                    <gen-control>
                        <c:script><![CDATA[
                            return {
                                type: 'picker',
                                name: 'uoMId',
                                label: '计量单位',
                                required: true,
                                source: '/erp/md/pages/ErpMdUoM/picker.page.yaml',
                                valueField: 'id',
                                labelField: 'name',
                                joinValues: false,
                                extractValue: true
                            };
                        ]]></c:script>
                    </gen-control>
                </col>
                <col id="quantity" mandatory="true">
                    <gen-control>
                        <c:script><![CDATA[
                            return {
                                type: 'input-number',
                                name: 'quantity',
                                required: true,
                                step: 0.0001,
                                validations: { minimum: 0 },
                                validationErrors: { minimum: '消耗数量不能为负' }
                            };
                        ]]></c:script>
                    </gen-control>
                </col>
                <col id="unitCost">
                    <gen-control>
                        <c:script><![CDATA[
                            return {
                                type: 'input-number',
                                name: 'unitCost',
                                step: 0.0001,
                                validations: { minimum: 0 },
                                validationErrors: { minimum: '单位成本不能为负' }
                            };
                        ]]></c:script>
                    </gen-control>
                </col>
                <col id="amount">
                    <gen-control>
                        <c:script><![CDATA[
                            return {
                                type: 'input-number',
                                name: 'amount',
                                step: 0.0001,
                                validations: { minimum: 0 },
                                validationErrors: { minimum: '金额不能为负' }
                            };
                        ]]></c:script>
                    </gen-control>
                </col>
                <col id="batchNo"/>
                <col id="remark"/>
            </cols>
        </grid>

        <grid id="sub-grid-view" x:prototype="list" editMode="list-view">
            <cols x:override="bounded-merge">
                <col id="lineNo" mandatory="true" ui:number="true"/>
                <col id="materialId"/>
                <col id="uoMId"/>
                <col id="quantity" align="right" domain="quantity"></col>
                <col id="unitCost" align="right" domain="quantity"></col>
                <col id="amount" align="right" domain="quantity"></col>
                <col id="batchNo"/>
                <col id="remark"/>
            </cols>
        </grid>
    </grids>

    <forms>
        <form id="view" size="lg">
            <layout x:override="replace">
=========>baseInfo[基本信息]======
 lineNo[行号] materialId[物料]
 uoMId[计量单位] batchNo[批号]
=========>quantity[数量与价格]======
 quantity[数量] unitCost[单位成本]
 amount[金额]
=========>reference[业务关联]======
 sparePartUsageId[备件消耗单]
========^audit[审计信息]=========
 remark[备注]
 createdBy[创建人] createTime[创建时间]
 updatedBy[修改人] updateTime[修改时间]
            </layout>
        </form>
        <form id="edit" size="lg">
            <layout x:override="replace">
=========>baseInfo[基本信息]======
 lineNo[行号] materialId[物料]
 uoMId[计量单位] batchNo[批号]
=========>quantity[数量与价格]======
 quantity[数量] unitCost[单位成本]
 amount[金额]
=========>reference[业务关联]======
 sparePartUsageId[备件消耗单]
========^audit[审计信息]=========
 remark[备注](2)
 createdBy[创建人] createTime[创建时间]
 updatedBy[修改人] updateTime[修改时间]
            </layout>
        </form>
        <form id="add" x:prototype="edit"/>
        <form id="query" editMode="query" title="查询条件" i18n-en:title="Query Condition">
            <layout>
 sparePartUsageId[备件消耗单] lineNo[行号]
 materialId[物料] batchNo[批号]
 quantity[数量]
            </layout>
            <cells>
                <cell id="sparePartUsageId" filterOp="eq"/>
                <cell id="lineNo" filterOp="eq"/>
                <cell id="materialId" filterOp="eq"/>
                <cell id="batchNo" filterOp="like"/>
                <cell id="quantity" filterOp="gt"/>
            </cells>
        </form>
    </forms>

    <pages>
        <crud name="main"/>
        <picker name="picker"/>
    </pages>
</view>