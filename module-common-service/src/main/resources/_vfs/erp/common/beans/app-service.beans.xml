<?xml version="1.0" encoding="UTF-8" ?>
<beans x:schema="/nop/schema/beans.xdef" xmlns:x="/nop/schema/xdsl.xdef"
       xmlns:ioc="ioc"
       xmlns="http://www.springframework.org/schema/beans">

    <!-- 多公司 orgId 隔离基础设施（plan 2026-07-30-0841-3-r1-29，P1-MA2-093/094）。
         config-gated 默认关闭（erp.multi-company.org-isolation-enabled=false），保护单组织基线零回归。

         读路径：覆盖平台 nop/biz/beans/biz-defaults.beans.xml 的 EmptyQueryTransformer 默认（同 id 非 default 覆盖 default），
         CrudBizModel 经 @Named("nopGlobalQueryTransformer") 自动注入并应用于全部 findPage/findList。 -->
    <bean id="nopGlobalQueryTransformer"
          class="app.erp.common.org.ErpOrgIsolationQueryTransformer"/>

    <!-- 写路径 auto-stamp：nopOrmSessionFactory 经 collect-beans by-type=IOrmInterceptor 自动收集 -->
    <bean id="erpOrgIsolationOrmInterceptor"
          class="app.erp.common.org.ErpOrgIsolationOrmInterceptor"/>
</beans>
