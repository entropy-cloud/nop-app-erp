<?xml version="1.0" encoding="UTF-8" ?>
<biz x:schema="/nop/schema/biz/xbiz.xdef" xmlns:x="/nop/schema/xdsl.xdef" xmlns:c="c" x:extends="_ErpPurInvoice.xbiz">

    <actions>
        <mutation name="submitForApproval">
            <arg name="id" type="String" mandatory="true"/>
            <arg name="svcCtx" kind="ServiceContext"/>
            <return>
                <schema bizObjName="THIS_OBJ"/>
            </return>
            <source><c:script><![CDATA[
                return inject('app.erp.pur.service.processor.ErpPurInvoiceSubmitForApprovalProcessor').submitForApproval(id, svcCtx);
            ]]></c:script></source>
        </mutation>
        <mutation name="approve">
            <auth permissions="ErpPurInvoice:approve"/>
            <arg name="id" type="String" mandatory="true"/>
            <arg name="svcCtx" kind="ServiceContext"/>
            <return>
                <schema bizObjName="THIS_OBJ"/>
            </return>
            <source><c:script><![CDATA[
                return inject('app.erp.pur.service.processor.ErpPurInvoiceApproveProcessor').approve(id, svcCtx);
            ]]></c:script></source>
        </mutation>
        <mutation name="reverseApprove">
            <auth permissions="ErpPurInvoice:reverseApprove"/>
            <arg name="id" type="String" mandatory="true"/>
            <arg name="svcCtx" kind="ServiceContext"/>
            <return>
                <schema bizObjName="THIS_OBJ"/>
            </return>
            <source><c:script><![CDATA[
                return inject('app.erp.pur.service.processor.ErpPurInvoiceReverseApproveProcessor').reverseApprove(id, svcCtx);
            ]]></c:script></source>
        </mutation>
            <mutation name="reject">
            <arg name="id" type="String" mandatory="true"/>
            <arg name="svcCtx" kind="ServiceContext"/>
            <return>
                <schema bizObjName="THIS_OBJ"/>
            </return>
            <source><c:script><![CDATA[
                return inject('app.erp.pur.service.processor.ErpPurInvoiceRejectProcessor').reject(id, svcCtx);
            ]]></c:script></source>
        </mutation>
        <mutation name="withdrawApproval">
            <arg name="id" type="String" mandatory="true"/>
            <arg name="svcCtx" kind="ServiceContext"/>
            <return>
                <schema bizObjName="THIS_OBJ"/>
            </return>
            <source><c:script><![CDATA[
                return inject('app.erp.pur.service.processor.ErpPurInvoiceWithdrawApprovalProcessor').withdrawApproval(id, svcCtx);
            ]]></c:script></source>
        </mutation>
    </actions>
</biz>
