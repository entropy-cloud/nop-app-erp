<?xml version="1.0" encoding="UTF-8" ?>
<biz x:schema="/nop/schema/biz/xbiz.xdef" xmlns:x="/nop/schema/xdsl.xdef" xmlns:c="c" x:extends="_ErpPurReceive.xbiz">

    <actions>
        <mutation name="submitForApproval">
            <auth permissions="ErpPurReceive:mutation"/>
            <arg name="id" type="String" mandatory="true"/>
            <arg name="svcCtx" kind="ServiceContext"/>
            <return>
                <schema bizObjName="THIS_OBJ"/>
            </return>
            <source><c:script><![CDATA[
                return inject('app.erp.pur.service.processor.ErpPurReceiveSubmitForApprovalProcessor').submitForApproval(id, svcCtx);
            ]]></c:script></source>
        </mutation>
        <mutation name="approve">
            <auth permissions="ErpPurReceive:approve"/>
            <arg name="id" type="String" mandatory="true"/>
            <arg name="svcCtx" kind="ServiceContext"/>
            <return>
                <schema bizObjName="THIS_OBJ"/>
            </return>
            <source><c:script><![CDATA[
                return inject('app.erp.pur.service.processor.ErpPurReceiveApproveProcessor').approve(id, svcCtx);
            ]]></c:script></source>
        </mutation>
        <mutation name="reverseApprove">
            <auth permissions="ErpPurReceive:reverseApprove"/>
            <arg name="id" type="String" mandatory="true"/>
            <arg name="svcCtx" kind="ServiceContext"/>
            <return>
                <schema bizObjName="THIS_OBJ"/>
            </return>
            <source><c:script><![CDATA[
                return inject('app.erp.pur.service.processor.ErpPurReceiveReverseApproveProcessor').reverseApprove(id, svcCtx);
            ]]></c:script></source>
        </mutation>
            <mutation name="reject">
                <auth permissions="ErpPurReceive:approve"/>
            <arg name="id" type="String" mandatory="true"/>
            <arg name="svcCtx" kind="ServiceContext"/>
            <return>
                <schema bizObjName="THIS_OBJ"/>
            </return>
            <source><c:script><![CDATA[
                return inject('app.erp.pur.service.processor.ErpPurReceiveRejectProcessor').reject(id, svcCtx);
            ]]></c:script></source>
        </mutation>
        <mutation name="withdrawApproval">
            <auth permissions="ErpPurReceive:reverseApprove"/>
            <arg name="id" type="String" mandatory="true"/>
            <arg name="svcCtx" kind="ServiceContext"/>
            <return>
                <schema bizObjName="THIS_OBJ"/>
            </return>
            <source><c:script><![CDATA[
                return inject('app.erp.pur.service.processor.ErpPurReceiveWithdrawApprovalProcessor').withdrawApproval(id, svcCtx);
            ]]></c:script></source>
        </mutation>
    </actions>
</biz>
