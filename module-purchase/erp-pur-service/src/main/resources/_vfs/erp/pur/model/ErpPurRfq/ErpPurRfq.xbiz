<?xml version="1.0" encoding="UTF-8" ?>
<biz x:schema="/nop/schema/biz/xbiz.xdef" xmlns:x="/nop/schema/xdsl.xdef" x:extends="_ErpPurRfq.xbiz">

    <actions>
        <mutation name="submitForApproval">
            <arg name="id" type="String" mandatory="true"/>
            <arg name="svcCtx" kind="ServiceContext"/>
            <return>
                <schema bizObjName="THIS_OBJ"/>
            </return>
            <source><![CDATA[
                const entity = thisObj.invoke("requireEntity", {id}, null, svcCtx);
                entity.approveStatus = thisObj.invoke("prepareSubmit",
                    {code: entity.code, approveStatus: entity.approveStatus, docStatus: entity.docStatus}, null, svcCtx);
                return entity;
            ]]></source>
        </mutation>
        <mutation name="approve">
            <auth permissions="ErpPurRfq:approve"/>
            <arg name="id" type="String" mandatory="true"/>
            <arg name="svcCtx" kind="ServiceContext"/>
            <return>
                <schema bizObjName="THIS_OBJ"/>
            </return>
            <source><![CDATA[
                const entity = thisObj.invoke("requireEntity", {id}, null, svcCtx);
                entity.approveStatus = thisObj.invoke("prepareApprove",
                    {code: entity.code, approveStatus: entity.approveStatus, docStatus: entity.docStatus}, null, svcCtx);
                entity.approvedBy = svcCtx.getUserId();
                entity.approvedAt = now();
                return entity;
            ]]></source>
        </mutation>
        <mutation name="reject">
            <arg name="id" type="String" mandatory="true"/>
            <arg name="svcCtx" kind="ServiceContext"/>
            <return>
                <schema bizObjName="THIS_OBJ"/>
            </return>
            <source><![CDATA[
                const entity = thisObj.invoke("requireEntity", {id}, null, svcCtx);
                entity.approveStatus = thisObj.invoke("prepareReject",
                    {code: entity.code, approveStatus: entity.approveStatus, docStatus: entity.docStatus}, null, svcCtx);
                entity.approvedBy = svcCtx.getUserId();
                entity.approvedAt = now();
                return entity;
            ]]></source>
        </mutation>
        <mutation name="reverseApprove">
            <auth permissions="ErpPurRfq:reverseApprove"/>
            <arg name="id" type="String" mandatory="true"/>
            <arg name="svcCtx" kind="ServiceContext"/>
            <return>
                <schema bizObjName="THIS_OBJ"/>
            </return>
            <source><![CDATA[
                const entity = thisObj.invoke("requireEntity", {id}, null, svcCtx);
                entity.approveStatus = thisObj.invoke("prepareReverseApprove",
                    {code: entity.code, approveStatus: entity.approveStatus, docStatus: entity.docStatus}, null, svcCtx);
                entity.approvedBy = null;
                entity.approvedAt = null;
                return entity;
            ]]></source>
        </mutation>
        <mutation name="withdrawApproval">
            <arg name="id" type="String" mandatory="true"/>
            <arg name="svcCtx" kind="ServiceContext"/>
            <return>
                <schema bizObjName="THIS_OBJ"/>
            </return>
            <source><![CDATA[
                const entity = thisObj.invoke("requireEntity", {id}, null, svcCtx);
                entity.approveStatus = thisObj.invoke("prepareWithdraw",
                    {code: entity.code, approveStatus: entity.approveStatus, docStatus: entity.docStatus}, null, svcCtx);
                return entity;
            ]]></source>
        </mutation>
    </actions>
</biz>
