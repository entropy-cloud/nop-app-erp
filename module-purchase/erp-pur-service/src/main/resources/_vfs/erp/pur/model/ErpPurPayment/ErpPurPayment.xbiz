<?xml version="1.0" encoding="UTF-8" ?>
<biz x:schema="/nop/schema/biz/xbiz.xdef" xmlns:x="/nop/schema/xdsl.xdef" xmlns:c="c" x:extends="_ErpPurPayment.xbiz">

    <actions>
        <mutation name="submitForApproval">
            <arg name="id" type="String" mandatory="true"/>
            <arg name="svcCtx" kind="ServiceContext"/>
            <return>
                <schema bizObjName="THIS_OBJ"/>
            </return>
            <source><c:script><![CDATA[
                import io.nop.wf.core.support.ApprovalFlowHelper;
                // Processor 全权处理状态守卫 + 业务校验 + setApproveStatus=SUBMITTED + 保存（DIRECT/WORKFLOW 无感）。
                const entity = inject('app.erp.pur.service.processor.ErpPurPaymentSubmitForApprovalProcessor').submitForApproval(id, svcCtx);
                // WORKFLOW 模式：xmeta 配 wf:wfName 时启动 wf 实例并绑 nopFlowId。
                // bizObjId 显式转 String：平台 approval-support.xbiz 标准 source 传 entity.id（Long），
                // 而 WorkflowEngineImpl.removeStdStartParam 强制 (String) 会 CCE，故应用层适配。
                const wfName = thisObj.objMeta['wf:wfName'];
                if (wfName) {
                    const wfManager = inject('nopWorkflowManager');
                    const wf = wfManager.newWorkflow(wfName, null);
                    ApprovalFlowHelper.start(wf, {bizObjName: thisObj.bizObjName, bizObjId: '' + entity.id}, svcCtx);
                }
                return entity;
            ]]></c:script></source>
        </mutation>
        <mutation name="approve">
            <arg name="id" type="String" mandatory="true"/>
            <arg name="svcCtx" kind="ServiceContext"/>
            <return>
                <schema bizObjName="THIS_OBJ"/>
            </return>
            <source><c:script><![CDATA[
                return inject('app.erp.pur.service.processor.ErpPurPaymentApproveProcessor').approve(id, svcCtx);
            ]]></c:script></source>
        </mutation>
        <mutation name="reverseApprove">
            <arg name="id" type="String" mandatory="true"/>
            <arg name="svcCtx" kind="ServiceContext"/>
            <return>
                <schema bizObjName="THIS_OBJ"/>
            </return>
            <source><c:script><![CDATA[
                return inject('app.erp.pur.service.processor.ErpPurPaymentReverseApproveProcessor').reverseApprove(id, svcCtx);
            ]]></c:script></source>
        </mutation>
            <mutation name="reject">
            <arg name="id" type="String" mandatory="true"/>
            <arg name="svcCtx" kind="ServiceContext"/>
            <return>
                <schema bizObjName="THIS_OBJ"/>
            </return>
            <source><![CDATA[
                const entity = thisObj.invoke("requireEntity", {id}, null, svcCtx);
                const status = entity.approveStatus;

                if (status !== 'SUBMITTED') {
                    throw new NopScriptError("nop.err.wf.approve.invalid-status")
                        .param("bizObjName", thisObj.bizObjName)
                        .param("bizObjId", entity.id)
                        .param("action", "reject")
                        .param("currentStatus", status)
                        .param("expectedStatus", "SUBMITTED");
                }

                entity.approveStatus = 'REJECTED';
                entity.approvedBy = svcCtx.getUserId();
                entity.approvedAt = now();
                return entity;
            ]]></source>
        </mutation>
        <mutation name="withdrawApproval">
            <arg name="id" type="String" mandatory="true"/>
            <arg name="svcCtx" kind="ServiceContext"/>
            <return>
                <schema bizObjName="THIS_OBJ"/>
            </return>
            <source><![CDATA[
                const entity = thisObj.invoke("requireEntity", {id}, null, svcCtx);
                const status = entity.approveStatus;

                if (status !== 'SUBMITTED') {
                    throw new NopScriptError("nop.err.wf.approve.invalid-status")
                        .param("bizObjName", thisObj.bizObjName)
                        .param("bizObjId", entity.id)
                        .param("action", "withdrawApproval")
                        .param("currentStatus", status)
                        .param("expectedStatus", "SUBMITTED");
                }

                entity.approveStatus = 'UNSUBMITTED';
                return entity;
            ]]></source>
        </mutation>
    </actions>
</biz>
