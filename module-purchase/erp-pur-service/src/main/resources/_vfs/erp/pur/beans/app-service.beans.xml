<?xml version="1.0" encoding="UTF-8" ?>
<beans x:schema="/nop/schema/beans.xdef" xmlns:x="/nop/schema/xdsl.xdef"
       xmlns="http://www.springframework.org/schema/beans" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans
        http://www.springframework.org/schema/beans/spring-beans-2.5.xsd">

    <import resource="_dao.beans.xml"/>

    <import resource="_service.beans.xml"/>

    <!-- 采购域服务（非 BizModel）：入库移动单请求构造器 -->
    <bean id="app.erp.pur.service.entity.ReceiveStockMoveBuilder"
          class="app.erp.pur.service.entity.ReceiveStockMoveBuilder"/>

    <!-- 采购域服务（非 BizModel）：退货出库移动单请求构造器（OUTGOING，sourceWarehouse=退货仓库） -->
    <bean id="app.erp.pur.service.entity.ReturnStockMoveBuilder"
          class="app.erp.pur.service.entity.ReturnStockMoveBuilder"/>

    <!-- 采购域服务（非 BizModel）：退货数量上限校验器（按入库行聚合已审核退货量） -->
    <bean id="app.erp.pur.service.entity.ReturnQtyValidator"
          class="app.erp.pur.service.entity.ReturnQtyValidator"/>

    <!-- 采购域服务（非 BizModel）：请购→订单转化组装器 -->
    <bean id="app.erp.pur.service.entity.RequisitionToOrderConverter"
          class="app.erp.pur.service.entity.RequisitionToOrderConverter"/>

    <!-- 采购域服务（非 BizModel）：三单匹配器（发票审核校验 订单↔入库↔发票） -->
    <bean id="app.erp.pur.service.entity.ThreeWayMatcher"
          class="app.erp.pur.service.entity.ThreeWayMatcher"/>

    <!-- 采购业财过账 Provider（注册为 Bean 后由 ErpFinAcctDocRegistry 自动聚合，处理 AP_INVOICE/PAYMENT） -->
    <bean id="app.erp.pur.service.posting.PurAcctDocProvider"
          class="app.erp.pur.service.posting.PurAcctDocProvider"/>

    <!-- 采购过账执行器（跨域经 IErpFinVoucherBiz Facade，REQUIRES_NEW 由 Facade 承接，自身无 @Transactional） -->
    <bean id="app.erp.pur.service.posting.PurPostingExecutor"
          class="app.erp.pur.service.posting.PurPostingExecutor"/>

    <!-- 采购发票过账派发器（APPROVED→AP_INVOICE 凭证；失败吞异常保持终态 posted=false） -->
    <bean id="app.erp.pur.service.posting.PurInvoicePostingDispatcher"
          class="app.erp.pur.service.posting.PurInvoicePostingDispatcher"/>

    <!-- 采购退货过账派发器（APPROVED→PURCHASE_RETURN 红字冲减凭证 借暂估应付/贷存货；失败吞异常保持终态 posted=false） -->
    <bean id="app.erp.pur.service.posting.PurReturnPostingDispatcher"
          class="app.erp.pur.service.posting.PurReturnPostingDispatcher"/>

    <!-- 付款单过账派发器（APPROVED→PAYMENT 凭证 借应付/贷银行存款；失败吞异常保持终态 posted=false） -->
    <bean id="app.erp.pur.service.posting.PurPaymentPostingDispatcher"
          class="app.erp.pur.service.posting.PurPaymentPostingDispatcher"/>

    <!-- 采购域凭证红冲监听者（业财闭环方向二：财务侧红冲→采购单据回退 posted=false + approveStatus→REJECTED）。
         注册为 Bean 后由 finance ErpFinReversalListenerRegistry 自动聚合，处理 AP_INVOICE/PAYMENT/PURCHASE_RETURN/PURCHASE_INPUT。 -->
    <bean id="app.erp.pur.service.posting.PurReversalListener"
          class="app.erp.pur.service.posting.PurReversalListener"/>

    <!-- 付款→发票域级核销器（ErpPurPaymentLine 多对多，回写 paidStatus/paidAmount/writtenOffStatus） -->
    <bean id="app.erp.pur.service.entity.PaymentSettler"
          class="app.erp.pur.service.entity.PaymentSettler"/>

    <!-- 采购域审批状态机编排 Processor（Facade + Processor 两层结构，protected step 方法供下游覆盖） -->
    <bean id="app.erp.pur.service.processor.ErpPurOrderProcessor"
          class="app.erp.pur.service.processor.ErpPurOrderProcessor"/>
    <bean id="app.erp.pur.service.processor.ErpPurRequisitionProcessor"
          class="app.erp.pur.service.processor.ErpPurRequisitionProcessor"/>
    <bean id="app.erp.pur.service.processor.ErpPurReceiveProcessor"
          class="app.erp.pur.service.processor.ErpPurReceiveProcessor"/>
    <bean id="app.erp.pur.service.processor.ErpPurReturnProcessor"
          class="app.erp.pur.service.processor.ErpPurReturnProcessor"/>
    <bean id="app.erp.pur.service.processor.ErpPurInvoiceProcessor"
          class="app.erp.pur.service.processor.ErpPurInvoiceProcessor"/>
    <bean id="app.erp.pur.service.processor.ErpPurPaymentProcessor"
          class="app.erp.pur.service.processor.ErpPurPaymentProcessor"/>

    <!-- 供应商评分卡周期评分计算器（criteria×formula×weight→totalScore→standing，公式经 XLang 表达式） -->
    <bean id="app.erp.pur.service.entity.ScorecardCalculator"
          class="app.erp.pur.service.entity.ScorecardCalculator"/>

    <!-- 评分卡 standing=RED → AVL SUSPENDED 跨域联动桥（purchase→master-data I*Biz，下游可派生覆盖联动策略） -->
    <bean id="app.erp.pur.service.ScorecardStandingLinker"
          class="app.erp.pur.service.ScorecardStandingLinker"/>

    <!-- 供应商询价/报价准入资格校验器（AVL 准入状态 + 评分 standing 三档联动 prevent/warn/allow） -->
    <bean id="app.erp.pur.service.SupplierEligibilityChecker"
          class="app.erp.pur.service.SupplierEligibilityChecker"/>

    <!-- 采购看板聚合入口（plan 2026-07-06-0935-1）：非实体 BizModel，注入 IDaoProvider/IOrmTemplate/IErpFinArApItemBiz，
         经 @BizQuery 暴露 getDashboardKpi/getDashboardTrend/findVendorTopN/findThreeWayMatchDiffAlert/findApOverdueAlert。 -->
    <bean id="app.erp.pur.service.dashboard.ErpPurDashboardBizModel" ioc:type="@bean:id"/>

    <!-- per-mutation Processor beans (plan 2026-07-25-1057-2) -->
    <bean id="app.erp.pur.service.processor.ErpPurOrderSubmitForApprovalProcessor"
          class="app.erp.pur.service.processor.ErpPurOrderSubmitForApprovalProcessor"/>
    <bean id="app.erp.pur.service.processor.ErpPurOrderApproveProcessor"
          class="app.erp.pur.service.processor.ErpPurOrderApproveProcessor"/>
    <bean id="app.erp.pur.service.processor.ErpPurOrderRejectProcessor"
          class="app.erp.pur.service.processor.ErpPurOrderRejectProcessor"/>
    <bean id="app.erp.pur.service.processor.ErpPurOrderReverseApproveProcessor"
          class="app.erp.pur.service.processor.ErpPurOrderReverseApproveProcessor"/>
    <bean id="app.erp.pur.service.processor.ErpPurOrderWithdrawApprovalProcessor"
          class="app.erp.pur.service.processor.ErpPurOrderWithdrawApprovalProcessor"/>
    <bean id="app.erp.pur.service.processor.ErpPurOrderCancelProcessor"
          class="app.erp.pur.service.processor.ErpPurOrderCancelProcessor"/>
    <bean id="app.erp.pur.service.processor.ErpPurRequisitionSubmitForApprovalProcessor"
          class="app.erp.pur.service.processor.ErpPurRequisitionSubmitForApprovalProcessor"/>
    <bean id="app.erp.pur.service.processor.ErpPurRequisitionApproveProcessor"
          class="app.erp.pur.service.processor.ErpPurRequisitionApproveProcessor"/>
    <bean id="app.erp.pur.service.processor.ErpPurRequisitionRejectProcessor"
          class="app.erp.pur.service.processor.ErpPurRequisitionRejectProcessor"/>
    <bean id="app.erp.pur.service.processor.ErpPurRequisitionReverseApproveProcessor"
          class="app.erp.pur.service.processor.ErpPurRequisitionReverseApproveProcessor"/>
    <bean id="app.erp.pur.service.processor.ErpPurRequisitionWithdrawApprovalProcessor"
          class="app.erp.pur.service.processor.ErpPurRequisitionWithdrawApprovalProcessor"/>
    <bean id="app.erp.pur.service.processor.ErpPurRequisitionCancelProcessor"
          class="app.erp.pur.service.processor.ErpPurRequisitionCancelProcessor"/>
    <bean id="app.erp.pur.service.processor.ErpPurReceiveSubmitForApprovalProcessor"
          class="app.erp.pur.service.processor.ErpPurReceiveSubmitForApprovalProcessor"/>
    <bean id="app.erp.pur.service.processor.ErpPurReceiveApproveProcessor"
          class="app.erp.pur.service.processor.ErpPurReceiveApproveProcessor"/>
    <bean id="app.erp.pur.service.processor.ErpPurReceiveRejectProcessor"
          class="app.erp.pur.service.processor.ErpPurReceiveRejectProcessor"/>
    <bean id="app.erp.pur.service.processor.ErpPurReceiveReverseApproveProcessor"
          class="app.erp.pur.service.processor.ErpPurReceiveReverseApproveProcessor"/>
    <bean id="app.erp.pur.service.processor.ErpPurReceiveWithdrawApprovalProcessor"
          class="app.erp.pur.service.processor.ErpPurReceiveWithdrawApprovalProcessor"/>
    <bean id="app.erp.pur.service.processor.ErpPurReceiveCancelProcessor"
          class="app.erp.pur.service.processor.ErpPurReceiveCancelProcessor"/>
    <bean id="app.erp.pur.service.processor.ErpPurReturnSubmitForApprovalProcessor"
          class="app.erp.pur.service.processor.ErpPurReturnSubmitForApprovalProcessor"/>
    <bean id="app.erp.pur.service.processor.ErpPurReturnApproveProcessor"
          class="app.erp.pur.service.processor.ErpPurReturnApproveProcessor"/>
    <bean id="app.erp.pur.service.processor.ErpPurReturnRejectProcessor"
          class="app.erp.pur.service.processor.ErpPurReturnRejectProcessor"/>
    <bean id="app.erp.pur.service.processor.ErpPurReturnReverseApproveProcessor"
          class="app.erp.pur.service.processor.ErpPurReturnReverseApproveProcessor"/>
    <bean id="app.erp.pur.service.processor.ErpPurReturnWithdrawApprovalProcessor"
          class="app.erp.pur.service.processor.ErpPurReturnWithdrawApprovalProcessor"/>
    <bean id="app.erp.pur.service.processor.ErpPurReturnCancelProcessor"
          class="app.erp.pur.service.processor.ErpPurReturnCancelProcessor"/>
    <bean id="app.erp.pur.service.processor.ErpPurInvoiceSubmitForApprovalProcessor"
          class="app.erp.pur.service.processor.ErpPurInvoiceSubmitForApprovalProcessor"/>
    <bean id="app.erp.pur.service.processor.ErpPurInvoiceApproveProcessor"
          class="app.erp.pur.service.processor.ErpPurInvoiceApproveProcessor"/>
    <bean id="app.erp.pur.service.processor.ErpPurInvoiceRejectProcessor"
          class="app.erp.pur.service.processor.ErpPurInvoiceRejectProcessor"/>
    <bean id="app.erp.pur.service.processor.ErpPurInvoiceReverseApproveProcessor"
          class="app.erp.pur.service.processor.ErpPurInvoiceReverseApproveProcessor"/>
    <bean id="app.erp.pur.service.processor.ErpPurInvoiceWithdrawApprovalProcessor"
          class="app.erp.pur.service.processor.ErpPurInvoiceWithdrawApprovalProcessor"/>
    <bean id="app.erp.pur.service.processor.ErpPurInvoiceCancelProcessor"
          class="app.erp.pur.service.processor.ErpPurInvoiceCancelProcessor"/>
    <bean id="app.erp.pur.service.processor.ErpPurPaymentSubmitForApprovalProcessor"
          class="app.erp.pur.service.processor.ErpPurPaymentSubmitForApprovalProcessor"/>
    <bean id="app.erp.pur.service.processor.ErpPurPaymentApproveProcessor"
          class="app.erp.pur.service.processor.ErpPurPaymentApproveProcessor"/>
    <bean id="app.erp.pur.service.processor.ErpPurPaymentRejectProcessor"
          class="app.erp.pur.service.processor.ErpPurPaymentRejectProcessor"/>
    <bean id="app.erp.pur.service.processor.ErpPurPaymentReverseApproveProcessor"
          class="app.erp.pur.service.processor.ErpPurPaymentReverseApproveProcessor"/>
    <bean id="app.erp.pur.service.processor.ErpPurPaymentWithdrawApprovalProcessor"
          class="app.erp.pur.service.processor.ErpPurPaymentWithdrawApprovalProcessor"/>
    <bean id="app.erp.pur.service.processor.ErpPurPaymentCancelProcessor"
          class="app.erp.pur.service.processor.ErpPurPaymentCancelProcessor"/>
    <!-- Payment D-mutation per-mutation Processor (R6.5) -->
    <bean id="app.erp.pur.service.processor.ErpPurPaymentSettleProcessor"
          class="app.erp.pur.service.processor.ErpPurPaymentSettleProcessor"/>
    <bean id="app.erp.pur.service.processor.ErpPurPaymentReverseSettlementProcessor"
          class="app.erp.pur.service.processor.ErpPurPaymentReverseSettlementProcessor"/>
    <!-- SupplierScorecard D-mutation per-mutation Processor (R6.5 类别 B) -->
    <bean id="app.erp.pur.service.processor.ErpPurSupplierScorecardFinalizeScorecardProcessor"
          class="app.erp.pur.service.processor.ErpPurSupplierScorecardFinalizeScorecardProcessor"/>

    <!-- 实体级 StateMachine Bean（契约 docs/architecture/entity-state-machine-bean.md §5）：一 Bean 对应
         一实体一轴。docStatus 业务生命周期轴 Bean（M2.5/M2.6/M2.7/M2.8），承载 DRAFT→CANCELLED 最小迁移矩阵 +
         终态/初始态分类 + 只读元数据。approveStatus 审批轴归 M3.2-M3.5 各自独立 Bean（命名带 Approval 后缀）。
         按类型注入（@Inject 非 private，合规 R5）；Delta 同名 Bean 覆盖路径见契约 §6。 -->
    <bean id="app.erp.pur.service.statemachine.ErpPurOrderDocumentStateMachine"
          class="app.erp.pur.service.statemachine.ErpPurOrderDocumentStateMachine"/>
    <bean id="app.erp.pur.service.statemachine.ErpPurRequisitionDocumentStateMachine"
          class="app.erp.pur.service.statemachine.ErpPurRequisitionDocumentStateMachine"/>
    <bean id="app.erp.pur.service.statemachine.ErpPurQuotationDocumentStateMachine"
          class="app.erp.pur.service.statemachine.ErpPurQuotationDocumentStateMachine"/>
    <bean id="app.erp.pur.service.statemachine.ErpPurRfqDocumentStateMachine"
          class="app.erp.pur.service.statemachine.ErpPurRfqDocumentStateMachine"/>
</beans>