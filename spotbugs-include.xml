<!--
    SpotBugs / FindSecBugs 包含过滤器（MQ Q2）。
    实施契约：docs/architecture/quality-engineering/security-scanning.md §6.2 step 1。
    作用：scope SpotBugs 报告到 FindSecBugs 安全规则模式（includeFilterFile 选择启用哪些
    BugPattern），避免安全基线被 SpotBugs 通用代码质量规则（PERFORMANCE/STYLE/BAD_PRACTICE）稀释。
    FindSecBugs 探测器经 findsecbugs-plugin JAR 依赖自动注册（-X debug 已确认 1.13.0 加载到
    spotbugs classpath）；本文件进一步将报告范围限定到 139 个 FindSecBugs 安全 BugPattern 类型。
    生成方式：从 findsecbugs-plugin-1.13.0.jar!/findbugs.xml 提取全部 BugPattern type（版本绑定，
    升级 findsecbugs 时须重新生成以纳入新增规则类型）。
-->
<FindBugsFilter xmlns="https://github.com/spotbugs/filter/3.0.0">
    <Match>
