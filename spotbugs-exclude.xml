<?xml version="1.0" encoding="UTF-8"?>
<!--
    SpotBugs / FindSecBugs 排除过滤器（MQ Q2）。
    实施契约：docs/architecture/quality-engineering/security-scanning.md §6.2 step 2。
    排除 Nop 代码生成产物三类（对齐 Q1 pitest excludedClasses 先例 +
    mutation-testing.md §1.3 三类 352 生成类），避免规则违规被生成代码噪声主导。
    D 类（生成代码噪声）经此文件在扫描阶段排除，不纳入基线（设计文档 §5.1）。
    B 类（误报）排除项在 §5.1 分类后按 <Match> 元素追加到本文件，注明理由。

    三类生成包：
      - *.dao.entity._gen.*       （_gen 包，实体生成类）
      - *.dao.entity._gen._*      （_gen 子包内部类）
      - *.api.beans.*             （API beans 生成类）
      - *.api.crud.*              （API crud 生成类）
-->
<FindBugsFilter xmlns="https://github.com/spotbugs/filter/3.0.0"
                xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                xsi:schemaLocation="https://github.com/spotbugs/filter/3.0.0 https://raw.githubusercontent.com/spotbugs/spotbugs/3.1.0/spotbugs/etc/findbugsfilter.xsd">

    <!-- D 类：Nop 代码生成产物 _gen 包（实体生成类，designated by __XGEN_FORCE_OVERRIDE__） -->
    <Match>
        <Class name="~.*\.dao\.entity\._gen\..*"/>
    </Match>

    <!-- D 类：Nop 代码生成产物 api.beans 包（API beans 生成类） -->
    <Match>
        <Class name="~.*\.api\.beans\..*"/>
    </Match>

    <!-- D 类：Nop 代码生成产物 api.crud 包（API crud 生成类） -->
    <Match>
        <Class name="~.*\.api\.crud\..*"/>
    </Match>

    <!-- D 类：codegen 包（代码生成入口产物） -->
    <Match>
        <Class name="~.*\.codegen\..*"/>
    </Match>

</FindBugsFilter>
