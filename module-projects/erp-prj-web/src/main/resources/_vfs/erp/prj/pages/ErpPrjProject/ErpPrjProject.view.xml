<?xml version="1.0" encoding="UTF-8" ?>
<view xmlns:i18n-en="i18n-en" x:extends="_gen/_ErpPrjProject.view.xml" x:schema="/nop/schema/xui/xview.xdef" xmlns:x="/nop/schema/xdsl.xdef">
    <controlLib>/erp/xlib/control.xlib</controlLib>

    <grids>
        <grid id="list">
            <cols x:override="bounded-merge">
                <col id="id" mandatory="true" ui:number="true" sortable="true"/>
                <col id="code" mandatory="true" sortable="true"/>
                <col id="name" mandatory="true" sortable="true"/>
                <col id="orgId" label="业务组织" i18n-en:label="Business Org"/>
                <col id="projectTypeId" label="项目类型" i18n-en:label="Project Type"/>
                <col id="customerId" label="客户" i18n-en:label="Customer"/>
                <col id="currencyId" label="币种" i18n-en:label="Currency"/>
                <col id="managerId" label="项目经理" i18n-en:label="Project Manager"/>
                <col id="startDate" sortable="true" align="center"></col>
                <col id="endDate" sortable="true" align="center"></col>
                <col id="budget" sortable="true"/>
                <col id="actualCost" sortable="true" align="right" domain="amount"></col>
                <col id="billedAmount" sortable="true" align="right" domain="amount"></col>
                <col id="status" mandatory="true" sortable="true">
                    <gen-control>
                        <c:script><![CDATA[
                            const valueProp = dispMeta?.id || 'status';
                            const labelProp = propMeta?.['graphql:labelProp'] || (valueProp + '_label');
                            const successVals = ['COMPLETED','APPROVED','RECEIVED','DELIVERED','PAID','SETTLED','HONORED','RETRIED','EXECUTED','COMPUTED','CONFIRMED','RUNNING','MATERIAL_TRANSFERRED','ACTIVE','CLOSED','DONE','SUCCESS'];
                            const dangerVals = ['REJECTED','CANCELLED','FAILED','DISHONORED','OVERDUE','DOWN','TERMINATED','WRITE_OFF'];
                            const warningVals = ['ON_HOLD','SUSPENDED','EXPIRED','RETRYING'];
                            const primaryVals = ['SUBMITTED','IN_PROGRESS','PARTIAL','PARTIALLY_TRANSFERRED','WORK_IN_PROGRESS','PROCESSING','NEGOTIATION','OPEN','UNDER_MAINTENANCE','COLLECTION_PENDING','DISCOUNTED','ENDORSED','ISSUED'];
                            function quote(v){return "'" + v + "'";}
                            function inList(vals){return "[" + vals.map(quote).join(",") + "].indexOf(" + valueProp + ") >= 0";}
                            const expr = inList(successVals) + " ? 'success' : "
                                + inList(dangerVals) + " ? 'danger' : "
                                + inList(warningVals) + " ? 'warning' : "
                                + inList(primaryVals) + " ? 'primary' : 'default'";
                            return {
                                type: "tpl",
                                tpl: '<span class="label label-${' + expr + "}"
                                    + ">"
                                    + "${" + labelProp + "}</span>"
                            };
                        ]]></c:script>
                    </gen-control>
                </col>
            </cols>
        </grid>
        <grid id="pick-list">
            <cols x:override="bounded-merge">
                <col id="id" mandatory="true" ui:number="true" sortable="true"/>
                <col id="code" mandatory="true" sortable="true"/>
                <col id="name" mandatory="true" sortable="true"/>
                <col id="projectTypeId" label="项目类型" i18n-en:label="Project Type"/>
                <col id="status" mandatory="true" sortable="true">
                    <gen-control>
                        <c:script><![CDATA[
                            const valueProp = dispMeta?.id || 'status';
                            const labelProp = propMeta?.['graphql:labelProp'] || (valueProp + '_label');
                            return {
                                type: "tpl",
                                tpl: '<span class="label label-${' + valueProp
                                    + " == 'ACTIVE' || " + valueProp + " == 'OPEN' ? 'primary' : 'default'}\">"
                                    + "${" + labelProp + "}</span>"
                            };
                        ]]></c:script>
                    </gen-control>
                </col>
                <col id="startDate" sortable="true" align="center"></col>
                <col id="endDate" sortable="true" align="center"></col>
            </cols>
        </grid>
    </grids>

    <forms>
        <form id="view" layoutControl="tabs">
            <layout x:override="replace">
==========>baseInfo[基本信息]======
 code[项目编码] name[项目名称]
 orgId[业务组织] projectTypeId[项目类型]
 customerId[客户] status[状态]
==========>schedule[进度信息]======
 startDate[开始日期] endDate[结束日期]
 managerId[项目经理(职员)]
==========>finance[财务信息]======
 currencyId[币种] budget[预算总额]
 committedCost[已承诺成本] actualCost[实际成本]
 billedAmount[已开票金额]
==========^audit[审计信息]=========
 remark[备注]
 createdBy[创建人] createTime[创建时间]
 updatedBy[修改人] updateTime[修改时间]
            </layout>
        </form>
        <form id="edit" layoutControl="tabs">
            <layout x:override="replace">
==========>baseInfo[基本信息]======
 code[项目编码] name[项目名称]
 orgId[业务组织] projectTypeId[项目类型]
 customerId[客户] status[状态]
==========>schedule[进度信息]======
 startDate[开始日期] endDate[结束日期]
 managerId[项目经理(职员)]
==========>finance[财务信息]======
 currencyId[币种] budget[预算总额]
 committedCost[已承诺成本] actualCost[实际成本]
 billedAmount[已开票金额]
 remark[备注](2)
            </layout>
        </form>
        <form id="add"/>
        <form id="query" editMode="query" title="查询条件" i18n-en:title="Query Condition">
            <layout>
 code[项目编码] name[项目名称]
 status[状态] customerId[客户]
            </layout>
            <cells>
                <cell id="code" filterOp="like"/>
                <cell id="name" filterOp="like"/>
            </cells>
        </form>
        <form id="pick-query" editMode="query" title="查询条件" i18n-en:title="Query Condition">
            <layout>
 code[项目编码] name[项目名称]
 projectTypeId[项目类型] status[状态]
            </layout>
            <cells>
                <cell id="code" filterOp="like"/>
                <cell id="name" filterOp="like"/>
                <cell id="projectTypeId" filterOp="eq"/>
                <cell id="status" filterOp="eq"/>
            </cells>
        </form>
    </forms>

    <pages>
        <crud name="main">
            <rowActions x:override="bounded-merge">
                <action id="row-view-button"/>
                <action id="row-update-button" actionType="drawer"/>
                <action id="row-start-button" label="启动" i18n-en:label="Launch" level="primary" icon="fa fa-play">
                    <api url="@mutation:ErpPrjProject__startProject?projectId=$id"/>
                    <confirmText>确认启动此项目？</confirmText>
                    <messages>
                        <success>项目已启动</success>
                    </messages>
                    <visibleOn>${status == 'DRAFT'}</visibleOn>
                </action>
                <action id="row-hold-button" label="暂停" i18n-en:label="Pause" level="warning" icon="fa fa-pause">
                    <api url="@mutation:ErpPrjProject__holdProject?projectId=$id"/>
                    <confirmText>确认暂停此项目？</confirmText>
                    <messages>
                        <success>项目已暂停</success>
                    </messages>
                    <visibleOn>${status == 'OPEN'}</visibleOn>
                </action>
                <action id="row-resume-button" label="恢复" i18n-en:label="Restore" level="primary" icon="fa fa-play">
                    <api url="@mutation:ErpPrjProject__resumeProject?projectId=$id"/>
                    <confirmText>确认恢复此项目？</confirmText>
                    <messages>
                        <success>项目已恢复</success>
                    </messages>
                    <visibleOn>${status == 'ON_HOLD'}</visibleOn>
                </action>
                <action id="row-complete-button" label="完成" i18n-en:label="Complete" level="success" icon="fa fa-check">
                    <api url="@mutation:ErpPrjProject__closeProject?projectId=$id"/>
                    <confirmText>确认完成此项目？</confirmText>
                    <messages>
                        <success>项目已完成</success>
                    </messages>
                    <visibleOn>${status == 'OPEN'}</visibleOn>
                </action>
                <action id="row-cancel-button" label="作废" i18n-en:label="Void" level="danger" icon="fa fa-ban">
                    <api url="@mutation:ErpPrjProject__cancelProject?projectId=$id"/>
                    <confirmText>确认作废此项目？</confirmText>
                    <messages>
                        <success>项目已作废</success>
                    </messages>
                    <visibleOn>${status != 'COMPLETED' &amp;&amp; status != 'CANCELLED'}</visibleOn>
                </action>
                <action id="row-create-task-button" label="创建任务" i18n-en:label="Create Task" level="primary" icon="fa fa-plus"
                        tooltip="跳转到任务列表（带项目上下文筛选），新建任务时自动预填项目"
                        link="/ErpPrjTask-main?filter_projectId=${id}">
                    <visibleOn>${status == 'OPEN'}</visibleOn>
                </action>
                <action id="row-view-task-button" label="项目任务" i18n-en:label="Project Tasks" level="info" icon="fa fa-tasks"
                        actionType="drawer">
                    <drawer page="/erp/prj/pages/ErpPrjTask/ref-project.page.yaml" size="xl">
                        <data>
                            <projectId>${id}</projectId>
                        </data>
                    </drawer>
                </action>
                <action id="row-view-timesheet-button" label="项目工时" i18n-en:label="Project Timesheets" level="info" icon="fa fa-clock-o"
                        actionType="drawer">
                    <drawer page="/erp/prj/pages/ErpPrjTimesheet/ref-project.page.yaml" size="xl">
                        <data>
                            <projectId>${id}</projectId>
                        </data>
                    </drawer>
                </action>
                <action id="row-view-member-button" label="项目成员" i18n-en:label="Project Members" level="info" icon="fa fa-users"
                        actionType="drawer">
                    <drawer page="/erp/prj/pages/ErpPrjProjectUser/ref-project.page.yaml" size="xl">
                        <data>
                            <projectId>${id}</projectId>
                        </data>
                    </drawer>
                </action>
                <action id="row-view-budget-button" label="项目预算" i18n-en:label="Project Budgets" level="info" icon="fa fa-money"
                        actionType="drawer">
                    <drawer page="/erp/prj/pages/ErpPrjBudget/ref-project.page.yaml" size="xl">
                        <data>
                            <projectId>${id}</projectId>
                        </data>
                    </drawer>
                </action>
                <action id="row-view-milestone-button" label="项目里程碑" i18n-en:label="Project Milestones" level="info" icon="fa fa-flag"
                        actionType="drawer">
                    <drawer page="/erp/prj/pages/ErpPrjMilestone/ref-project.page.yaml" size="xl">
                        <data>
                            <projectId>${id}</projectId>
                        </data>
                    </drawer>
                </action>
                <action id="row-delete-button"/>
            </rowActions>
        </crud>
        <picker name="picker" filterForm="pick-query"/>
    </pages>
</view>