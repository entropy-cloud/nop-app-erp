<?xml version="1.0" encoding="UTF-8" ?>
<beans x:schema="/nop/schema/beans.xdef" xmlns:x="/nop/schema/xdsl.xdef"
       xmlns="http://www.springframework.org/schema/beans" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans
        http://www.springframework.org/schema/beans/spring-beans-2.5.xsd">

    <import resource="_dao.beans.xml"/>

    <import resource="_service.beans.xml"/>

    <!-- 实体级 StateMachine Bean（契约 docs/architecture/entity-state-machine-bean.md §5）：每 Bean 对应
          一个实体的一条状态轴。按类型注入 BizModel/Processor；Delta 同名 bean id 覆盖替换基线矩阵（§6）。 -->
    <bean id="app.erp.prj.service.statemachine.ErpPrjTaskStateMachine"
          class="app.erp.prj.service.statemachine.ErpPrjTaskStateMachine"/>
    <bean id="app.erp.prj.service.statemachine.ErpPrjProjectStateMachine"
          class="app.erp.prj.service.statemachine.ErpPrjProjectStateMachine"/>

    <!-- 项目业财过账：执行器 + 工时派发器 + PROJECT_COST_COLLECTION Provider（Registry 容器级 collect-by-type 自动收录） -->
    <bean id="app.erp.prj.service.posting.ProjectPostingExecutor"
          class="app.erp.prj.service.posting.ProjectPostingExecutor"/>
    <bean id="app.erp.prj.service.posting.TimesheetPostingDispatcher"
          class="app.erp.prj.service.posting.TimesheetPostingDispatcher"/>
    <bean id="app.erp.prj.service.posting.ProjectCostCollectionProvider"
          class="app.erp.prj.service.posting.ProjectCostCollectionProvider"/>

    <!-- 项目结算过账：PROJECT_SETTLEMENT(430) 派发器 + Provider（plan 2026-07-07-0305-1 Phase 3） -->
    <bean id="app.erp.prj.service.posting.ProjectSettlementPostingDispatcher"
          class="app.erp.prj.service.posting.ProjectSettlementPostingDispatcher"/>
    <bean id="app.erp.prj.service.posting.ProjectSettlementAcctDocProvider"
          class="app.erp.prj.service.posting.ProjectSettlementAcctDocProvider"/>

    <!-- 工时成本率解析器 -->
    <bean id="app.erp.prj.service.cost.CostRateResolver"
          class="app.erp.prj.service.cost.CostRateResolver"/>

    <!-- 项目预算检查器（WARNING/STRICT，按 erp-prj.budget-control-mode） -->
    <bean id="app.erp.prj.service.cost.BudgetChecker"
          class="app.erp.prj.service.cost.BudgetChecker"/>

    <!-- 项目成本归集聚合器（工时 APPROVED → 归集行 + actualCost 回写） -->
    <bean id="app.erp.prj.service.cost.ProjectCostAggregator"
          class="app.erp.prj.service.cost.ProjectCostAggregator"/>

    <!-- 费用报销归集聚合器（projects 驱动只读聚合，config-gated） -->
    <bean id="app.erp.prj.service.cost.ExpenseCostAggregator"
          class="app.erp.prj.service.cost.ExpenseCostAggregator"/>

    <!-- 项目看板聚合入口（plan 2026-07-06-1606-1）：非实体 BizModel，注入 IDaoProvider/IOrmTemplate，
          经 @BizQuery 暴露 getDashboardKpi/getProjectStatusDistribution/findCostOverrunAlert/findDelayedProjectAlert。 -->
    <bean id="app.erp.prj.service.dashboard.ErpPrjDashboardBizModel" ioc:type="@bean:id"/>

    <!-- 项目域报表渲染入口（plan 2026-07-06-1815-1）：非实体 BizModel，注入平台 IReportEngine，
          经 @BizQuery 暴露 renderHtml/download。镜像 finance ErpFinReportBizModel（域隔离 /prj/）。 -->
    <bean id="app.erp.prj.service.report.ErpPrjReportBizModel" ioc:type="@bean:id"/>

    <!-- 项目损益汇总计算引擎（plan 2026-07-07-0305-1 Phase 2）：聚合 Billing 收入 + CostCollection 四类成本 → ErpPrjProjectPnl -->
    <bean id="app.erp.prj.service.pnl.ProjectPnlCalculator"
          class="app.erp.prj.service.pnl.ProjectPnlCalculator"/>

    <!-- 项目结算单编排 Processor（plan 2026-07-07-0305-1 Phase 3）：三轴状态机 + CLOSE 转固 + 过账委托 -->
    <bean id="app.erp.prj.service.processor.ErpPrjProjectSettlementProcessor"
          class="app.erp.prj.service.processor.ErpPrjProjectSettlementProcessor"/>


    <!-- per-mutation Processor beans (plan 2026-07-25-1057-2) -->
    <bean id="app.erp.prj.service.processor.ErpPrjProjectSettlementSubmitForApprovalProcessor"
          class="app.erp.prj.service.processor.ErpPrjProjectSettlementSubmitForApprovalProcessor"/>
    <bean id="app.erp.prj.service.processor.ErpPrjProjectSettlementApproveProcessor"
          class="app.erp.prj.service.processor.ErpPrjProjectSettlementApproveProcessor"/>
    <bean id="app.erp.prj.service.processor.ErpPrjProjectSettlementRejectProcessor"
          class="app.erp.prj.service.processor.ErpPrjProjectSettlementRejectProcessor"/>
    <bean id="app.erp.prj.service.processor.ErpPrjProjectSettlementCancelProcessor"
          class="app.erp.prj.service.processor.ErpPrjProjectSettlementCancelProcessor"/>

    <!-- per-mutation D-mutation Processor beans (R6.6)：每 D-mutation 独立 Processor。
         类别 A：ProjectSettlement 2（facade slim-to-S-delegation，submit 实测 MR5 S-mutation 不拆）。 -->
    <bean id="app.erp.prj.service.processor.ErpPrjProjectSettlementCreateSettlementProcessor"
          class="app.erp.prj.service.processor.ErpPrjProjectSettlementCreateSettlementProcessor"/>
    <bean id="app.erp.prj.service.processor.ErpPrjProjectSettlementReverseSettlementProcessor"
          class="app.erp.prj.service.processor.ErpPrjProjectSettlementReverseSettlementProcessor"/>
    <!-- per-mutation Processor beans (R6.6)：projects 9 个 D-mutation 拆分。
         类别 B：CostCollection 1 + Project 4 + ProjectPnl 1 + Timesheet 3。 -->
    <bean id="app.erp.prj.service.processor.ErpPrjCostCollectionRefreshExpenseCostProcessor"
          class="app.erp.prj.service.processor.ErpPrjCostCollectionRefreshExpenseCostProcessor"/>
    <bean id="app.erp.prj.service.processor.ErpPrjProjectCloseProjectProcessor"
          class="app.erp.prj.service.processor.ErpPrjProjectCloseProjectProcessor"/>
    <bean id="app.erp.prj.service.processor.ErpPrjProjectHoldProjectProcessor"
          class="app.erp.prj.service.processor.ErpPrjProjectHoldProjectProcessor"/>
    <bean id="app.erp.prj.service.processor.ErpPrjProjectRefreshActualCostProcessor"
          class="app.erp.prj.service.processor.ErpPrjProjectRefreshActualCostProcessor"/>
    <bean id="app.erp.prj.service.processor.ErpPrjProjectResumeProjectProcessor"
          class="app.erp.prj.service.processor.ErpPrjProjectResumeProjectProcessor"/>
    <bean id="app.erp.prj.service.processor.ErpPrjProjectPnlRefreshPnlProcessor"
          class="app.erp.prj.service.processor.ErpPrjProjectPnlRefreshPnlProcessor"/>
    <bean id="app.erp.prj.service.processor.ErpPrjTimesheetSubmitProcessor"
          class="app.erp.prj.service.processor.ErpPrjTimesheetSubmitProcessor"/>
    <bean id="app.erp.prj.service.processor.ErpPrjTimesheetApproveProcessor"
          class="app.erp.prj.service.processor.ErpPrjTimesheetApproveProcessor"/>
    <bean id="app.erp.prj.service.processor.ErpPrjTimesheetCancelProcessor"
          class="app.erp.prj.service.processor.ErpPrjTimesheetCancelProcessor"/>
</beans>
