<?xml version="1.0" encoding="UTF-8" ?>
<biz x:schema="/nop/schema/biz/xbiz.xdef" xmlns:x="/nop/schema/xdsl.xdef" x:extends="_ErpPrjTask.xbiz">

    <actions>
        <mutation name="startTask">
            <auth permissions="ErpPrjTask:mutation"/>
        </mutation>
        <mutation name="completeTask">
            <auth permissions="ErpPrjTask:mutation"/>
        </mutation>
        <mutation name="blockTask">
            <auth permissions="ErpPrjTask:mutation"/>
        </mutation>
        <mutation name="unblockTask">
            <auth permissions="ErpPrjTask:mutation"/>
        </mutation>
    </actions>
</biz>
