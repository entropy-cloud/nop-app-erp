<?xml version="1.0" encoding="UTF-8" ?>
<beans x:schema="/nop/schema/beans.xdef" xmlns:x="/nop/schema/xdsl.xdef"
       xmlns="http://www.springframework.org/schema/beans" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans
        http://www.springframework.org/schema/beans/spring-beans-2.5.xsd">

    <import resource="_dao.beans.xml"/>

    <import resource="_service.beans.xml"/>

    <!-- CRM 线索/商机 docStatus 状态机 + 漏斗阶段流转编排 Processor（Facade + Processor 两层，protected step 方法供下游覆盖） -->
    <bean id="app.erp.crm.service.processor.ErpCrmLeadProcessor"
          class="app.erp.crm.service.processor.ErpCrmLeadProcessor"/>

    <!-- CRM 线索查重器（companyName/contactEmail/contactPhone 命中既有非终态线索，默认仅提示不阻断） -->
    <bean id="app.erp.crm.service.support.LeadDuplicateChecker"
          class="app.erp.crm.service.support.LeadDuplicateChecker"/>

    <!-- CRM 转化闭环 Processor（LEAD→客户+商机、OPPORTUNITY→报价单，跨域经 IErpMdPartnerBiz/IErpSalQuotationBiz） -->
    <bean id="app.erp.crm.service.processor.ErpCrmConversionProcessor"
          class="app.erp.crm.service.processor.ErpCrmConversionProcessor"/>

    <!-- CRM 活动派生字段回写器（Event 状态变更即时回写 Lead.lastContactDate/nextActivityDate，推模式） -->
    <bean id="app.erp.crm.service.support.LeadActivityDerivationHelper"
          class="app.erp.crm.service.support.LeadActivityDerivationHelper"/>

    <!-- CRM 线索活动时间线聚合器（Event + Activity 合并按时间倒序返回只读聚合视图） -->
    <bean id="app.erp.crm.service.support.EventTimelineAggregator"
          class="app.erp.crm.service.support.EventTimelineAggregator"/>

    <!-- CRM 线索评分引擎（config 驱动 LOOKUP/FORMULA/BOOLEAN 准则 → 归一化 totalScore → append-only 评分记录 + auto-qualify） -->
    <bean id="app.erp.crm.service.support.LeadScoringEngine"
          class="app.erp.crm.service.support.LeadScoringEngine"/>

    <!-- CRM 销售预测聚合引擎（commit/upside/best-case/weighted 分类 + 商机级 ForecastLine 快照 + 团队→公司层级 rollup + 准确率） -->
    <bean id="app.erp.crm.service.support.ForecastAggregator"
          class="app.erp.crm.service.support.ForecastAggregator"/>

    <!-- CRM 区域分配引擎（按 priority 遍历 active 规则 + conditionType 匹配 + 回写 lead.territoryId/teamId；本期 MANUAL 降级） -->
    <bean id="app.erp.crm.service.support.TerritoryAssignmentEngine"
          class="app.erp.crm.service.support.TerritoryAssignmentEngine"/>

    <!-- CRM 配额层级聚合计算器（公司/区域/团队/个人 Σ + 显式值优先 + 定稿锁定 + 年度均分 + 区域管道对比三段聚合） -->
    <bean id="app.erp.crm.service.support.QuotaRollupCalculator"
          class="app.erp.crm.service.support.QuotaRollupCalculator"/>

    <!-- 定时销售预测重算 Job Bean（plan 2026-07-05-0306-1 Phase 1）。由 nop-job-local scheduler.yaml
          经 BeanMethodJobInvoker 反射调用 execute()。cron 经 erp-crm.forecast.recalc-cron 配置门控。 -->
    <bean id="erpCrmForecastRecalcJob"
          class="app.erp.crm.service.job.ErpCrmForecastRecalcJob"/>

    <!-- 定时活动到期提醒 Job Bean（plan 2026-07-06-0642-1 §Phase 2）。由 nop-job-local scheduler.yaml
          经 BeanMethodJobInvoker 反射调用 execute()。cron 经 erp-crm.event-reminder-cron 配置门控。 -->
    <bean id="erpCrmEventReminderJob"
          class="app.erp.crm.service.job.ErpCrmEventReminderJob"/>

    <!-- CRM 域报表渲染入口（plan 2026-07-06-1815-1）：非实体 BizModel，注入平台 IReportEngine，
          经 @BizQuery 暴露 renderHtml/download。镜像 finance ErpFinReportBizModel（域隔离 /crm/）。 -->
    <bean id="app.erp.crm.service.report.ErpCrmReportBizModel" ioc:type="@bean:id"/>

    <!-- CPQ 配置规则引擎（plan 2026-07-07-1430-2 §Phase 1）：纯函数式 evaluate(selectedFeatures, rules) -->
    <bean id="app.erp.crm.service.support.ProductConfigRuleEngine"
          class="app.erp.crm.service.support.ProductConfigRuleEngine"/>

    <!-- CPQ 价格规则引擎（plan 2026-07-07-1430-2 §Phase 2）：CUSTOMER_SPECIFIC > PROMOTIONAL > VOLUME + priority + 期间 + 数量区间 -->
    <bean id="app.erp.crm.service.support.PriceRuleEngine"
          class="app.erp.crm.service.support.PriceRuleEngine"/>

    <!-- CPQ 捆绑定价计算器（plan 2026-07-07-1430-2 §Phase 2）：subtotal → PERCENTAGE/FIXED 折扣 或 bundleAmount 覆盖 -->
    <bean id="app.erp.crm.service.support.BundlePricingCalculator"
          class="app.erp.crm.service.support.BundlePricingCalculator"/>

    <!-- 销售序列自动分配引擎（plan 2026-07-07-1430-3 §Phase 1）：纯函数式 + 四 conditionType 匹配 + default 兜底 -->
    <bean id="app.erp.crm.service.support.SequenceAssignmentEngine"
          class="app.erp.crm.service.support.SequenceAssignmentEngine"/>

    <!-- 销售序列步骤推进引擎（plan 2026-07-07-1430-3 §Phase 1）：纯函数式 + completionCondition 匹配 + autoCreateEvent -->
    <bean id="app.erp.crm.service.support.SequenceStepAdvancer"
          class="app.erp.crm.service.support.SequenceStepAdvancer"/>

    <!-- 定时序列逾期检查 Job Bean（plan 2026-07-07-1430-3 §Phase 1）。由 nop-job-local scheduler.yaml
          经 BeanMethodJobInvoker 反射调用 execute()。cron 经 erp-crm.sequence.overdue-check-cron 配置门控。 -->
    <bean id="erpCrmSequenceOverdueJob"
          class="app.erp.crm.service.job.ErpCrmSequenceOverdueJob"/>

    <!-- 漏斗聚合引擎（plan 2026-07-07-1430-3 §Phase 2）：纯函数式 + 头度量 + 阶段明细 + 丢失原因 TOP N -->
    <bean id="app.erp.crm.service.support.FunnelAggregationEngine"
          class="app.erp.crm.service.support.FunnelAggregationEngine"/>

    <!-- 定时漏斗聚合 Job Bean（plan 2026-07-07-1430-3 §Phase 2）。由 nop-job-local scheduler.yaml
          经 BeanMethodJobInvoker 反射调用 execute()。cron 经 erp-crm.funnel.aggregation-cron 配置门控。 -->
    <bean id="erpCrmFunnelAggregationJob"
          class="app.erp.crm.service.job.ErpCrmFunnelAggregationJob"/>

    <!-- per-mutation Processor beans (plan 2026-07-25-1057-2) -->
    <bean id="app.erp.crm.service.processor.ErpCrmLeadCancelProcessor"
          class="app.erp.crm.service.processor.ErpCrmLeadCancelProcessor"/>

    <!-- per-mutation D-mutation Processor beans (R6.6)：每 D-mutation 独立 Processor。
         类别 A：Conversion 2（facade delete-after-extract，类保留为 helper 持有者）+ Lead 3（facade slim-to-S-delegation）。 -->
    <bean id="app.erp.crm.service.processor.ErpCrmConversionConvertToCustomerProcessor"
          class="app.erp.crm.service.processor.ErpCrmConversionConvertToCustomerProcessor"/>
    <bean id="app.erp.crm.service.processor.ErpCrmConversionConvertToQuotationProcessor"
          class="app.erp.crm.service.processor.ErpCrmConversionConvertToQuotationProcessor"/>
    <bean id="app.erp.crm.service.processor.ErpCrmLeadQualifyProcessor"
          class="app.erp.crm.service.processor.ErpCrmLeadQualifyProcessor"/>
    <bean id="app.erp.crm.service.processor.ErpCrmLeadLoseProcessor"
          class="app.erp.crm.service.processor.ErpCrmLeadLoseProcessor"/>
    <bean id="app.erp.crm.service.processor.ErpCrmLeadMoveStageProcessor"
          class="app.erp.crm.service.processor.ErpCrmLeadMoveStageProcessor"/>

    <!-- per-mutation Cat-B D-mutation Processor beans (R6.6)：类别 B 内联 mutation 每 mutation 独立 Processor。
         自包含 body（VERBATIM 迁移 + CrudBizModel 管道方法替换为 raw dao 等价）；下游可经 Delta beans.xml 同名 bean id 覆盖。 -->
    <bean id="app.erp.crm.service.processor.ErpCrmEventCompleteProcessor"
          class="app.erp.crm.service.processor.ErpCrmEventCompleteProcessor"/>
    <bean id="app.erp.crm.service.processor.ErpCrmEventCancelProcessor"
          class="app.erp.crm.service.processor.ErpCrmEventCancelProcessor"/>

    <!-- CRM ErpCrmEvent 实体级 status 状态机 Bean（plan 2026-08-12-2142-2 M2.2，契约 entity-state-machine-bean.md）：
         一 Bean 对一实体一轴（PLANNED/COMPLETED/CANCELLED），严格无状态；可经 Delta 同名 bean id 覆盖替换基线矩阵。 -->
    <bean id="app.erp.crm.service.statemachine.ErpCrmEventStateMachine"
          class="app.erp.crm.service.statemachine.ErpCrmEventStateMachine"/>

    <!-- CRM ErpCrmLead 实体级 docStatus 状态机 Bean（plan 2026-08-13-0945-3 M3.1，契约 entity-state-machine-bean.md）：
         一 Bean 对一实体一轴（NEW/QUALIFIED/CONVERTED/LOST/CANCELLED），严格无状态；可经 Delta 同名 bean id 覆盖替换基线矩阵。 -->
    <bean id="app.erp.crm.service.statemachine.ErpCrmLeadStateMachine"
          class="app.erp.crm.service.statemachine.ErpCrmLeadStateMachine"/>
    <bean id="app.erp.crm.service.processor.ErpCrmForecastRefreshForecastProcessor"
          class="app.erp.crm.service.processor.ErpCrmForecastRefreshForecastProcessor"/>
    <bean id="app.erp.crm.service.processor.ErpCrmForecastPeriodClosePeriodProcessor"
          class="app.erp.crm.service.processor.ErpCrmForecastPeriodClosePeriodProcessor"/>
    <bean id="app.erp.crm.service.processor.ErpCrmLeadFunnelRefreshFunnelProcessor"
          class="app.erp.crm.service.processor.ErpCrmLeadFunnelRefreshFunnelProcessor"/>
    <bean id="app.erp.crm.service.processor.ErpCrmLeadScoreRecalculateScoreProcessor"
          class="app.erp.crm.service.processor.ErpCrmLeadScoreRecalculateScoreProcessor"/>
    <bean id="app.erp.crm.service.processor.ErpCrmLeadSequenceProgressAssignSequenceProcessor"
          class="app.erp.crm.service.processor.ErpCrmLeadSequenceProgressAssignSequenceProcessor"/>
    <bean id="app.erp.crm.service.processor.ErpCrmLeadSequenceProgressAdvanceStepProcessor"
          class="app.erp.crm.service.processor.ErpCrmLeadSequenceProgressAdvanceStepProcessor"/>
    <bean id="app.erp.crm.service.processor.ErpCrmLeadSequenceProgressSwitchSequenceProcessor"
          class="app.erp.crm.service.processor.ErpCrmLeadSequenceProgressSwitchSequenceProcessor"/>
    <bean id="app.erp.crm.service.processor.ErpCrmProductConfiguratorGenerateQuoteProcessor"
          class="app.erp.crm.service.processor.ErpCrmProductConfiguratorGenerateQuoteProcessor"/>
    <bean id="app.erp.crm.service.processor.ErpCrmQuotaDistributeAnnualQuotaProcessor"
          class="app.erp.crm.service.processor.ErpCrmQuotaDistributeAnnualQuotaProcessor"/>
    <bean id="app.erp.crm.service.processor.ErpCrmTerritoryCreateChildProcessor"
          class="app.erp.crm.service.processor.ErpCrmTerritoryCreateChildProcessor"/>
    <bean id="app.erp.crm.service.processor.ErpCrmTerritoryMoveTerritoryProcessor"
          class="app.erp.crm.service.processor.ErpCrmTerritoryMoveTerritoryProcessor"/>
</beans>