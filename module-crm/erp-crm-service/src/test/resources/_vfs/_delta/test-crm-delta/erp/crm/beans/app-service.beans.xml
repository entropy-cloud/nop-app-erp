<?xml version="1.0" encoding="UTF-8" ?>
<!-- M2.2 Delta same-name Bean override proof (plan 2026-08-12-2142-2 Phase 3):
     Delta layer file. When nop.core.vfs.delta-layer-Ids=test-crm-delta is active, this file is merged
     over the baseline app-service.beans.xml. The same bean id overrides the baseline
     ErpCrmEventStateMachine with derived ErpCrmEventStateMachineDelta (relaxes cancel source:
     PLANNED-only to PLANNED+COMPLETED, a "soft void after completion" customer rule).
     All other baseline beans (Processors, helpers, jobs, etc.) are preserved by XDsl merge. -->
<beans x:schema="/nop/schema/beans.xdef" xmlns:x="/nop/schema/xdsl.xdef"
       xmlns="http://www.springframework.org/schema/beans">

    <bean id="app.erp.crm.service.statemachine.ErpCrmEventStateMachine"
          class="app.erp.crm.service.statemachine.ErpCrmEventStateMachineDelta"/>
</beans>
