<?xml version="1.0" encoding="UTF-8" ?>
<view x:schema="/nop/schema/xui/xview.xdef" bizObjName="ErpAstAssetActionLog" xmlns:i18n-en="i18n-en"
      xmlns:x="/nop/schema/xdsl.xdef" xmlns:j="j" xmlns:c="c" xmlns:gql="gql" xmlns:view-gen="view-gen" xmlns:xpl="xpl">

    <objMeta>/erp/ast/model/ErpAstAssetActionLog/ErpAstAssetActionLog.xmeta</objMeta>

    <controlLib>/nop/web/xlib/flux-control.xlib</controlLib>

    <x:gen-extends>
        <view-gen:DefaultViewGenExtends xpl:lib="/nop/web/xlib/view-gen.xlib"/>
    </x:gen-extends>

    <x:post-extends>
        <view-gen:DefaultViewPostExtends xpl:lib="/nop/web/xlib/view-gen.xlib"/>
    </x:post-extends>

    <grids>
        <grid id="list" x:abstract="true">
            <cols>

                <!--ID-->
                <col id="id" mandatory="true" sortable="true"/>

                <!--资产-->
                <col id="assetId" mandatory="true" sortable="true"/>

                <!--事件类型-->
                <col id="eventType" mandatory="true" sortable="true"/>

                <!--变更前资产状态-->
                <col id="fromStatus" sortable="true"/>

                <!--变更后资产状态-->
                <col id="toStatus" sortable="true"/>

                <!--变更前部门-->
                <col id="fromDepartmentId" sortable="true"/>

                <!--变更后部门-->
                <col id="toDepartmentId" sortable="true"/>

                <!--变更前地点-->
                <col id="fromLocationId" sortable="true"/>

                <!--变更后地点-->
                <col id="toLocationId" sortable="true"/>

                <!--变更前使用人-->
                <col id="fromStaffId" sortable="true"/>

                <!--变更后使用人-->
                <col id="toStaffId" sortable="true"/>

                <!--关联单据实体-->
                <col id="refEntityName" sortable="true"/>

                <!--关联单据ID-->
                <col id="refEntityId" sortable="true"/>

                <!--摘要-->
                <col id="summary" sortable="true"/>

                <!--逻辑删除版本-->
                <col id="delVersion" mandatory="true" ui:number="true" sortable="true"/>

                <!--创建人-->
                <col id="createdBy" mandatory="true" sortable="true"/>

                <!--创建时间-->
                <col id="createTime" mandatory="true" sortable="true"/>

                <!--修改人-->
                <col id="updatedBy" mandatory="true" sortable="true"/>

                <!--修改时间-->
                <col id="updateTime" mandatory="true" sortable="true"/>
            </cols>
        </grid>
        <grid id="pick-list" x:prototype="list" x:abstract="true"/>
    </grids>

    <forms>
        <form id="view" editMode="view" title="查看-资产操作审计" i18n-en:title="View Asset Action Log">
            <layout>
 assetId[资产] eventType[事件类型]
 fromStatus[变更前资产状态] toStatus[变更后资产状态]
 fromDepartmentId[变更前部门] toDepartmentId[变更后部门]
 fromLocationId[变更前地点] toLocationId[变更后地点]
 fromStaffId[变更前使用人] toStaffId[变更后使用人]
 refEntityName[关联单据实体] refEntityId[关联单据ID]
 summary[摘要] delVersion[逻辑删除版本]
 createdBy[创建人] createTime[创建时间]
 updatedBy[修改人] updateTime[修改时间]
</layout>
        </form>
        <form id="add" editMode="add" title="新增-资产操作审计" i18n-en:title="Add Asset Action Log" x:prototype="edit"/>
        <form id="edit" editMode="edit" title="编辑-资产操作审计" i18n-en:title="Edit Asset Action Log">
            <layout>
 assetId[资产] eventType[事件类型]
 fromStatus[变更前资产状态] toStatus[变更后资产状态]
 fromDepartmentId[变更前部门] toDepartmentId[变更后部门]
 fromLocationId[变更前地点] toLocationId[变更后地点]
 fromStaffId[变更前使用人] toStaffId[变更后使用人]
 refEntityName[关联单据实体] refEntityId[关联单据ID]
 summary[摘要] 
</layout>
        </form>
        <form id="query" editMode="query" title="查询条件" i18n-en:title="Query Condition" x:abstract="true"/>
        <form id="asideFilter" editMode="query" x:abstract="true" submitOnChange="true"/>
        <form id="batchUpdate" editMode="edit" x:abstract="true" title="修改-资产操作审计"
              i18n-en:title="Update Asset Action Log"/>
    </forms>

    <pages>
        <crud name="view-list" grid="list" asideFilterForm="asideFilter" filterForm="query" x:abstract="true">
            <table autoFillHeight="true">
                <api url="@query:ErpAstAssetActionLog__findPage" gql:selection="{@pageSelection}"/>
            </table>
        </crud>
        <crud name="main" grid="list" asideFilterForm="asideFilter" filterForm="query" x:abstract="true">
            <table autoFillHeight="true">
                <api url="@query:ErpAstAssetActionLog__findPage" gql:selection="{@pageSelection}"/>
            </table>
            <listActions>
                <action id="batch-delete-button" label="@i18n:common.batchDelete" batch="true">
                    <api url="@mutation:ErpAstAssetActionLog__batchDelete?ids=${ids}"/>
                    <confirmText>@i18n:common.confirmBatchDelete</confirmText>
                </action>
                <action id="add-button" level="primary" label="@i18n:common.add" icon="fa fa-plus pull-left">
                    <dialog page="add"/>
                </action>
            </listActions>
            <rowActions>
                <action id="row-view-button" level="primary" label="@i18n:common.view">
                    <dialog page="view"/>
                </action>
                <action id="row-update-button" level="primary" label="@i18n:common.edit" x:abstract="true">
                    <dialog page="update"/>
                </action>
                <action id="row-delete-button" level="danger" label="@i18n:common.delete" x:abstract="true">
                    <api url="@mutation:ErpAstAssetActionLog__delete?id=${id}"/>
                    <confirmText>@i18n:common.confirmDelete</confirmText>
                </action>
                <actionGroup id="row-more-button" label="@i18n:common.more" level="primary">
                    <action id="row-update-button" label="@i18n:common.edit">
                        <dialog page="update"/>
                    </action>
                    <action id="row-delete-button" label="@i18n:common.delete">
                        <api url="@mutation:ErpAstAssetActionLog__delete?id=${id}"/>
                        <confirmText>@i18n:common.confirmDelete</confirmText>
                    </action>
                </actionGroup>
            </rowActions>
        </crud>
        <picker name="picker" grid="pick-list" asideFilterForm="asideFilter" filterForm="query" x:abstract="true">
            <table noOperations="true">
                <api url="@query:ErpAstAssetActionLog__findPage" gql:selection="{@pageSelection}"/>
            </table>
        </picker>
        <simple name="add" form="add">
            <api url="@mutation:ErpAstAssetActionLog__save/id"/>
        </simple>
        <simple name="view" form="view">
            <initApi url="@query:ErpAstAssetActionLog__get?id=${id}" gql:selection="{@formSelection}"/>
        </simple>
        <simple name="update" form="edit">
            <initApi url="@query:ErpAstAssetActionLog__get?id=${id}" gql:selection="{@formSelection}"/>
            <api url="@mutation:ErpAstAssetActionLog__update/id?id=${id}" withFormData="true"/>
        </simple>
    </pages>
</view>