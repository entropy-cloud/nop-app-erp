<?xml version="1.0" encoding="UTF-8" ?>
<biz x:schema="/nop/schema/biz/xbiz.xdef" xmlns:x="/nop/schema/xdsl.xdef" x:extends="_ErpAstMovement.xbiz">

    <actions>
        <mutation name="submitForApproval">
            <arg name="id" type="String" mandatory="true"/>
            <arg name="svcCtx" kind="ServiceContext"/>
            <return>
                <schema bizObjName="THIS_OBJ"/>
            </return>
            <source><![CDATA[
                const approvalSM = inject('app.erp.ast.service.statemachine.ErpAstMovementApprovalStateMachine');
                const documentSM = inject('app.erp.ast.service.statemachine.ErpAstMovementDocumentStateMachine');
                const entity = thisObj.invoke("requireEntity", {id}, null, svcCtx);
                if (documentSM.isCancelled(entity.docStatus)) {
                    throw new NopScriptError("nop.err.wf.approve.doc-cancelled")
                        .param("bizObjName", thisObj.bizObjName)
                        .param("bizObjId", entity.id)
                        .param("action", "submitForApproval");
                }
                approvalSM.assertCanSubmitForApproval(entity.approveStatus);

                entity.approveStatus = approvalSM.submitForApprovalTargetStatus();
                return entity;
            ]]></source>
        </mutation>
        <mutation name="approve">
            <auth permissions="ErpAstMovement:approve"/>
            <arg name="id" type="String" mandatory="true"/>
            <arg name="svcCtx" kind="ServiceContext"/>
            <return>
                <schema bizObjName="THIS_OBJ"/>
            </return>
            <source><![CDATA[
                const approvalSM = inject('app.erp.ast.service.statemachine.ErpAstMovementApprovalStateMachine');
                const documentSM = inject('app.erp.ast.service.statemachine.ErpAstMovementDocumentStateMachine');
                const entity = thisObj.invoke("requireEntity", {id}, null, svcCtx);
                if (documentSM.isCancelled(entity.docStatus)) {
                    throw new NopScriptError("nop.err.wf.approve.doc-cancelled")
                        .param("bizObjName", thisObj.bizObjName)
                        .param("bizObjId", entity.id)
                        .param("action", "approve");
                }
                approvalSM.assertCanApprove(entity.approveStatus);

                entity.approveStatus = approvalSM.approveTargetStatus();
                entity.approvedBy = svcCtx.getUserId();
                entity.approvedAt = now();
                return entity;
            ]]></source>
        </mutation>
        <mutation name="reject">
            <arg name="id" type="String" mandatory="true"/>
            <arg name="svcCtx" kind="ServiceContext"/>
            <return>
                <schema bizObjName="THIS_OBJ"/>
            </return>
            <source><![CDATA[
                const approvalSM = inject('app.erp.ast.service.statemachine.ErpAstMovementApprovalStateMachine');
                const documentSM = inject('app.erp.ast.service.statemachine.ErpAstMovementDocumentStateMachine');
                const entity = thisObj.invoke("requireEntity", {id}, null, svcCtx);
                if (documentSM.isCancelled(entity.docStatus)) {
                    throw new NopScriptError("nop.err.wf.approve.doc-cancelled")
                        .param("bizObjName", thisObj.bizObjName)
                        .param("bizObjId", entity.id)
                        .param("action", "reject");
                }
                approvalSM.assertCanReject(entity.approveStatus);

                entity.approveStatus = approvalSM.rejectTargetStatus();
                entity.approvedBy = svcCtx.getUserId();
                entity.approvedAt = now();
                return entity;
            ]]></source>
        </mutation>
        <mutation name="reverseApprove">
            <auth permissions="ErpAstMovement:reverseApprove"/>
            <arg name="id" type="String" mandatory="true"/>
            <arg name="svcCtx" kind="ServiceContext"/>
            <return>
                <schema bizObjName="THIS_OBJ"/>
            </return>
            <source><![CDATA[
                const approvalSM = inject('app.erp.ast.service.statemachine.ErpAstMovementApprovalStateMachine');
                const documentSM = inject('app.erp.ast.service.statemachine.ErpAstMovementDocumentStateMachine');
                const entity = thisObj.invoke("requireEntity", {id}, null, svcCtx);
                if (documentSM.isCancelled(entity.docStatus)) {
                    throw new NopScriptError("nop.err.wf.approve.doc-cancelled")
                        .param("bizObjName", thisObj.bizObjName)
                        .param("bizObjId", entity.id)
                        .param("action", "reverseApprove");
                }
                approvalSM.assertCanReverseApprove(entity.approveStatus);

                entity.approveStatus = approvalSM.reverseApproveTargetStatus();
                entity.approvedBy = null;
                entity.approvedAt = null;
                return entity;
            ]]></source>
        </mutation>
        <mutation name="withdrawApproval">
            <arg name="id" type="String" mandatory="true"/>
            <arg name="svcCtx" kind="ServiceContext"/>
            <return>
                <schema bizObjName="THIS_OBJ"/>
            </return>
            <source><![CDATA[
                const approvalSM = inject('app.erp.ast.service.statemachine.ErpAstMovementApprovalStateMachine');
                const documentSM = inject('app.erp.ast.service.statemachine.ErpAstMovementDocumentStateMachine');
                const entity = thisObj.invoke("requireEntity", {id}, null, svcCtx);
                if (documentSM.isCancelled(entity.docStatus)) {
                    throw new NopScriptError("nop.err.wf.approve.doc-cancelled")
                        .param("bizObjName", thisObj.bizObjName)
                        .param("bizObjId", entity.id)
                        .param("action", "withdrawApproval");
                }
                approvalSM.assertCanWithdrawApproval(entity.approveStatus);

                entity.approveStatus = approvalSM.withdrawApprovalTargetStatus();
                return entity;
            ]]></source>
        </mutation>
    </actions>
</biz>
